#!/bin/sh
# 🔴 2026-08-19 — `pnpm typecheck` et `pnpm test` RETIRÉS de ce hook (décision Will,
# audit Qualiopi E2E constat `P3-02`). Mesuré : le hook coûtait **41 minutes** par
# push (817 fichiers, 23 428 tests) — et il prouvait MOINS que la CI.
#
# Pourquoi c'est sûr :
#   · `main` est protégée par 4 gates obligatoires. Gate A rejoue `typecheck` ET
#     la suite complète **sur le commit de fusion** — l'état qui ira réellement en
#     production. Ce hook, lui, testait un état pré-fusion qui n'y va jamais.
#   · `typecheck` reste dans `pre-commit` : un seul passage local suffit, et une
#     erreur de type est précisément ce qui se découvre le mieux tôt.
#
# Pourquoi c'était NUISIBLE, et pas seulement lent : le 2026-08-19, deux pushes
# consécutifs sur le même arbre ont rendu 2 échecs puis 0, sur un fichier que la
# branche ne touchait pas (`calendly/client-event`, vert en isolation, limiteur de
# débit entièrement mocké donc sans dépendance Redis). **La suite n'est pas
# reproductible.** Un développeur qui paie 41 minutes pour un verdict qui peut être
# faux apprend `--no-verify` — et désarme d'un coup les sept contrôles statiques que
# `pre-commit` rejoue. Une garde qu'on contourne ne garde plus rien.
#
# Ce qui remplace : les tests LIÉS aux fichiers modifiés. Quelques secondes, et ça
# attrape la régression locale évidente. Le filet exhaustif reste en CI, bloquant.
pnpm i18n:check
pnpm zod:check

# ⚠️ `origin/main` peut manquer sur un clone frais ou un dépôt hors ligne : on ne
# bloque pas le push pour ça, on le DIT. Un hook qui échoue faute de référence
# apprendrait `--no-verify` aussi sûrement qu'un hook trop lent.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  FICHIERS_MODIFIES=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.ts' '*.tsx' | tr '\n' ' ')
  NB_MODIFIES=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.ts' '*.tsx' | wc -l | tr -d ' ')
  # 2026-08-30 — la branche de repositionnement (2 300 fichiers .ts/.tsx) a fait
  # depasser la limite d'arguments du systeme : « Argument list too long », hook en
  # code 1, push refuse. Un hook qui echoue POUR UNE RAISON QUI N'EST PAS UN DEFAUT
  # DU CODE apprend `--no-verify` — c'est la crainte ecrite en tete de ce fichier,
  # realisee. Et au-dela de ce seuil, `vitest related` ne cible plus rien : il
  # rejoue la suite entiere, soit les 41 minutes qu'on a precisement retirees.
  # On le DIT, on laisse passer ; Gate A reste bloquante sur le commit de fusion.
  if [ "${NB_MODIFIES}" -eq 0 ]; then
    echo "→ aucun .ts/.tsx modifié depuis origin/main : pas de test à jouer"
  elif [ "${NB_MODIFIES}" -gt 200 ]; then
    echo "⚠️ ${NB_MODIFIES} fichiers .ts/.tsx modifiés depuis origin/main — au-delà du"
    echo "   seuil de 200, « vitest related » dépasse la limite d'arguments du système"
    echo "   et ne cible plus rien d'utile (c'est la suite entière). Tests liés NON"
    echo "   joués ici. Le filet exhaustif reste en CI, Gate A, bloquante."
  else
    echo "→ tests liés aux fichiers modifiés (le filet complet est en CI, Gate A)"
    pnpm exec vitest related --run ${FICHIERS_MODIFIES} || exit 1
  fi
else
  echo "⚠️ origin/main introuvable — tests liés non joués. Gate A reste bloquante en CI."
fi

# Audit A1 P2-6 (2026-05-15) — pnpm audit avant push : attrape les
# new high/critical CVE introduites localement avant que la nightly
# (cron 03:00 UTC) ne les signale jusqu'à 24h plus tard. --audit-level
# high pour rester silencieux sur les moderate/low (déjà couverts par
# dependabot weekly).
#
# 🔴 Audit certification 2026-07-26 (F16) — le `||` d'origine traitait TOUT code de
# sortie non nul comme une faille détectée. Or `pnpm audit` sort aussi en 1 quand il
# ÉCHOUE À S'EXÉCUTER : le registre npm renvoie parfois une réponse que pnpm ne sait
# pas parser (« Unexpected token, ... is not valid JSON »). Constaté trois fois le
# 2026-07-26, bloquant tous les push du dépôt avec le message « CVE high/critical
# détectée » — un diagnostic FAUX, qui envoie chercher une vulnérabilité inexistante
# et pousse à contourner par --no-verify, donc à désarmer la garde le jour où elle
# servirait vraiment.
#
# On distingue désormais les deux cas :
#   - avis réellement présents  → push BLOQUÉ (le garde-fou fait son travail) ;
#   - audit injoignable/illisible → une seconde tentative, puis AVERTISSEMENT sans
#     blocage, en disant clairement que l'audit n'a pas pu s'exécuter.
# `|| true` INDISPENSABLE : en sh, `var=$(cmd)` prend le code de sortie de cmd.
# Sans lui, l'echec de pnpm audit fait sortir le hook en 1 AVANT meme d'afficher
# quoi que ce soit — exactement ce que ce correctif cherche a eviter.
audit_json=$(pnpm audit --prod --audit-level high --json 2>/dev/null || true)
if ! printf '%s' "$audit_json" | head -c 1 | grep -q '{'; then
  # Sortie non-JSON = l'audit lui-même a échoué. Une seconde chance avant d'abandonner.
  sleep 3
  audit_json=$(pnpm audit --prod --audit-level high --json 2>/dev/null || true)
fi

if printf '%s' "$audit_json" | head -c 1 | grep -q '{'; then
  if printf '%s' "$audit_json" | grep -q '"severity":"\(high\|critical\)"'; then
    echo "🚨 pnpm audit: CVE high/critical détectée — push bloqué"
    echo "   → résoudre via pnpm.overrides ou upgrade du package coupable"
    exit 1
  fi
  echo "✓ pnpm audit: aucune CVE high/critical en production"
else
  echo "⚠️  pnpm audit n'a PAS pu s'exécuter (registre injoignable ou réponse illisible)."
  echo "   Le push n'est PAS bloqué : aucune faille n'a été détectée, l'audit a échoué."
  echo "   → relancer 'pnpm audit --prod --audit-level high' quand le registre répond."
fi

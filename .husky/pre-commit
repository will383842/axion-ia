#!/bin/sh
pnpm exec lint-staged
pnpm anti-siren:check
pnpm anti-hex:check
pnpm use-client:check
# ⚠️ CORRIGÉ le 2026-09-10 — CE HOOK TOURNE BIEN EN WORKTREE.
# La ligne précédente affirmait le contraire (« husky n'y est pas installé »),
# et deux sessions s'y sont fiées. C'est faux : un worktree partage le `.git` du
# dépôt principal, donc `core.hooksPath` s'applique. Mesuré — un commit dans un
# worktree a déclenché ce hook et l'a fait tourner ~6 minutes (typecheck compris).
# Une affirmation commode sur ce qui NE tourne pas se vérifie comme le reste.
#
# Le câblage qui porte réellement reste celui de `ci.yml` ; celui-ci n'est qu'un
# raccourci de confort — mais il coûte le temps qu'il coûte, y compris ici.
pnpm radius:check
pnpm typecheck

# Audit A1 P1-3 (2026-05-15) — gitleaks local secret scan sur fichiers staged.
# Bloque le commit si un secret est détecté avant qu'il n'arrive au push CI.
# Skipped if gitleaks binary not installed (CI gate-a couvre quand même).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || {
    echo "🚨 gitleaks: secret détecté dans les fichiers staged"
    echo "   → revoir les modifs ou ajuster axionia/.gitleaks.toml allowlist"
    exit 1
  }
fi

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ CE HOOK NE COUVRE PAS GATE A. Mesuré le 2026-09-10 contre `ci.yml` :
# il joue 4 des 15 contrôles du job `gate-a` (+ typecheck, + lint sur les seuls
# fichiers staged via lint-staged).
#
# NE SONT PAS JOUÉS ICI :
#   format:check · zod:check · contrast:check · i18n:check · positionnement:check
#   admin-gardes:check · admin-nav:routes-check
#   content-gen:isolation-check · image-bank:isolation-check · qualiopi:isolation-check
#   test:coverage      ← la suite Vitest ENTIÈRE
#
# Le piège n'est pas l'absence : c'est que ce hook rend plusieurs verts d'affilée,
# ce qui RESSEMBLE à une couverture complète. Un commit vert ici ne dit rien de
# Gate A. Le 2026-09-09, trois PR ont été poussées vertes en local puis rougies
# par Gate A — deux sur une garde statique, une sur `test:coverage`.
#
# 🔑 `test:coverage` est le plus coûteux à substituer : la suite entière tombe en
# OOM sur cette machine. Le substitut correct n'est pas « les répertoires que je
# crois concernés » mais, pour un ajout de valeur d'énumération ou de constante
# partagée, dériver le périmètre du nom du type ET des tables touchées ET des
# dossiers scannés par les gardes de conformité (`documents/templates/*.spec.tsx`) :
#     git grep -l <NomDuType> -- '**/*.spec.ts' '**/*.spec.tsx'
# puis lancer exactement ces fichiers.
# ─────────────────────────────────────────────────────────────────────────────
echo "ℹ️  pre-commit : 4/15 contrôles Gate A joués — voir le commentaire en fin de .husky/pre-commit"

# ============================================================
# Axion-IA — env PRODUCTION (Coolify env vars)
# Mis à jour 2026-05-22 — COMPLET (toutes les vars depuis Sprint 22→Audit Final)
# ============================================================
# IMPORTANT : ne JAMAIS committer .env.production réel.
# Copier ce template via Coolify → Application → Environment Variables.
# Les vars marquées [REQUIS PROD] font crasher l'app si absentes.
# Les vars marquées [GÉNÉRÉ] ont une valeur fraîche générée le 2026-05-22.

# ---------- Application ----------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://axion-ia.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEFAULT_LOCALE=fr
SKIP_ENV_VALIDATION=false
BULLMQ_DISABLED=false

# ---------- Database (Postgres Coolify internal) ----------
# Coolify gère le service postgres → connection via service name interne
DATABASE_URL=postgresql://axion_ia:<POSTGRES_PASSWORD>@postgres:5432/axion_ia_prod?schema=public
DIRECT_URL=postgresql://axion_ia:<POSTGRES_PASSWORD>@postgres:5432/axion_ia_prod?schema=public

# ---------- Redis (BullMQ + rate limit) ----------
REDIS_URL=redis://default:<REDIS_PASSWORD>@redis:6379

# ---------- Auth.js v5 [REQUIS PROD] ----------
# Génère : openssl rand -base64 32
AUTH_SECRET=<production-secret-min-32-chars-NEVER-dev_*>
AUTH_URL=https://axion-ia.com

# ---------- Admin [REQUIS PROD] ----------
# URL secrète anti-brute-force. Min 16 chars, pas de "admin-dev" dans le nom.
ADMIN_URL_PREFIX=<random-16+-chars-eg-xK7m2Pq9nR4tWs8v>
ADMIN_EMAIL=admin@axion-ia.com

# ---------- PII Encryption at-rest [REQUIS PROD] — ADR 0025 ----------
# AES-256-GCM. EXACTEMENT 64 hex chars (32 bytes). NE PAS CHANGER après prod.
# [GÉNÉRÉ 2026-05-22] : À copier dans Coolify maintenant.
PII_ENCRYPTION_KEY=dbde7286c8191d4deb823dffdcd17239cd1f0b04e8056bce53ab238775c35b69

# ---------- IP Hash Salt [REQUIS PROD] — RGPD Art. 25, Image Bank ----------
# Min 32 chars random. Permet l'anonymisation irréversible des IPs.
# [GÉNÉRÉ 2026-05-22] : À copier dans Coolify maintenant.
IP_HASH_SALT=D/1WuRpNRULc3MQ4zI0tv2SsBELbmwPI8t3g46LAjBQ=

# ---------- Backup Encryption [REQUIS PROD] — P0-OPS-2 ----------
# AES-256. Min 32 chars. Protège les sauvegardes Postgres sur Hetzner Storage.
# [GÉNÉRÉ 2026-05-22] : À copier dans Coolify maintenant.
BACKUP_ENCRYPTION_PASSPHRASE=70wlkzMLTPvs7IsqUVNzHufezl+yEgEYCDy2wBJjV32ym9roZskCAOL21j84ghYq

# ---------- Email — PowerMTA + MailWizz self-hosted ----------
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_FROM_ADDRESS=noreply@axion-ia.com
SMTP_FROM_NAME=Axion-IA
SMTP_FROM_MARKETING=news@axion-ia.com
PMTA_API_URL=http://localhost:8080
PMTA_API_KEY=<powermta-api-key>
MAILWIZZ_API_URL=https://mailwizz.axion-ia.com/api
MAILWIZZ_API_KEY=<mailwizz-api-key>

# ---------- Telegram (notifications admin) ----------
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_CHAT_ID=<chat-id>

# ---------- Cloudflare Turnstile (PROD keys) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key-prod>
TURNSTILE_SECRET_KEY=<secret-key-prod>

# ---------- Hetzner Storage Box (backups + uploads images) ----------
HETZNER_STORAGE_ENDPOINT=u<id>.your-storagebox.de
HETZNER_STORAGE_BUCKET=axion-ia-prod
HETZNER_STORAGE_KEY=<storage-access-key>
HETZNER_STORAGE_SECRET=<storage-secret-key>
HETZNER_STORAGE_USER=u<id>
HETZNER_STORAGE_HOST=u<id>.your-storagebox.de

# ---------- Sentry error tracking ----------
SENTRY_DSN=https://<key>@sentry.axion-ia.com/<project>
NEXT_PUBLIC_SENTRY_DSN=https://<key>@sentry.axion-ia.com/<project>
# SENTRY_AUTH_TOKEN va dans GitHub Secrets (build-time sourcemap upload, pas runtime)

# ---------- Plausible Analytics self-hosted ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=axion-ia.com
NEXT_PUBLIC_PLAUSIBLE_API_URL=https://plausible.axion-ia.com
PLAUSIBLE_SHARED_LINK=https://plausible.axion-ia.com/share/axion-ia.com?auth=<token>

# ---------- Microsoft Clarity (heatmaps, optionnel) ----------
# NEXT_PUBLIC_CLARITY_PROJECT_ID=<clarity-project-id>

# ---------- IndexNow ----------
INDEXNOW_KEY=<32-chars-random-alphanum>

# ---------- Google / SEO ----------
GOOGLE_PSI_API_KEY=<google-psi-api-key>
# GOOGLE_SITE_VERIFICATION=<fallback-si-pas-DNS>
# BING_SITE_VERIFICATION=<fallback-si-pas-OAuth>

# ---------- Société ----------
COMPANY_NAME=Axion-IA
COMPANY_REGISTRATION_NUMBER=<siren-ou-siret>
COMPANY_VAT_NUMBER=<numero-tva>
COMPANY_ADDRESS=<adresse-officielle>
COMPANY_EMAIL=contact@axion-ia.com
COMPANY_DPO_EMAIL=contact@axion-ia.com
COMPANY_PHONE=<numero>

# ---------- RGPD retention purge (daily 03:00 UTC) ----------
RETENTION_LOGS_MONTHS=12
RETENTION_SUBS_ARCHIVE_MONTHS=24
RETENTION_NEWSLETTER_UNSUB_MONTHS=36
RETENTION_GENERATION_LOGS_MONTHS=12
RETENTION_COST_LEDGER_MONTHS=24
RETENTION_WEB_VITALS_MONTHS=6
RETENTION_IMAGE_LOGS_MONTHS=12
# Tunnels d'acquisition — plafond CNIL mesure d'audience : 13 mois.
RETENTION_FUNNEL_EVENTS_MONTHS=12
# Candidatures — recommandation CNIL pour un candidat non retenu : 2 ans.
# La purge supprime aussi le CV et la photo sur le volume disque.
RETENTION_CANDIDATURES_MONTHS=24

# ---------- Stripe Checkout V1 [REQUIS PROD] — ADR 0013 ----------
# STRIPE_LIVE_MODE=true exige sk_live_* + pk_live_* (refuse test keys).
STRIPE_SECRET_KEY=<sk_live_xxx>
STRIPE_PUBLISHABLE_KEY=<pk_live_xxx>
STRIPE_WEBHOOK_SECRET=<whsec_xxx>
STRIPE_API_VERSION=2026-04-22.dahlia
STRIPE_LIVE_MODE=true

# ---------- DocuSeal self-hosted (optionnel) — ADR 0014 ----------
# Si absent → fallback mode hybride manuel (admin upload PDF signé).
DOCUSEAL_BASE_URL=https://docuseal.axion-ia.com
DOCUSEAL_API_KEY=<docuseal-api-token>
DOCUSEAL_WEBHOOK_SECRET=<docuseal-hmac-secret>
DOCUSEAL_QUOTE_TEMPLATE_ID=<template-id-devis>
DOCUSEAL_CONTRACT_TEMPLATE_ID=<template-id-contrat>

# ---------- AI Content Generation (optionnel, features désactivées si absent) ----------
# DPA requis pour chaque provider avant usage prod (deadline AI Act 2026-08-02).
OPENAI_API_KEY=<sk-proj-xxx>
ANTHROPIC_API_KEY=<sk-ant-xxx>
PERPLEXITY_API_KEY=<pplx-xxx>
VOYAGE_API_KEY=<pa-xxx>
UNSPLASH_ACCESS_KEY=<unsplash-access-key>

# Embeddings OpenAI (optionnel, active via OPENAI_EMBEDDINGS_ENABLED=true)
OPENAI_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDINGS_MAX_TOKENS_PER_DAY=1000000

# ---------- KB Webhook ----------
# [GÉNÉRÉ 2026-05-22]
KB_INGEST_SECRET=UZAddFwk1pAKtZvp5ClszM+3ev5vDfSFnUpmyyQAjL8=
KB_AUTO_PUBLISH=false

# ---------- Backups & DR (ADR 0032) ----------
# [REQUIS PROD] HMAC du POST /api/internal/backups[/drills] (scripts cron VPS + drill CI).
# Générer : openssl rand -base64 48. À set aussi en GitHub Actions secret (drill CI).
BACKUP_INGEST_SECRET=
# Clé PUBLIQUE age (chiffrement des archives secrets). Privée = HORS système (coffre).
AGE_RECIPIENT=
# Optionnel — token GitHub (actions:write) pour le bouton admin "lancer un drill maintenant".
# Absent → le bouton renvoie un message "non configuré" (aucun crash).
GH_DISPATCH_TOKEN=
# Optionnel — token GitHub en LECTURE SEULE (portée « actions: read ») pour l'outil MCP
# `axionia.deploiement.etat` : il lit le dernier run du workflow de déploiement et le
# compare au commit servi (BUILD_SHA). Le dépôt étant privé, l'API rend 404 sans token.
# Absent → l'outil rend l'état « non-configure » et ne tente AUCUN appel (jamais un faux
# « tout va bien »). À défaut, GH_DISPATCH_TOKEN sert de repli — mais il est plus large
# que nécessaire : préférer un token dédié en lecture. Cf. ADR 0046.
GITHUB_READ_TOKEN=
# Côté cron VPS uniquement (cf. _AUDIT/CI-SECRETS-REQUIRED.md §D) :
#   BACKUP_REPORT_URL, R2_BUCKET_IMMUTABLE, HEALTHCHECK_URL_*,
#   PGBACKREST_REPO1_S3_KEY/_SECRET/_CIPHER_PASS, REMOTE_GIT_OFFSITE

# ---------- Image Bank ----------
IMAGE_AUTO_PUBLISH_SCORE=999
# 999 = jamais auto-publier. Mettre à 80 pour publier les images score >= 80.

# ---------- Locale EN (désactivé 2026-05-16 — bug next-intl v4.11) ----------
# Mettre à true quand le bug est résolu.
EN_LOCALE_ENABLED=false

# ---------- External Links Monitor ----------
EXTERNAL_LINKS_MONITOR_ENABLED=true

# ─── Banque d'images (GEO-094) ─────────────────────────────────────────────
# Racine du volume de stockage des variantes Sharp. Le pipeline d'import ECRIT ici
# et la route de telechargement LIT ici : les deux passent par getStorageBasePath().
IMAGE_BANK_STORAGE_PATH=/var/data/image-bank
# Prefixe CDN servant /image-bank/* depuis ce volume. Vide = meme origine.
# ATTENTION : /image-bank/* doit etre route vers le volume (Caddy ou CDN),
# sinon les images televersees depuis la console restent en 404.
# Le contrat complet (id de ligne = nom de dossier = segment d'URL) et le
# controle a passer apres deploiement sont dans docs/adr/0042-banque-d-images-
# comment-les-fichiers-sont-servis.md
IMAGE_BANK_CDN_URL=

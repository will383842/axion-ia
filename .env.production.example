# ============================================================
# Axion-IA — env PRODUCTION (Coolify env vars / Sprint 22 M11)
# ============================================================
# IMPORTANT : ne JAMAIS committer .env.production reel.
# Copier ce template via Coolify → Settings → Environment variables.
# Source de verite des cles : doctrine CLAUDE.md §12 + ADR 0009.

# ---------- Application ----------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://axion-ia.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEFAULT_LOCALE=fr
SKIP_ENV_VALIDATION=false

# ---------- Database (Postgres CPX32 internal) ----------
# Coolify gere le service postgres → connection via service name interne
POSTGRES_USER=axion_ia
POSTGRES_PASSWORD=<32-chars-random-secret>
POSTGRES_DB=axion_ia_prod
DATABASE_URL=postgresql://axion_ia:${POSTGRES_PASSWORD}@postgres:5432/axion_ia_prod?schema=public
DIRECT_URL=postgresql://axion_ia:${POSTGRES_PASSWORD}@postgres:5432/axion_ia_prod?schema=public

# ---------- Redis (BullMQ + rate limit) ----------
REDIS_PASSWORD=<32-chars-random-secret>
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379

# ---------- Auth.js v5 ----------
# Genere via : openssl rand -base64 32
AUTH_SECRET=<production-secret-min-32-chars-NEVER-dev_*>
AUTH_URL=https://axion-ia.com

# ---------- Admin ----------
# URL secrete pour eviter brute-force admin
ADMIN_URL_PREFIX=<random-32-chars-eg-x7k2n9-mP4qR8t>
ADMIN_EMAIL=admin@axion-ia.com

# ---------- Email — PowerMTA + MailWizz self-hosted (CLAUDE.md §11) ----------
# PowerMTA installe sur le VPS Hetzner, ecoute localhost:2525
# Resend / SendGrid / Mailgun / Brevo INTERDITS
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_FROM_ADDRESS=noreply@axion-ia.com
SMTP_FROM_NAME=Axion-IA
SMTP_FROM_MARKETING=news@axion-ia.com
PMTA_API_URL=http://localhost:8080
PMTA_API_KEY=<powermta-api-key>
MAILWIZZ_API_URL=https://mailwizz.axion-ia.com/api
MAILWIZZ_API_KEY=<mailwizz-api-key>

# ---------- Telegram (notifications admin) ----------
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_CHAT_ID=<chat-id>

# ---------- Cloudflare Turnstile (PROD keys, pas dev keys) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key-prod>
TURNSTILE_SECRET_KEY=<secret-key-prod>

# ---------- Hetzner Storage Box (backups + uploads images) ----------
# 4 vars S3-compat (uploads images via @aws-sdk client S3)
HETZNER_STORAGE_ENDPOINT=u123456.your-storagebox.de
HETZNER_STORAGE_BUCKET=axion-ia-prod
HETZNER_STORAGE_KEY=<storage-access-key>
HETZNER_STORAGE_SECRET=<storage-secret-key>
# 2 vars SSH rsync (scripts/backup-postgres.sh + restore-postgres-test.sh)
# P0-OPS-1 fix audit OWASP-RUNTIME : require_env crashait sans ces vars.
HETZNER_STORAGE_USER=u123456
HETZNER_STORAGE_HOST=u123456.your-storagebox.de
# Passphrase AES-256 chiffrement backups (≥ 32 chars random non-dictionnaire).
# P0-OPS-2 fix : sans elle, déchiffrement brute-forcable.
# Genere via : openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=<min-32-chars-random-passphrase>

# ---------- Sentry self-hosted (Sprint 23 M11) ----------
SENTRY_DSN=https://<key>@sentry.axion-ia.com/<project>
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
SENTRY_AUTH_TOKEN=<auth-token-for-sourcemaps-upload>

# ---------- Plausible Analytics self-hosted (Sprint 23 M11) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=axion-ia.com
NEXT_PUBLIC_PLAUSIBLE_API_URL=https://plausible.axion-ia.com

# ---------- IndexNow ----------
# 32+ chars alphanumeric, doit matcher le content de
# /api/indexnow/key/route.ts servi a Bing
INDEXNOW_KEY=<32-chars-random-alphanum>

# ---------- Société (à compléter quand finalise par Will) ----------
COMPANY_NAME=Axion-IA OÜ
COMPANY_REGISTRATION_NUMBER=<registrikood-EE>
COMPANY_VAT_NUMBER=EE-<vat-number>
COMPANY_ADDRESS=<adresse-officielle-Tallinn>
COMPANY_EMAIL=contact@axion-ia.com
COMPANY_DPO_EMAIL=contact@axion-ia.com
COMPANY_PHONE=+372-<phone>

# ---------- RGPD retention purge (Sprint 24 / D3) ----------
# Cron daily 03:00 UTC. Defaults appliqués si non définies (12/24/36/12 mois).
# Toute valeur < 1 mois est ignorée (anti-misconfig).
RETENTION_LOGS_MONTHS=12
RETENTION_SUBS_ARCHIVE_MONTHS=24
RETENTION_NEWSLETTER_UNSUB_MONTHS=36
RETENTION_BOOKINGS_CANCELLED_MONTHS=12

# ---------- Stripe Checkout V1 (Booking V1 — ADR 0013) ----------
# Cert plateforme 2026-05-16 — validés par env.ts superRefine prod-strict
# (fail-fast au boot si manquants en prod).
# Récupérer dans dashboard.stripe.com > Developers > API keys.
# IMPORTANT : `STRIPE_LIVE_MODE=true` exige sk_live_* + pk_live_* (refuse test).
STRIPE_SECRET_KEY=<sk_live_xxx-ou-sk_test_xxx>
STRIPE_PUBLISHABLE_KEY=<pk_live_xxx-ou-pk_test_xxx>
STRIPE_WEBHOOK_SECRET=<whsec_xxx>
STRIPE_API_VERSION=2026-04-22.dahlia
STRIPE_LIVE_MODE=true

# ---------- DocuSeal self-hosted (Booking V1 — ADR 0014) ----------
# Optionnel par design : si absent, fallback mode dégradé hybride manuel
# (admin upload PDF signé physiquement — cf. ADR 0014 §3).
DOCUSEAL_BASE_URL=https://docuseal.axion-ia.com
DOCUSEAL_API_KEY=<docuseal-api-token>
DOCUSEAL_WEBHOOK_SECRET=<docuseal-hmac-secret>
DOCUSEAL_QUOTE_TEMPLATE_ID=<template-id-devis>
DOCUSEAL_CONTRACT_TEMPLATE_ID=<template-id-contrat>

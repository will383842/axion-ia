  "_size_limit_doctrine": "Sprint S6.3 P1-6 (2026-05-15) — refactor multi-bucket aligné AGENTS.md. 75 KB gz/route (cible interne stricte), 110 KB sur /reserver (calendrier client-heavy, ADR exception). Per-route strict path-matching n'est pas supporté nativement par size-limit (les page-*.js sont sommés sur tout le glob) ; on contrôle donc le shell partagé + les pages standard via globs séparés, et Lighthouse CI gate-b reste l'autorité finale pour les seuils per-route LCP/INP/CLS.",
  "size-limit": [
    {
      "name": "Shell partagé (framework + main + webpack + polyfills) — cible ≤ 100 KB gz cumulé",
      "path": [
        ".next/static/chunks/framework-*.js",
        ".next/static/chunks/main-*.js",
        ".next/static/chunks/main-app-*.js",
        ".next/static/chunks/webpack-*.js",
        ".next/static/chunks/polyfills-*.js"
      ],
      "limit": "100 KB"
    },
    {
      "name": "Routes /reserver (exception calendrier — 110 KB gz cumulé)",
      "path": ".next/static/chunks/app/**/reserver/**/page-*.js",
      "limit": "110 KB"
    },
    {
      "name": "Routes /reserver — chunks dynamiques (Calendar SSR=false)",
      "path": ".next/static/chunks/app/**/reserver/**/*.js",
      "limit": "150 KB"
    },
    {
      "name": "Pages standard (toutes routes hors /reserver) — page chunks individuels",
      "path": [
        ".next/static/chunks/app/**/page-*.js",
        "!.next/static/chunks/app/**/reserver/**"
      ],
      "limit": "75 KB"
    },
    {
      "name": "Routes /galerie (image-bank V1) — page chunks ≤ 75 KB gz",
      "path": [
        ".next/static/chunks/app/**/galerie/**/page-*.js",
        ".next/static/chunks/app/**/gallery/**/page-*.js"
      ],
      "limit": "75 KB"
    }
  ],

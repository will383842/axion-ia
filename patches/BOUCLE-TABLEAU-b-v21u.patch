+      const tailles = plan.plans.map((p) => p.taille);
+      expect(Math.max(...tailles)).toBe(115);
+      expect(tailles).not.toContain(130);
+    }
+  });
+
+  it("(b) zoom demandé visible : plan zoomé à 115 %, plan voisin à 100 %", () => {

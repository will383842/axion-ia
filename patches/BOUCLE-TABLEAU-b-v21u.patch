+  });
+});
+
+describe("autres rôles arrêtés", () => {
+  const roleArrete = (role: string) => etatPilote({ roles: [{ role, etat: "a-revoir", le }] });
+  it.each([
+    ["chef-de-projet", /classement de votre demande/],

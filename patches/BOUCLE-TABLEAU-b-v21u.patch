+
+function zoomerRect(r: RectPx, o: { x: number; y: number }, s: number): RectPx {
+  return { x: o.x + (r.x - o.x) * s, y: o.y + (r.y - o.y) * s, largeur: r.largeur * s, hauteur: r.hauteur * s };

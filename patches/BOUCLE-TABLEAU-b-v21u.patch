+  for (let t = debut, i = 0; t + 0.3 < fin; t += 0.385, i++) mots.push({ mot: i % 7 === 3 ? "transformation" : "et", debutSec: +t.toFixed(3), finSec: +(t + 0.3).toFixed(3) });
+  return mots;
+}

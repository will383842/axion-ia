+
+function curseur(p: { trajet: { x: number; y: number }[]; clic: boolean; partDeplacement: number }, c: ContexteP): Brut[] {
+  const { largeur, hauteur } = TOILES.curseur;
+  const duree = Math.max(1, Math.round(c.dureeImages * p.partDeplacement));

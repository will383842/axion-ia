diff --git a/src/components/publication/ImporterVideo.tsx b/src/components/publication/ImporterVideo.tsx
new file mode 100644
index 00000000..1b78702d
--- /dev/null
+++ b/src/components/publication/ImporterVideo.tsx
@@ -0,0 +1,93 @@
+"use client";
+
+/** Bouton « Importer une vidéo déjà faite » + petit formulaire. Le fichier n'est envoyé qu'une fois la case cochée ; les contrôles décisifs sont côté serveur. */
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+import { importerVideoAction } from "@/app/(studio)/a-publier/actions-import";
+import { Bouton } from "@/components/ui/Bouton";
+import { envoyerFichier } from "@/lib/envoi-multipart";
+
+const RESEAUX: { id: string; nom: string }[] = [
+  { id: "instagram", nom: "Instagram" },
+  { id: "tiktok", nom: "TikTok" },
+  { id: "facebook", nom: "Facebook" },
+  { id: "linkedin", nom: "LinkedIn" },
+  { id: "youtube-shorts", nom: "YouTube Shorts" },
+  { id: "youtube", nom: "YouTube" },
+  { id: "pinterest", nom: "Pinterest" },
+];
+
+/** Durée et taille lues dans le navigateur (le serveur borne ensuite la durée annoncée). */
+function lireMetadonnees(fichier: File): Promise<{ dureeSec: number; largeur: number; hauteur: number }> {
+  return new Promise((resolve, reject) => {
+    const url = URL.createObjectURL(fichier);
+    const v = document.createElement("video");
+    v.preload = "metadata";
+    v.onloadedmetadata = () => {
+      resolve({ dureeSec: v.duration, largeur: v.videoWidth, hauteur: v.videoHeight });
+      URL.revokeObjectURL(url);
+    };
+    v.onerror = () => {
+      URL.revokeObjectURL(url);
+      reject(new Error("illisible"));
+    };
+    v.src = url;
+  });
+}
+
+export function ImporterVideo() {
+  const routeur = useRouter();
+  const [ouvert, setOuvert] = useState(false);
+  const [fichier, setFichier] = useState<File | null>(null);
+  const [titre, setTitre] = useState("");
+  const [reseaux, setReseaux] = useState<string[]>([]);
+  const [valide, setValide] = useState(false);
+  const [message, setMessage] = useState("");
+  const [enCours, setEnCours] = useState(false);
+
+  async function envoyer() {
+    if (!valide) return setMessage("Cochez « Je valide cette vidéo » pour l'ajouter. Rien n'a été ajouté.");
+    if (!fichier) return setMessage("Choisissez une vidéo (mp4, mov ou webm).");
+    setEnCours(true);
+    setMessage("");
+    try {
+      const meta = await lireMetadonnees(fichier).catch(() => ({ dureeSec: 0, largeur: 0, hauteur: 0 }));
+      const entiteId = `imp-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;
+      const { fichierId } = await envoyerFichier(fichier, { typeEntite: "video", entiteId });
+      const r = await importerVideoAction({ fichierId, entiteId, titre, reseaux, valide, ...meta });
+      if (!r.ok) return setMessage(r.message);
+      setOuvert(false);
+      setFichier(null);
+      setTitre("");
+      setReseaux([]);
+      setValide(false);
+      routeur.refresh();
+    } catch {
+      setMessage("Le fichier n'a pas pu être envoyé. Vérifiez la connexion et recommencez.");
+    } finally {
+      setEnCours(false);
+    }
+  }
+
+  if (!ouvert) return <Bouton variante="secondaire" onClick={() => setOuvert(true)}>Importer une vidéo déjà faite</Bouton>;
+  return (
+    <form className="flex flex-col gap-2" onSubmit={(e) => { e.preventDefault(); void envoyer(); }}>
+      <label>Vidéo (mp4, mov, webm) <input type="file" accept=".mp4,.mov,.webm,video/mp4,video/quicktime,video/webm" onChange={(e) => setFichier(e.target.files?.[0] ?? null)} /></label>
+      <label>Titre <input type="text" value={titre} maxLength={120} onChange={(e) => setTitre(e.target.value)} /></label>
+      <fieldset>
+        <legend>Réseaux visés</legend>
+        {RESEAUX.map((r) => (
+          <label key={r.id}>
+            <input type="checkbox" checked={reseaux.includes(r.id)} onChange={(e) => setReseaux(e.target.checked ? [...reseaux, r.id] : reseaux.filter((x) => x !== r.id))} /> {r.nom}{" "}
+          </label>
+        ))}
+      </fieldset>
+      <label><input type="checkbox" checked={valide} onChange={(e) => setValide(e.target.checked)} /> Je valide cette vidéo</label>
+      {message && <p role="alert">{message}</p>}
+      <div className="flex gap-2">
+        <Bouton type="submit" variante="principal" disabled={enCours}>{enCours ? "Envoi en cours…" : "Ajouter à « À publier »"}</Bouton>
+        <Bouton type="button" variante="discret" onClick={() => setOuvert(false)}>Annuler</Bouton>
+      </div>
+    </form>
+  );
+}
diff --git a/src/domaine/import-video-externe.ts b/src/domaine/import-video-externe.ts
new file mode 100644
index 00000000..05fe280c
--- /dev/null
+++ b/src/domaine/import-video-externe.ts
@@ -0,0 +1,62 @@
+/**
+ * IMPORT D'UNE VIDÉO DÉJÀ FAITE (hors du Studio) : règles pures, sans lecture ni écriture.
+ * Bornes claires, refus en français simple. Le service `import-video-externe.ts` les applique, rien d'autre ne décide.
+ */
+import type { IdReseau } from "./types";
+
+export const FORMATS_IMPORT = [
+  { extension: "mp4", mime: "video/mp4" },
+  { extension: "mov", mime: "video/quicktime" },
+  { extension: "webm", mime: "video/webm" },
+] as const;
+
+/** Bornes : 1 Go au plus, de 3 secondes à 10 minutes. */
+export const TAILLE_MAX_IMPORT_OCTETS = 1024 * 1024 * 1024;
+export const DUREE_MIN_IMPORT_SEC = 3;
+export const DUREE_MAX_IMPORT_SEC = 600;
+export const TITRE_MAX_IMPORT = 120;
+
+const RESEAUX_VALIDES: readonly IdReseau[] = ["linkedin", "instagram", "facebook", "tiktok", "youtube", "youtube-shorts", "pinterest"];
+
+export interface DemandeImportVideo {
+  nom: string;
+  mime: string;
+  taille: number;
+  dureeSec: number;
+  titre: string;
+  reseaux: readonly string[];
+  /** La case « Je valide cette vidéo ». */
+  valide: boolean;
+}
+
+export type ControleImport = { ok: true; titre: string; reseaux: IdReseau[] } | { ok: false; code: string; message: string };
+
+const extensionDe = (nom: string) => (/\.([A-Za-z0-9]{1,8})$/.exec(nom.trim())?.[1] ?? "").toLowerCase();
+
+/** Le format est reconnu par l'extension ET par le type annoncé (un type vide est toléré, jamais un type d'un autre genre). */
+export function formatImportAccepte(nom: string, mime: string): boolean {
+  const f = FORMATS_IMPORT.find((x) => x.extension === extensionDe(nom));
+  if (!f) return false;
+  const m = (mime ?? "").trim().toLowerCase();
+  return m === "" || m === f.mime || (f.extension === "mp4" && m === "video/x-m4v");
+}
+
+function libelleDuree(sec: number): string {
+  return sec >= 60 ? `${Math.round(sec / 60)} minutes` : `${sec} secondes`;
+}
+
+export function controlerImportVideo(d: DemandeImportVideo): ControleImport {
+  const refus = (code: string, message: string): ControleImport => ({ ok: false, code, message });
+  if (d.valide !== true) return refus("NON_VALIDEE", "Cochez « Je valide cette vidéo » pour l'ajouter. Rien n'a été ajouté.");
+  if (!formatImportAccepte(d.nom, d.mime)) return refus("FORMAT", "Ce format n'est pas accepté. Choisissez une vidéo mp4, mov ou webm.");
+  if (!Number.isFinite(d.taille) || d.taille <= 0) return refus("TAILLE", "Ce fichier est vide. Choisissez une autre vidéo.");
+  if (d.taille > TAILLE_MAX_IMPORT_OCTETS) return refus("TROP_LOURD", "Cette vidéo est trop lourde (1 Go au plus). Réduisez son poids puis recommencez.");
+  if (!Number.isFinite(d.dureeSec) || d.dureeSec <= 0) return refus("DUREE_INCONNUE", "La durée de cette vidéo n'a pas pu être lue. Essayez un autre fichier.");
+  if (d.dureeSec < DUREE_MIN_IMPORT_SEC) return refus("TROP_COURTE", `Cette vidéo est trop courte (${libelleDuree(DUREE_MIN_IMPORT_SEC)} au moins).`);
+  if (d.dureeSec > DUREE_MAX_IMPORT_SEC) return refus("TROP_LONGUE", `Cette vidéo est trop longue (${libelleDuree(DUREE_MAX_IMPORT_SEC)} au plus).`);
+  const titre = (d.titre ?? "").trim().slice(0, TITRE_MAX_IMPORT);
+  if (!titre) return refus("TITRE", "Donnez un titre à cette vidéo.");
+  const reseaux = Array.from(new Set(d.reseaux)).filter((r): r is IdReseau => (RESEAUX_VALIDES as readonly string[]).includes(r));
+  if (!reseaux.length) return refus("RESEAUX", "Choisissez au moins un réseau.");
+  return { ok: true, titre, reseaux };
+}

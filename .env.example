# ============================================================
# Axion-IA — environment template (commit this file, never .env)
# Sprint 0 stub — full env wiring lands in later sprints (M8+)
# ============================================================

# ---------- Application ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=fr
SKIP_ENV_VALIDATION=false

# ---------- Database (Postgres) ----------
DATABASE_URL=
DIRECT_URL=

# ---------- Redis (cache + queue + rate limit) ----------
REDIS_URL=

# BullMQ dev toggle — `true` en local sans Redis pour eviter OOM dev server.
# Workers et queues no-op silencieusement. Toujours `false` en production.
BULLMQ_DISABLED=false

# Workers/crons herites du flux de reservation payante (option-expiration,
# option-reminder, booking-crons). OFF par defaut depuis l'audit 2026-07-09 :
# le flux est eteint (Calendly a remplace le creneau public, Stripe neutralise)
# et ces crons tournaient a vide. Poser `true` (scope RUN) pour les reactiver.
LEGACY_BOOKING_WORKERS_ENABLED=false

# ---------- Auth.js v5 (admin only) ----------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------- Admin ----------
ADMIN_URL_PREFIX=
ADMIN_EMAIL=

# ---------- Email (Nodemailer → SMTP ZeptoMail) ----------
# Resend / SendGrid / Mailgun / Brevo INTERDITS — cf. CLAUDE.md v6 §11
#
# ⚠️ Ce bloc a menti DEUX FOIS, et les deux erreurs ont coûté du temps :
#   - jusqu'au 2026-08-16 il annonçait « PowerMTA + MailWizz », jamais déployés ;
#   - le 2026-08-16 au matin il a été corrigé en `smtppro.zoho.eu:465`, sur la
#     foi de la page de configuration du panneau Zoho — alors que la valeur
#     RÉELLEMENT en service était `smtp.zoho.eu`. Leçon : lire la variable en
#     production, pas la documentation du fournisseur.
# L'état ci-dessous est celui relevé DANS Coolify le 2026-08-16 après bascule.
#
# En DÉVELOPPEMENT : laisser SMTP_USER / SMTP_PASS vides — le transport parle
# alors à un Mailhog local (localhost:2525, UI sur :8025), sans TLS ni auth.
#
# En PRODUCTION : les deux sont OBLIGATOIRES. Sans elles, `client.ts` REFUSE
# d'envoyer (il retomberait sinon sur localhost en clair, en silence).
#   SMTP_HOST=smtp.zeptomail.eu
#   SMTP_PORT=587
#   SMTP_USER=emailapikey     ← littéralement ce mot, ce n'est pas un exemple
#   SMTP_PASS=<jeton « Send Mail » de l'agent ZeptoMail au domaine vérifié>
#
# 🔴 CES VARIABLES SE POSENT SUR L'APPLICATION COOLIFY « axion-ia-worker »,
# PAS (seulement) SUR L'APP WEB. Le worker BullMQ est une SECONDE application
# Coolify, avec son propre jeu de variables, et c'est LUI qui parle en SMTP —
# le conteneur web ne fait qu'enfiler les jobs. Le 2026-08-16, la bascule a été
# faite sur l'app web, vérifiée et déclarée terminée : elle n'avait aucun effet,
# le worker envoyait toujours par Zoho. Vérifier dans les logs DU WORKER :
#   [email-worker] relais SMTP joignable et authentifié ✓
# 🔴 Et REDEPLOY, jamais Restart : l'environnement d'un conteneur est figé à sa
# création, un simple redémarrage ne relit pas les variables.
#
# Zoho Mail reste en service, mais UNIQUEMENT comme boîte aux lettres humaine
# (contact@axion-ia.com, IMAP `imappro.zoho.eu:993`). ZeptoMail est envoi-seul :
# il ne remplace pas la boîte, il s'y ajoute. Ne JAMAIS y router de campagne
# marketing de masse — service transactionnel, sous peine de suspension.
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@axion-ia.com
SMTP_FROM_NAME=AxionIA
SMTP_FROM_MARKETING=news@axion-ia.com
# Vestiges de l'architecture PowerMTA / MailWizz jamais déployée. Conservés
# parce que `env.ts` les déclare encore ; aucun code ne les lit aujourd'hui.
PMTA_API_URL=
PMTA_API_KEY=
MAILWIZZ_API_URL=
MAILWIZZ_API_KEY=

# ---------- Telegram ----------
# Bot historique — écrit dans 7 des 8 groupes thématiques.
TELEGRAM_BOT_TOKEN=
# Repli 1-groupe (avant la refonte 2026-07-09). Utilisé si aucun chat_id de
# groupe n'est posé : aucune notification ne se perd.
TELEGRAM_CHAT_ID=

# Bot DÉDIÉ au groupe 📅 Calendly (refonte 2026-08-09, ADR 0039).
# Absent = les RDV repartent sur le bot historique dans TELEGRAM_CHAT_ID_RDV.
TELEGRAM_CALENDLY_BOT_TOKEN=

# ---------- Telegram · les 8 groupes thématiques (ADR 0039) ----------
# Chacun est le chat_id d'un groupe où le bot correspondant a été ajouté.
# Tous OPTIONNELS : un groupe non configuré retombe sur son salon de repli, ce
# qui reproduit exactement le routage d'avant le 2026-08-09.
# Pour relever un chat_id : ajouter le bot au groupe, y écrire un message, puis
#   curl "https://api.telegram.org/bot<JETON>/getUpdates" | grep -o '"id":-[0-9]*'
TELEGRAM_CHAT_ID_CALENDLY=
TELEGRAM_CHAT_ID_CANDIDATURES=
TELEGRAM_CHAT_ID_PRESSE=
TELEGRAM_CHAT_ID_INVESTISSEURS=
TELEGRAM_CHAT_ID_INTERVENTIONS=
TELEGRAM_CHAT_ID_AVIS=
TELEGRAM_CHAT_ID_MESSAGES=
TELEGRAM_CHAT_ID_SYSTEM=
# Salon dédié aux anomalies de la synchro CRM (lot L5). OPTIONNEL : sans lui,
# ces alertes retombent dans TELEGRAM_CHAT_ID_SYSTEM, exactement là où elles
# seraient allées sans salon dédié. À poser sur l'application WORKER (les
# alertes de synchro partent des jobs BullMQ, pas des requêtes web).
TELEGRAM_CHAT_ID_CRM_SYNC=
# Ancien groupe RDV — conservé comme repli du groupe Calendly.
TELEGRAM_CHAT_ID_RDV=

# ---------- WhatsApp (CallMeBot) ----------
# ⚠️ À poser sur les DEUX applications Coolify (web ET worker) : depuis la
# refonte 2026-08-09 les alertes Calendly partent du worker.
WHATSAPP_CALLMEBOT_APIKEY=
WHATSAPP_NOTIFY_PHONE=

# ---------- Cloudflare Turnstile ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Hetzner Storage Box (S3-compatible, UE) ----------
# Source unique de stockage — pas d'AWS/Backblaze/Wasabi
HETZNER_STORAGE_ENDPOINT=
HETZNER_STORAGE_BUCKET=
HETZNER_STORAGE_KEY=
HETZNER_STORAGE_SECRET=

# ---------- Sentry self-hosted ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---------- Plausible self-hosted ----------
# ⚠️ NEXT_PUBLIC_* = INLINÉES AU BUILD.
# Les poser au runtime Coolify ne sert à RIEN : elles doivent être passées en
# --build-arg (cf. Dockerfile + .github/workflows/deploy-coolify.yml).
# C'est ce qui a fait que le script Plausible était absent du HTML de prod et
# qu'aucun event n'a jamais été collecté (audit 2026-07-21).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=axion-ia.com
NEXT_PUBLIC_PLAUSIBLE_API_URL=https://plausible.axion-ia.com
# URL "Shared Dashboard" générée dans Plausible UI (Site Settings > Visibility >
# Add a shared link). Permet l'embed iframe dans /fr/{prefix}/analytics.
# Format : https://plausible.axion-ia.com/share/axion-ia.com?auth=TOKEN&embed=true&theme=light
PLAUSIBLE_SHARED_LINK=

# ---------- IndexNow ----------
INDEXNOW_KEY=

# ---------- Calendly inline widget (/appel) ----------
# URL publique de l'event-type Calendly pour la prise de rendez-vous
# téléphonique en temps réel sur la page /appel.
# Setup : Calendly → Account → Event Types → "Appel découverte 30min" → Copy link
# Format : https://calendly.com/{user-slug}/{event-slug}
# Si absent, /appel affiche un fallback CTA contact (pas de page cassée).
NEXT_PUBLIC_CALENDLY_APPEL_URL=

# Personal Access Token de l'API Calendly v2 (server-only) — OPTIONNEL.
# À quoi ça sert : le widget Calendly ne transmet au navigateur QUE deux URI
# techniques (event + invitee), jamais le nom, l'email ni l'horaire. Sans ce
# token, chaque réservation arrive dans l'admin sans contact et doit être
# recopiée à la main depuis le mail Calendly. Avec le token, le serveur résout
# les URI et remplit tout automatiquement (nom, email, téléphone, début, fin,
# fuseau, liens d'annulation/report) — y compris rétroactivement, via le bouton
# « Enrichir depuis Calendly » de la fiche admin.
# Générer sur : https://calendly.com/integrations/api_webhooks
# Laisser vide = comportement d'avant, aucun appel réseau émis. Cf. ADR 0036.
#
# ⚠️ DEPUIS ADR 0038, CE TOKEN PORTE AUSSI L'AFFICHAGE DE /appel.
# C'est lui qui permet au SERVEUR d'aller chercher les créneaux libres et de les
# rendre en HTML — donc d'afficher un calendrier tout de suite, sans iframe, sans
# cookie tiers et sans écran de consentement. Sans token, /appel retombe sur le
# placeholder « Afficher le calendrier » (click-to-load, ADR 0034) : rien n'est
# cassé, mais le visiteur doit cliquer avant de voir la moindre heure.
# Il sert enfin au SONDAGE (toutes les minutes depuis le 2026-08-09) qui découvre
# les réservations prises directement sur calendly.com — sans lui, elles
# n'apparaissent ni en console ni sur Telegram/WhatsApp.
# ⚠️ À poser sur les DEUX applications Coolify : le sondage tourne sur le WORKER.
CALENDLY_API_TOKEN=

# Clé de signature du webhook Calendly (ADR 0039) — application WEB uniquement.
# Absente = /api/calendly/webhook répond 200 sans rien faire, le sondage 60 s
# reste le chemin nominal. Posée = livraison instantanée (~2 s).
# ⚠️ Exige un plan Calendly Standard (~12 €/mois) : le plan gratuit n'a pas droit
# aux abonnements webhook. Obtenue via `pnpm calendly:webhook:subscribe`, qui ne
# l'affiche QU'UNE FOIS.
CALENDLY_WEBHOOK_SIGNING_KEY=

# ============================================================
# Content Generator V1 (Sprint 1-12 + Pass B S6.1)
# Voir _AUDIT/PROMPT-CONTENT-GENERATOR-MASTER-2026.md § 24.1 +
# DPA-REGISTER.md §5-§7 pour les bases légales RGPD.
# Toutes optionnelles côté src/env.ts — workers no-op silencieux si absentes.
# ============================================================

# ---------- AI providers (cf. DPA-REGISTER.md §5-§7) ----------
# OpenAI : platform.openai.com — DPA online + ZDR si Tier 4+
OPENAI_API_KEY=
# Optionnel — pour utiliser un compte spécifique (multi-tenants)
OPENAI_ORG_ID=

# Anthropic : console.anthropic.com — Commercial DPA + opt-out training défaut
ANTHROPIC_API_KEY=

# Perplexity : perplexity.ai/hub/legal/dpa — DPA + SCC obligatoire avant prod
PERPLEXITY_API_KEY=

# ---------- Stock image (Unsplash gratuit — pas d'IA, doctrine Q4 v2.0) ----------
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ---------- Embeddings (Voyage AI — voyage-3-lite 1024 dims) ----------
VOYAGE_API_KEY=

# ---------- KB ingest webhook ----------
# 32 chars min — utilisé pour HMAC-SHA256 du body POST /api/kb/ingest.
KB_INGEST_SECRET=
# Si "true", KB factory publie automatiquement (100 entries/jour cible).
# Mettre "false" en V1 pour validation manuelle.
KB_AUTO_PUBLISH=false

# ---------- Backups & DR (ADR 0032) ----------
# HMAC-SHA256 du POST /api/internal/backups[/drills] depuis les scripts cron VPS + CI.
# 32 chars min. Cf. src/lib/backups/hmac.ts, _AUDIT/CI-SECRETS-REQUIRED.md.
BACKUP_INGEST_SECRET=
# Côté scripts cron VPS (non lu par l'app) — documentés ici pour mémoire :
#   BACKUP_REPORT_URL=http://localhost:3000   (CI: https://axion-ia.com)
#   R2_BUCKET_IMMUTABLE=axion-ia-backups-immutable   (Object Lock)
#   AGE_RECIPIENT=age1...                     (clé publique age, chiffrement secrets)
#   HEALTHCHECK_URL_POSTGRES / _REDIS / _DOCUSEAL / ... (dead-man's-switch)
#   PGBACKREST_REPO1_S3_KEY / _SECRET / _CIPHER_PASS   (PITR)
#   REMOTE_GIT_OFFSITE=git@...                 (mirror Git)

# ---------- Google Indexing API (Sprint 9 — tier-1 push immediate) ----------
# JSON service account credentials (single-line, escape \n).
# Console Google Cloud → IAM → Service Accounts → Keys → Create JSON.
# Activer Indexing API + Search Console API. Ajouter SA email comme propriétaire
# de la Search Console property axion-ia.com.
GOOGLE_INDEXING_API_ENABLED=false
GOOGLE_INDEXING_SA_JSON=

# ---------- SEO verification (GSC / Bing) ----------
# En prod 2026-05-13 : GSC vérifié par DNS TXT (Domain property),
# Bing par Import OAuth GSC → ces env vars ne sont actuellement pas
# utilisées en prod mais restent dispo en fallback meta tag.
# Récupérables sur :
#   GSC  : https://search.google.com/search-console (méthode "balise HTML")
#   Bing : https://www.bing.com/webmasters (méthode "balise meta")
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------- Société (SAS française — à compléter par Will) ----------
COMPANY_NAME=
COMPANY_REGISTRATION_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS=
COMPANY_EMAIL=contact@axion-ia.com
COMPANY_DPO_EMAIL=contact@axion-ia.com
COMPANY_PHONE=

# ============================================================
# Sprint X.0 booking-v1 — Stripe + DocuSeal + OSM
# (toutes optionnelles V1, activables progressivement)
# Voir ADRs : docs/adr/0012- à docs/adr/0020-*.md
# ============================================================

# ---------- Stripe (paiements V1 + hybride manuel) ----------
# Mode TEST par défaut, basculer en LIVE après DPA + KYB validé
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Sprint X.2 — API version figée côté code (src/lib/stripe.ts:STRIPE_API_VERSION).
# Cette env var est informative uniquement ; le code utilise la version compilée.
STRIPE_API_VERSION=2026-04-22.dahlia
# Cert plateforme 2026-05-16 — toggle mode LIVE vs TEST validé par env.ts
# superRefine : si `true` → STRIPE_SECRET_KEY + STRIPE_PUBLISHABLE_KEY doivent
# commencer par `sk_live_` / `pk_live_` (refuse test keys en LIVE).
STRIPE_LIVE_MODE=false

# ---------- DocuSeal (signature contrats V1, self-hosted Docker) ----------
DOCUSEAL_BASE_URL=https://docuseal.axion-ia.com
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
# Sprint X.7 final — template_id DocuSeal pour signature des devis (Quote).
# Récupéré depuis DocuSeal UI > Templates après upload du master devis FR.
# Si absent, sendQuoteAction fallback en mode email-only (admin signe via
# markQuoteSignedManuallyAction).
DOCUSEAL_QUOTE_TEMPLATE_ID=
# Cert plateforme 2026-05-16 — template_id DocuSeal pour signature des contrats
# (post-acceptation devis). Optional V1 ; si absent fallback admin upload PDF.
DOCUSEAL_CONTRACT_TEMPLATE_ID=

# ---------- OSM Nominatim (géocodage gratuit) ----------
# User-Agent obligatoire (politique Nominatim — max 1 req/s)
NOMINATIM_USER_AGENT=Axion-IA-Booking/1.0 (contact@axion-ia.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---------- Booking V1 — toggles modes manuels (D64) ----------
# Défauts en BDD via SiteSetting, override possible via env :
# BOOKING_PAYMENT_AUTOMATION_ENABLED=true
# BOOKING_SIGNATURE_AUTOMATION_ENABLED=true
# BOOKING_AUTO_EMAILS_ENABLED=true
# BOOKING_AUTO_INVOICE_GEN_ENABLED=true

# ---------- Booking V1 — délais expiration (jours, configurables admin) ----------
# Défauts en BDD via SiteSetting :
# BOOKING_OPTION_EXPIRATION_DAYS=5
# BOOKING_CONTRACT_SIGNED_NO_DEPOSIT_CUTOFF_DAYS=10
# BOOKING_MAX_CONCURRENT_OPTIONS_PER_SLOT=3

# ============================================================
# === SÉCURITÉ & RGPD ===
# ============================================================

# Salt pour hachage IP — RGPD art. 25. Générer: openssl rand -hex 32
IP_HASH_SALT=

# Clé chiffrement PII AES-256. Générer: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Passphrase backup chiffré (Storage Box Hetzner)
BACKUP_ENCRYPTION_PASSPHRASE=

# HMAC interne IndexNow. Générer: openssl rand -hex 32
INDEXNOW_INTERNAL_HMAC_SECRET=

# HMAC strict webhooks DocuSeal
DOCUSEAL_STRICT_HMAC=false

# ============================================================
# === CONTENT GENERATION ===
# ============================================================

# Cap publication journalier (rampe auto 30→100→200→500 si absent)
MAX_PUBLISH_PER_DAY=30

# V-09 P6 2026-05-22 — Couche 4 dedup sémantique (OpenAI text-embedding-3-large).
#  - Default OFF (no-op silent, zero cost imprévu).
#  - Quand activé : chaque article publié reçoit un embedding 1536 dim persisté
#    dans articles.embedding (pgvector). Coût ~$0.13/1M tokens (~$0.09 pour
#    backfill 1000 articles historiques via src/scripts/backfill-embeddings.ts).
#  - RGPD : pas de PII (titre + meta + body publics indexables), scope public.
#  - Activation prod : passer à `true` dans Coolify env vars, puis run backfill.
OPENAI_EMBEDDINGS_ENABLED=false

# Cap tokens OpenAI embeddings/jour (default 1M = ~$0.13/jour @ scale 1000 art).
OPENAI_EMBEDDINGS_MAX_TOKENS_PER_DAY=1000000

# ============================================================
# === FEATURE FLAGS ===
# ============================================================

# Backend unifié aide/support
HELP_BACKEND_UNIFIED=false

# Locale anglaise
EN_LOCALE_ENABLED=false

# SSG villes indexables uniquement (économie RAM build)
BUILD_SSG_VILLES_INDEXABLE_ONLY=true

# Fallback fingerprint Voyage AI
VOYAGE_AI_FINGERPRINT_FALLBACK=false

# ─────────────────────────────────────────────────────────────────────────────
# AUDIT 2026-07-21 — variables POSÉES EN PROD mais qui n'étaient documentées
# nulle part. Un opérateur repartant de ce fichier cassait toute la mesure SEO
# sans s'en apercevoir (chaque client dégrade en `return null` silencieux).
# ─────────────────────────────────────────────────────────────────────────────

# Google Search Console — OAuth refresh_token (pas de service account).
# SEULE source de données SEO du projet. Absentes => `gsc-client.ts` retourne
# null en silence, `site-route-gsc` et `content-keyword-sync` tournent à vide.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GSC_PROPERTY_URL=sc-domain:axion-ia.com

# Plausible self-hosted : voir la section « Plausible self-hosted » plus haut
# (clés déclarées une seule fois, avec l'avertissement build-arg).

# PageSpeed Insights — absente => `content-psi-monitor` skip silencieux
# (0 échantillon `psi-lab` en base malgré un cron hebdo « réussi »).
GOOGLE_PSI_API_KEY=

# Bing Webmaster — absente => `bing-wmt-client.ts` retourne null (graceful).
BING_WMT_API_KEY=

# ⚠️ Flags à poser sur le conteneur WORKER, pas seulement WEB.
# Audit 2026-07-21 : ces 3 variables étaient posées sur WEB et ABSENTES du
# WORKER — or c'est le worker qui exécute les jobs. Résultat : voyants au vert,
# production nulle (0 embedding sur 173 articles, monitor liens jamais démarré).
CONTENT_REFRESH_ENABLED=false
GSC_HCU_MONITOR_ENABLED=false
# INDEXATION_STAGNANT_ALERT_ENABLED : désactivée volontairement le 2026-07-11
# (CTR/impressions placeholder codés à 0 => spam horaire non actionnable).
# Ne PAS remettre à true tant que les vrais chiffres GSC ne sont pas branchés.
INDEXATION_STAGNANT_ALERT_ENABLED=false

# ── Synchro sortante vers Axion CRM Pro (lot L2 AUTOPILOT CRM, 2026-08-14) ──
# Drapeau MAÎTRE. Tant qu'il ne vaut pas exactement "true" : aucune ligne
# d'outbox écrite, aucun job, aucun appel réseau — comportement identique à
# avant le lot. Rollback = remettre à false. ⚠️ À poser sur WEB **ET** WORKER
# (piège connu : flags posés sur WEB seulement, worker aveugle).
CRM_SYNC_ENABLED=false
# Second verrou, flux CANDIDATS uniquement. Ne passe à true qu'APRÈS avoir vu
# les textes de consentement v2 servis en prod (séquencement croisé de l'ordre
# de mission). Le CRM rejette de toute façon toute fiche sans consentement v2.
CRM_SYNC_CANDIDATES_ENABLED=false
# URL de l'endpoint d'ingestion du CRM.
CRM_SYNC_URL=https://api.axion-crm-pro.com/api/internal/site-sync
# Secret partagé du canal signé HMAC (64 hex : `openssl rand -hex 32`).
# Posé par l'API Coolify côté site et dans le .env serveur côté CRM —
# JAMAIS dans un commit.
SITE_SYNC_HMAC_SECRET=

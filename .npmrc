# Audit A1 P2-7 (2026-05-15) — durcissement supply chain pnpm 10.
#
# engine-strict       : refuse l'install si Node/pnpm hors range package.json#engines
#                       → garantit que Node 24 LTS + pnpm 10.33.4 sont utilisés
# loglevel            : warn = pas de spam debug, garde warnings utiles
# package-lock        : false (force pnpm-lock.yaml only ; bloque création
#                       accidentelle de package-lock.json par un dev qui
#                       lancerait npm install par erreur)
#
# Note : on garde auto-install-peers en default (true) — le lockfile actuel
# est résolu avec autoInstallPeers:true (cf. pnpm-lock.yaml ligne 4).
# Forcer strict-peer-dependencies/auto-install-peers=false casserait
# l'install --frozen-lockfile sur les transitive peers non explicites.
# À durcir éventuellement via ADR dédié si on accepte de re-résoudre le
# lockfile complet.

engine-strict=true
loglevel=warn
package-lock=false

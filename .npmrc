# Audit A1 P2-7 (2026-05-15) — durcissement supply chain pnpm 10.
# Sprint S6.3 P0-1 (2026-05-15) — `package-lock=false` retiré : pnpm 10 le mappe
# sur l'option globale `lockfile` et casse `pnpm install --frozen-lockfile` avec
# `ERR_PNPM_NO_LOCKFILE` même si pnpm-lock.yaml est commit. Le risque ciblé
# (création accidentelle de package-lock.json par un dev qui run `npm install`)
# est désormais couvert par `.gitignore` (`package-lock.json` ignoré) et le
# pre-push (`pnpm audit`). Ne PAS réintroduire sans audit pnpm 10 dédié.
#
# engine-strict       : refuse l'install si Node/pnpm hors range package.json#engines
#                       → garantit que Node 24 LTS + pnpm 10.33.4 sont utilisés
# loglevel            : warn = pas de spam debug, garde warnings utiles
#
# Note : on garde auto-install-peers en default (true) — le lockfile actuel
# est résolu avec autoInstallPeers:true (cf. pnpm-lock.yaml ligne 4).

engine-strict=true
loglevel=warn

# ============================================================
# AxionIA — env DEV LOCAL (à copier en .env.dev — non commité)
# Cible : docker/docker-compose.yml (Postgres + Redis + Mailhog)
# ============================================================

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=fr
SKIP_ENV_VALIDATION=true

# ---------- Database (Postgres docker) ----------
DATABASE_URL=postgresql://axionia:axionia_dev@localhost:5433/axionia_dev?schema=public
DIRECT_URL=postgresql://axionia:axionia_dev@localhost:5433/axionia_dev?schema=public

# ---------- Redis (docker) ----------
REDIS_URL=redis://localhost:6381

# ---------- Auth.js v5 ----------
# Génère un secret : openssl rand -base64 32
AUTH_SECRET=dev_secret_change_me_at_least_32_chars_xxxxxxxx
AUTH_URL=http://localhost:3000

# ---------- Admin ----------
ADMIN_URL_PREFIX=admin-dev-x7k2n9
ADMIN_EMAIL=admin@axion-ia.com

# ---------- Email (Mailhog SMTP) ----------
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_FROM_ADDRESS=noreply@axion-ia.com
SMTP_FROM_NAME=AxionIA Dev
SMTP_FROM_MARKETING=news@axion-ia.com
# PowerMTA / MailWizz : prod uniquement
PMTA_API_URL=
PMTA_API_KEY=
MAILWIZZ_API_URL=
MAILWIZZ_API_KEY=

# ---------- Telegram (dev = vide ou bot test) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Cloudflare Turnstile (dev keys publiques de test) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------- IndexNow ----------
INDEXNOW_KEY=dev-indexnow-key-32chars-xxxxxxxx

# ---------- Société ----------
COMPANY_NAME=AxionIA OÜ
COMPANY_REGISTRATION_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS=
COMPANY_EMAIL=contact@axion-ia.com
COMPANY_DPO_EMAIL=dpo@axion-ia.com
COMPANY_PHONE=

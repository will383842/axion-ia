  "contrat": "<div class=\"text-fg text-[15px] leading-relaxed break-words\"><h3 class=\"mt-6 mb-3 text-center font-serif text-[20px] font-medium first:mt-0\">Article 1 — Objet</h3><p class=\"my-2\">Le <strong class=\"font-semibold\">présent contrat</strong> définit les <em>conditions</em> de la présentation.</p><h4 class=\"text-terracotta-deep border-border mt-5 mb-2 border-b pb-1 text-[16px] font-bold\">1.1 Durée</h4><blockquote class=\"bg-sand my-2 rounded-lg p-3\">Une citation.</blockquote><div class=\"my-3 overflow-x-auto\"><table class=\"border-border w-full border text-[14px]\"><thead class=\"bg-terracotta-soft\"><tr><th scope=\"col\" class=\"border-border border p-1.5 text-left font-semibold\">Col A</th><th scope=\"col\" class=\"border-border border p-1.5 text-left font-semibold\">Col B</th></tr></thead><tbody><tr><td class=\"border-border border p-1.5 align-top\">1</td><td class=\"border-border border p-1.5 align-top\">2</td></tr></tbody></table></div><p class=\"my-2\">Fin.</p></div>",

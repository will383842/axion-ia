# .env.ci.example — Variables d'environnement pour CI (GitHub Actions)
#
# But : centraliser toutes les env vars nécessaires aux jobs CI (build,
# tests, type-check, lint) afin que le fichier serve de référence
# unique et que tout ajout de nouvelle env var prod ait une contrepartie
# documentée ici.
#
# Doctrine (Phase 8.bis Point 5 / runbook deploy recovery 2026-05-17) :
#   - prod source-of-truth : `.env.production.example`
#   - dev source-of-truth : `.env.dev.example`
#   - ci source-of-truth  : CE FICHIER + job-level env dans
#                            `.github/workflows/ci.yml` Gate B
#
# Format : KEY=value (valeurs dummy ou explicites NON-PROD)
# Documentation détaillée : voir `docs/ci/ENV-VARS.md`.

# ──────────────────────────────────────────────────────────────────────
# Toggles de build & runtime
# ──────────────────────────────────────────────────────────────────────
# Skippe la validation Zod stricte des env vars de prod absentes en CI
SKIP_ENV_VALIDATION=true
# Désactive l'init BullMQ (qui tente une connection Redis au SSG)
BULLMQ_DISABLED=true

# ──────────────────────────────────────────────────────────────────────
# Stubs DATABASE / REDIS (magic string "stub.invalid" — voir AGENTS.md)
# Les clients Prisma + Redis détectent cette URL et retournent des
# Proxies no-op pour permettre `pnpm prisma:generate` + `pnpm build`
# sans connexion réelle (GH Actions n'a pas accès au VPS Postgres/Redis).
# ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://stub:stub@stub.invalid:5432/stub
REDIS_URL=redis://stub.invalid:6379

# ──────────────────────────────────────────────────────────────────────
# Secrets prod factices (dummies — JAMAIS utilisés au runtime CI)
# ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=ci-dummy-auth-secret-not-used-in-build-32chars-min
ADMIN_URL_PREFIX=admin-ci-build
STRIPE_SECRET_KEY=sk_test_ci_dummy_not_used_in_build
STRIPE_PUBLISHABLE_KEY=pk_test_ci_dummy_not_used_in_build
STRIPE_WEBHOOK_SECRET=whsec_ci_dummy_not_used_in_build
BACKUP_ENCRYPTION_PASSPHRASE=ci-dummy-backup-pass-not-used-in-build

# RGPD / hash secrets (PR #14 image-bank V1 + S+1 securite-rgpd)
IP_HASH_SALT=ci-dummy-ip-hash-salt-not-used-in-build-32chars
PII_ENCRYPTION_KEY=ci-dummy-pii-encryption-key-not-used-in-build-32

# IndexNow + DocuSeal HMAC (PR #14 — vérifier en prod via UI Coolify)
INDEXNOW_INTERNAL_HMAC_SECRET=ci-dummy-indexnow-hmac-not-used-in-build-32chars
DOCUSEAL_STRICT_HMAC=ci-dummy-docuseal-hmac-not-used-in-build-32chars

# ──────────────────────────────────────────────────────────────────────
# URLs publiques
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://axion-ia.com
# ⚠️ 2026-08-23 — SECONDE LECTURE DE L'ORIGINE PUBLIQUE, À CONSOLIDER.
#
# `NEXT_PUBLIC_APP_URL` fait doublon avec `NEXT_PUBLIC_SITE_URL` ci-dessus, et
# elle n'était déclarée NULLE PART dans le dépôt — alors que trois modules la
# lisent avec un repli codé en dur :
#
#   src/app/[locale]/portail/acces/[token]/route.ts:44
#   src/server/actions/qualiopi/portail.ts:558
#   src/features/payment/actions.ts:151          ← redirections Stripe
#
# Conséquence mesurée : le lien d'accès envoyé aux stagiaires pointait TOUJOURS
# `https://axion-ia.com`, quel que soit l'environnement. Correct en production,
# faux partout ailleurs — et le parcours E2E du stagiaire mesurait donc la
# PRODUCTION au lieu du serveur local.
#
# On la déclare pour rendre le comportement observable et testable. Mais le vrai
# correctif est de N'AVOIR QU'UNE lecture : `SITE_URL` (src/lib/site-url.ts) est
# déjà la source canonique, validée par le schéma d'environnement. Consolider
# les trois appelants dessus demande de vérifier l'inlining `NEXT_PUBLIC_*` au
# build — décision et vérification à part.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=production

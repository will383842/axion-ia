// ============================================================
// 5. articles + 6. article_translations + 7. article_tags
// ============================================================

model Article {
  id              String        @id @default(uuid()) @db.Uuid
  // Champs structurels (mêmes pour toutes les langues)
  authorId        String?       @map("author_id") @db.Uuid
  author          Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId      String?       @map("category_id") @db.Uuid
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage   String?       @map("featured_image") @db.VarChar(512)
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at")
  readingTime     Int?          @map("reading_time")
  viewsCount      Int           @default(0) @map("views_count")
  commentsEnabled Boolean       @default(false) @map("comments_enabled")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // ====== CONTENT GENERATOR — Sprint 1 (v1.7 / v2.5) ======
  /// Pyramide indexation 3-tiers anti-doorway HCU (default tier-2 par sécurité).
  indexationTier      IndexationTier @default(tier_2_noindex_follow) @map("indexation_tier")
  qualityScore        Int?           @map("quality_score")
  seoScore            Int?           @map("seo_score")
  readabilityScore    Decimal?       @map("readability_score") @db.Decimal(5, 2)
  factCheckScore      Int?           @map("fact_check_score")
  editorialScore      Int?           @map("editorial_score")
  plagiarismScore     Decimal?       @map("plagiarism_score") @db.Decimal(5, 2)
  promotedAt          DateTime?      @map("promoted_at")
  /// FK ContentGenJob.id (cuid String — pas @db.Uuid)
  generatedByJobId    String?        @map("generated_by_job_id")
  directAnswer        String?        @map("direct_answer") @db.Text
  faqJson             Json?          @map("faq_json")
  /// IDs des KnowledgeEntry KB utilisées (audit trail RAG)
  kbChunkIds          String[]       @default([]) @map("kb_chunk_ids")
  templateVariant     String?        @map("template_variant") @db.VarChar(60)
  /// Pilier doctrine v1.7 (informational | commercial_investigation | …)
  searchIntent        SearchIntent?  @map("search_intent")
  // Pipeline 2 actualités RSS (§ 28.2 v1.7)
  isNews              Boolean        @default(false) @map("is_news")
  newsSourceUrl       String?        @map("news_source_url") @db.VarChar(512)
  newsSourceName      String?        @map("news_source_name") @db.VarChar(120)
  newsCategory        String?        @map("news_category") @db.VarChar(60)
  publishedAtDateline String?        @map("published_at_dateline") @db.VarChar(120)

  translations ArticleTranslation[]
  tags         ArticleTagOnArticle[]
  /// Q/R post-process auto rattachées (§ 29 v1.7)
  childFaqs    FAQ[]                 @relation("FaqParentArticle")
  /// P0-5 audit indexation 2026-05-15 — historique slug pour redirect 301
  slugHistory  ArticleSlugHistory[]

  /// City Domination 2026-05-18 P1-6 — Topic fingerprint (SimHash 64-bit hex)
  /// pour dedup sémantique au-delà de Levenshtein/MinHash texte brut. Calculé
  /// à partir des embeddings Voyage AI (cf A13 KB pipeline). Nullable :
  /// migration additive sans backfill, le helper `computeTopicFingerprint()`
  /// le remplit progressivement à chaque nouveau publish + cron retro-fill.
  /// Activation dedup côté similarity-monitor = feature flag (Sprint suivant
  /// quand Voyage AI key activée prod).
  topicFingerprint String? @map("topic_fingerprint") @db.VarChar(64)

  /// B.7 P1.5 P0-6 — Couche 3 dedup : SimHash 64-bit hex sur la sequence
  /// `h2 > h3` extraite du body HTML. Permet detection de templates editoriaux
  /// repetes (meme structure narrative meme avec mots differents). Distance
  /// Hamming <= 4 vs corpus publie = flag `duplicate_template`. Nullable :
  /// migration additive, retrofill via cron embedding-fill-worker.
  outlineSimhash String? @map("outline_simhash") @db.VarChar(16)

  /// B.7 P1.5 P0-6 — Couche 4 dedup : embedding OpenAI text-embedding-3-large
  /// avec dimensions=1536 (API param). pgvector limite HNSW+IVFFlat a 2000 dims ;
  /// 1536 < 2000. Qualite superieure a ada-002 a memes dims. HNSW cosine index.
  /// Pre-publish : si top-1 cosine > 0.85 vs corpus publie => flag duplicate_semantic.
  /// Feature flag `OPENAI_EMBEDDINGS_ENABLED` gere l'activation prod.
  embedding Unsupported("vector(1536)")?

  /// Sprint S+2 City Domination — auto-tagging géographique (Phase C strat ville).
  /// Slugs des villes mentionnées dans le body article (détection via helper
  /// `extractMentionedCitiesFromText`). Permet au hub ville de filtrer les
  /// articles blog pertinents (`getBlogPostsByVille(villeSlug, n)`).
  ///
  /// Population :
  ///  - Au publish via `extractMentionedCitiesFromText(body)` (scan VILLES array)
  ///  - Pour landing-ville generator : minimum = [anchorVilleSlug]
  ///  - Pour blog-* generators : extracted from final body post-LLM
  ///  - Retroactive scan worker possible Sprint S+3 si besoin backfill historique
  ///
  /// Default [] (empty) → article reste indexable mais n'apparaît dans aucun
  /// hub ville (générique).
  mentionedCities String[] @default([]) @map("mentioned_cities")

  generationProvenances GenerationProvenance[]
  factCheckClaims       FactCheckClaim[]
  feedback              ArticleFeedback[]

  @@index([status])
  @@index([publishedAt])
  @@index([indexationTier, status])
  @@index([isNews, publishedAt(sort: Desc)])
  @@index([generatedByJobId])
  /// Index GIN sur mentioned_cities pour filter `getBlogPostsByVille` performant
  /// (~10K articles cible, requête `WHERE 'paris' = ANY(mentioned_cities)`).
  @@index([mentionedCities], type: Gin)
  @@map("articles")
}

/// B.4 P1.5 — Traçabilité provenance IA par article (AI Act art. 50 + SOC2).
/// Chaque appel LLM impliqué dans la génération d'un article est tracé :
/// provider, modèle, tokens, coût, hash chaîné pour audit trail.
model GenerationProvenance {
  id                   String   @id @default(cuid())
  articleId            String   @map("article_id") @db.Uuid
  article              Article  @relation(fields: [articleId], references: [id], onDelete: Restrict)
  step                 String   @db.VarChar(80)
  provider             String   @db.VarChar(40)
  model                String   @db.VarChar(80)
  modelVersion         String?  @map("model_version") @db.VarChar(40)
  promptHash           String   @map("prompt_hash") @db.VarChar(64)
  inputTokens          Int      @map("input_tokens")
  outputTokens         Int      @map("output_tokens")
  cacheReadInputTokens Int      @default(0) @map("cache_read_input_tokens")
  cost                 Decimal  @db.Decimal(10, 6)
  regulationVersion    String   @default("AI-Act-2024/1689") @map("regulation_version") @db.VarChar(40)
  previousHash         String?  @map("previous_hash") @db.VarChar(64)
  hash                 String   @db.VarChar(64)
  timestamp            DateTime @default(now())

  @@index([articleId])
  @@index([timestamp])
  @@map("generation_provenance")
}

/// P4 Sprint P0-6 — Claims factuels extraits + vérifiés par fact-checker.
/// Persistance individuelle par claim pour audit trail + monitoring qualité.
/// Claim verification = stub SHA-256 V1 (Voyage AI RAG différé Sprint S+7).
model FactCheckClaim {
  id          String   @id @default(cuid())
  articleId   String   @map("article_id") @db.Uuid
  claim       String   @db.Text
  status      String   @default("unverified") @db.VarChar(30)
  sourceUrl   String?  @map("source_url") @db.VarChar(512)
  sourceTitle String?  @map("source_title") @db.VarChar(255)
  confidence  Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
  @@map("factcheck_claims")
}

model ArticleTranslation {
  id              String   @id @default(uuid()) @db.Uuid
  articleId       String   @map("article_id") @db.Uuid
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale          Locale
  title           String   @db.VarChar(255)
  slug            String   @db.VarChar(255)
  excerpt         String?  @db.Text
  body            String   @db.Text
  // Sprint 24 / C4 — sources canoniques Tiptap pour reuse cote consumer (search,
  // RSS, AMP, AI summarisation). HTML reste source rendu, JSON/text derives.
  bodyJson        Json?    @map("body_json")
  bodyText        String?  @map("body_text") @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String?  @map("meta_description") @db.VarChar(160)
  ogImage         String?  @map("og_image") @db.VarChar(512)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("article_translations")
}

/// P0-5 audit indexation 2026-05-15 — historique slug Article pour redirect 301.
///
/// À chaque rename slug (`updateArticle` / `updateArticleAction` /
/// `upsertCaseStudyAction` / `upsertHelpArticleAction`), on crée une ligne ici.
/// Les pages publiques `/fr/blog/[slug]` et `/fr/actualites/[slug]` consultent
/// cette table en fallback notFound() avant Tombstone → `redirect(301)` vers le
/// slug courant. Évite la perte SEO accumulée à chaque rename.
///
/// Ping IndexNow : à chaque création d'une ligne ici, on ping ANCIEN URL en
/// `URL_DELETED` + NOUVEAU URL en `URL_UPDATED` (helper enqueueIndexingForUrls).
model ArticleSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  oldLocale Locale   @map("old_locale")
  oldSlug   String   @map("old_slug") @db.VarChar(255)
  changedAt DateTime @default(now()) @map("changed_at")
  reason    String?  @db.Text

  @@unique([oldLocale, oldSlug])
  @@index([articleId])
  @@map("article_slug_history")
}

model ArticleTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  nameFr    String   @map("name_fr") @db.VarChar(120)

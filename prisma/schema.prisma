// ============================================================
// 31. pricing_configs — Sprint X.1 §5.1.16 (ADR 0016)
// ============================================================

/// Sprint X.1 — pricing DB-managed (ADR 0016). Remplace hardcode `pricing.ts`.
/// Modification admin -> trigger `revalidatePath()` sur pages publiques.
model PricingConfig {
  id                       String                  @id @default(uuid()) @db.Uuid
  /// 'collective_4j' | 'individuel' | 'dirigeants' | 'conference' |
  /// 'audit_flash_onsite' | etc. UNIQUE référence enum.
  interventionType         String                  @unique @map("intervention_type") @db.VarChar(80)
  format                   String?                 @db.VarChar(80)
  basePriceHtCents         Int                     @map("base_price_ht_cents")
  /// 30/50/100 (si profile fixe).
  depositPercentage        Int?                    @map("deposit_percentage")
  /// Override % si forfait fixe.
  depositFixedAmountCents  Int?                    @map("deposit_fixed_amount_cents")
  /// 0=EE reverse / 20=FR (ADR 0015).
  vatRate                  Decimal                 @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatReverseCharge         Boolean                 @default(false) @map("vat_reverse_charge")
  vatMention               String?                 @map("vat_mention") @db.Text
  /// > 5000 € HT ou format complexe -> devis obligatoire (snapshot Booking).
  quoteRequired            Boolean                 @default(false) @map("quote_required")
  feesMode                 FeesMode                @default(real_costs) @map("fees_mode")
  /// {idfCents:0, frMetroCents:25000, domTomCents:45000} si feesMode=flat_rate_by_zone.
  flatRateConfig           Json?                   @map("flat_rate_config")
  /// V1 défaut 5j (D52), configurable. Override `SiteSetting.optionExpirationDaysIfNothingReceived`.
  optionDurationDays       Int                     @default(5) @map("option_duration_days")
  paymentScheduleProfileId String?                 @map("payment_schedule_profile_id") @db.Uuid
  paymentScheduleProfile   PaymentScheduleProfile? @relation(fields: [paymentScheduleProfileId], references: [id], onDelete: SetNull)
  contractTemplateId       String?                 @map("contract_template_id") @db.Uuid
  isActive                 Boolean                 @default(true) @map("is_active")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  updatedByAdminId         String?                 @map("updated_by_admin_id") @db.Uuid
  updatedByAdmin           AdminUser?              @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([interventionType, isActive])
  @@map("pricing_configs")
}


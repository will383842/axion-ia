  // Taxonomie de ciblage média (2026-06-24) — filtrage public /presse + console.
  // Toutes additives. SSOTs réutilisés (pas de liste parallèle) :
  //   - `region`      : slug `src/content/regions.ts` (null ⇒ national / non spécifié)
  //   - `departement` : code INSEE département en texte libre (null ⇒ non spécifié)
  //   - `sector`      : slug `src/content/knowledge/sector-tags.ts` (null ⇒ tous secteurs)
  region      String?              @db.VarChar(64)
  departement String?              @db.VarChar(8)
  sector      String?              @db.VarChar(64)
  audience    PressReleaseAudience @default(GENERAL)

  translations PressReleaseTranslation[]

  @@index([status, publishedAt])
  @@index([region])
  @@index([sector])
  @@index([audience])
  @@map("press_releases")
}

model PressReleaseTranslation {
  id              String   @id @default(uuid()) @db.Uuid
  releaseId       String   @map("release_id") @db.Uuid
  locale          Locale
  title           String   @db.VarChar(255)
  slug            String   @db.VarChar(255)
  dek             String?  @db.Text
  body            String?  @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(320)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  release PressRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, locale])
  @@unique([locale, slug])
  @@map("press_release_translations")
}

model PressMediaAsset {
  id          String         @id @default(uuid()) @db.Uuid
  kind        PressMediaKind
  status      PublishStatus  @default(draft)
  storagePath String?        @map("storage_path") @db.VarChar(500)
  fileName    String?        @map("file_name") @db.VarChar(255)
  fileFormat  String?        @map("file_format") @db.VarChar(20)
  fileSize    Int?           @map("file_size")
  hashSha256  String?        @map("hash_sha256") @db.VarChar(64)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  translations PressMediaAssetTranslation[]

  @@index([status, sortOrder])
  @@map("press_media_assets")
}

model PressMediaAssetTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  locale      Locale
  title       String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  asset PressMediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, locale])
  @@map("press_media_asset_translations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Couverture médias — retombées presse externes (articles / interviews) ajoutées
// depuis l'admin. Miroir des conventions PressRelease (uuid, status, sortOrder,
// soft-delete, translations). Le contenu reste externe : on stocke l'URL de
// l'article + le média (outlet) + le titre traduit.
// ─────────────────────────────────────────────────────────────────────────────
model MediaCoverage {
  id          String        @id @default(uuid()) @db.Uuid
  outlet      String        @db.VarChar(255)
  url         String        @db.VarChar(2000)
  publishedAt DateTime      @map("published_at")
  status      PublishStatus @default(draft)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  translations MediaCoverageTranslation[]

  @@index([status, sortOrder])
  @@map("media_coverage")
}

model MediaCoverageTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  coverageId String   @map("coverage_id") @db.Uuid
  locale     Locale
  title      String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  coverage MediaCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)

  @@unique([coverageId, locale])
  @@map("media_coverage_translations")
}


/// Sprint X.1 — clé/valeur globale catégorisée. Distinct du modèle V0
/// `Setting` (table `settings`) conservé pour compat — `SiteSetting` ajoute
/// `category` + `updatedByAdminId` + clés V1 dédiées booking.
/// Clés V1 : `maxConcurrentOptionsPerSlot`, `travelMaxKmInWindow48h`,
/// `optionExpirationDaysIfNothingReceived` (D52),
/// `contractSignedWithoutDepositCutoffDays` (D52), etc.
model SiteSetting {

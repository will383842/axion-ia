/// Accès portail stagiaire. Token non-guessable 90 j, révocable, renouvelable.
/// Flux : token URL → vérif (timingSafeEqual) → cookie HttpOnly → /portail/mon-espace.
model PortailAcces {
  id         String    @id @default(uuid()) @db.Uuid
  traineeId  String    @map("trainee_id") @db.Uuid
  trainee    Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  token      String    @unique @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revoked    Boolean   @default(false)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([traineeId])
  @@map("portail_acces")
}

/// Appréciation multi-parties (off.30) : recueil structuré des retours
/// stagiaire / entreprise / financeur / formateur (≠ réclamations off.31).
model Appreciation {
  id                String             @id @default(uuid()) @db.Uuid
  source            AppreciationSource
  enrollmentId      String?            @map("enrollment_id") @db.Uuid
  /// Parcours coaching 1-to-1 AFEST (harmonisation off.30) — alternatif à enrollmentId.
  coachingSessionId String?            @map("coaching_session_id") @db.Uuid
  coachingSession   CoachingSession?   @relation("CoachingAppreciations", fields: [coachingSessionId], references: [id], onDelete: SetNull)
  traineeId         String?            @map("trainee_id") @db.Uuid
  trainee           Trainee?           @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  clientId          String?            @map("client_id") @db.Uuid
  /// Note /5 (facultative).
  note              Int?
  commentaire       String?            @db.Text
  dateAppreciation  DateTime           @map("date_appreciation")
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([source])
  @@index([dateAppreciation])
  @@index([enrollmentId])
  @@index([coachingSessionId])
  @@map("appreciations")
}

/// Demande RGPD d'un stagiaire (export ou suppression). Traçabilité du droit
/// d'accès / effacement (la suppression effective passe par `Trainee.deletedAt`).
model RgpdDemande {
  id        String            @id @default(uuid()) @db.Uuid
  traineeId String            @map("trainee_id") @db.Uuid
  trainee   Trainee           @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  type      RgpdDemandeType
  statut    RgpdDemandeStatut @default(demandee)
  demandeAt DateTime          @map("demande_at")
  traiteeAt DateTime?         @map("traitee_at")
  note      String?           @db.Text
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([traineeId])
  @@index([statut])
  @@map("rgpd_demandes")
}

// ============================================================
// QUALIOPI — T15 : Alertes système (catalogue §6.5) + emails auto + SSE.
// ~28 codes d'alerte (référent handicap, émargement/satisfaction/éval manquants,
// Qualiopi expire, BPF, OPCO, factures impayées, RGPD…). Dé-duplication par
// (code, cibleId) non résolue. Migration ADDITIVE.
// ============================================================

/// Niveau de gravité d'une alerte système.
enum AlerteNiveau {
  info
  important
  critique
}

/// Alerte système (catalogue §6.5). Générée par le moteur de règles (cron),
/// dé-dupliquée tant que non résolue. Résolution auto pour certains codes.
model AlerteSysteme {
  id        String       @id @default(uuid()) @db.Uuid
  /// Code du catalogue (ex. "opco_sans_accord", "qualiopi_expire_j30").
  code      String       @db.VarChar(80)
  niveau    AlerteNiveau
  titre     String       @db.VarChar(300)
  message   String       @db.Text
  /// Entité ciblée (TrainingSession, Trainee, Reclamation, FactureFormation…).
  cibleType String?      @map("cible_type") @db.VarChar(80)
  cibleId   String?      @map("cible_id") @db.Uuid
  lu        Boolean      @default(false)
  resolue   Boolean      @default(false)
  resolueAt DateTime?    @map("resolue_at")
  /// Verrou d'idempotence persistant : timestamp d'enqueue de l'alerte interne.
  /// NULL = jamais notifiée. Survit à la purge Redis (contrairement au jobId).
  notifiedAt DateTime?   @map("notified_at")
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([code])
  @@index([resolue])
  @@index([niveau])
  @@index([cibleType, cibleId])
  @@index([niveau, resolue, notifiedAt])
  @@map("alertes_systeme")
}


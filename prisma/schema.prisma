// CITIES — Base 2100 villes France >= 5000 hab (Phase A Sprint Perfection 2026-05-22)
// Source : INSEE communes + geo.api.gouv.fr. Suivi couverture content-gen.
// ============================================================

/// Base villes France metropolitaine + DOM-TOM >= 5 000 hab.
/// 2 100 communes ordonnees par population decroissante (Paris = priority 1).
/// Suivi couverture content-gen : isCovered / articlesCount / lastArticleAt.
model City {
  id             String @id @default(cuid())
  slug           String @unique @db.VarChar(100)
  name           String @db.VarChar(100)
  population     Int
  departmentCode String @map("department_code") @db.VarChar(3)
  departmentName String @map("department_name") @db.VarChar(80)
  regionSlug     String @map("region_slug") @db.VarChar(80)
  regionName     String @map("region_name") @db.VarChar(80)
  inseeCode      String @unique @map("insee_code") @db.VarChar(6)
  latitude       Float
  longitude      Float
  /// 1=>=100k hab, 2=20k-100k, 3=10k-20k, 4=5k-10k
  populationTier Int    @map("population_tier")
  /// Rang par population decroissante (Paris = 1)
  priority       Int

  isTargeted      Boolean   @default(true) @map("is_targeted")
  isCovered       Boolean   @default(false) @map("is_covered")
  articlesCount   Int       @default(0) @map("articles_count")
  lastArticleAt   DateTime? @map("last_article_at")
  hasEconomicData Boolean   @default(false) @map("has_economic_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([population(sort: Desc)])
  @@index([departmentCode])
  @@index([regionSlug])
  @@index([isTargeted, isCovered])
  @@index([populationTier])
  @@map("cities")
}


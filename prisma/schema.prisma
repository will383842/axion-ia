// --- Établissement (SIRET) ---
model ProspectionEstablishment {
  id                String                       @id @default(uuid()) @db.Uuid
  siret             String                       @unique @db.VarChar(14)
  companyId         String                       @map("company_id") @db.Uuid
  estSiege          Boolean                      @default(false) @map("est_siege")
  naf               String?
  trancheEffectif   String?                      @map("tranche_effectif")
  adresse           String?
  departement       String?
  codePostal        String?                      @map("code_postal")
  commune           String?
  communeCode       String?                      @map("commune_code")
  latitude          Float?
  longitude         Float?
  etatAdministratif ProspectionEtatAdministratif @default(actif) @map("etat_administratif")
  statutDiffusion   ProspectionStatutDiffusion?  @map("statut_diffusion")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  company  ProspectionCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts ProspectionContact[]
  persons  ProspectionPerson[]

  @@index([companyId])
  @@index([departement])
  @@map("prospection_establishment")
}

// --- Personne (dirigeant légal + responsable — DONNÉE PERSO) ---
model ProspectionPerson {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  establishmentId String?            @map("establishment_id") @db.Uuid
  nom             String
  prenoms         String?
  titreVerbatim   String?            @map("titre_verbatim")
  photoUrl        String?            @map("photo_url")
  linkedinUrl     String?            @map("linkedin_url")
  personKey       String             @map("person_key")
  optOut          Boolean            @default(false) @map("opt_out")
  optOutAt        DateTime?          @map("opt_out_at")
  retentionUntil  DateTime?          @map("retention_until")
  source          ProspectionSource?
  sourceUrl       String?            @map("source_url")
  collectedAt     DateTime?          @map("collected_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company       ProspectionCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment ProspectionEstablishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  roles         ProspectionPersonRole[]
  contacts      ProspectionContact[]

  @@unique([companyId, personKey])
  @@index([personKey])
  @@index([optOut])
  @@index([retentionUntil])
  @@map("prospection_person")
}

// --- Rôle d'une personne (1 → N) ---
model ProspectionPersonRole {
  id                     String                             @id @default(uuid()) @db.Uuid
  personId               String                             @map("person_id") @db.Uuid
  qualiteRaw             String?                            @map("qualite_raw")
  fonctionNormalisee     ProspectionFonctionNormalisee?     @map("fonction_normalisee")
  seniorite              ProspectionSeniorite?
  departementFonctionnel ProspectionDepartementFonctionnel? @map("departement_fonctionnel")
  estDirigeantLegal      Boolean                            @default(false) @map("est_dirigeant_legal")
  source                 ProspectionSource?
  sourceUrl              String?                            @map("source_url")
  collectedAt            DateTime?                          @map("collected_at")
  createdAt              DateTime                           @default(now()) @map("created_at")

  person ProspectionPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([fonctionNormalisee])
  @@index([seniorite])
  @@map("prospection_person_role")
}

// --- Contact (multi-emails / multi-téléphones) ---
model ProspectionContact {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  establishmentId       String?                 @map("establishment_id") @db.Uuid
  personId              String?                 @map("person_id") @db.Uuid
  type                  ProspectionContactType
  value                 String
  valueNormalized       String                  @map("value_normalized")
  isNominatif           Boolean                 @default(false) @map("is_nominatif")
  isGenerique           Boolean                 @default(false) @map("is_generique")
  personMatchConfidence Float?                  @map("person_match_confidence")
  label                 String?
  role                  String?
  isPrimary             Boolean                 @default(false) @map("is_primary")
  sharedAcrossCompanies Boolean                 @default(false) @map("shared_across_companies")
  sourceUrl             String?                 @map("source_url")
  confidence            Float?
  verifStatus           ProspectionVerifStatus? @map("verif_status")
  collectedAt           DateTime?               @map("collected_at")
  createdAt             DateTime                @default(now()) @map("created_at")

  company       ProspectionCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment ProspectionEstablishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  person        ProspectionPerson?        @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([companyId, type, valueNormalized])
  @@index([companyId])
  @@index([personId])
  @@index([valueNormalized])
  @@map("prospection_contact")
}

// --- Campagne de collecte ---
model ProspectionCampaign {
  id                    String                        @id @default(uuid()) @db.Uuid
  nom                   String
  statut                ProspectionCampaignStatut     @default(brouillon)
  departements          String[]
  nafCodes              String[]                      @map("naf_codes")
  secteurs              ProspectionSecteur[]
  tailles               ProspectionTaille[]
  typesOrganisation     ProspectionTypeOrganisation[] @map("types_organisation")
  // Mode « tout le département » : cible TOUS les secteurs (santé compris) sans
  // filtre NAF. Permet le balayage 1-clic par département (page Départements).
  toutesActivites       Boolean                       @default(false) @map("toutes_activites")
  enrichirContacts      Boolean                       @default(true) @map("enrichir_contacts")
  enrichirPersonnes     Boolean                       @default(false) @map("enrichir_personnes")
  quotaMax              Int?                          @map("quota_max")
  rythme                String?
  priorite              Int                           @default(0)
  scheduledAt           DateTime?                     @map("scheduled_at")
  recurrence            String?
  nextRunAt             DateTime?                     @map("next_run_at")
  cellulesTotal         Int                           @default(0) @map("cellules_total")
  cellulesFaites        Int                           @default(0) @map("cellules_faites")
  entreprisesCollectees Int                           @default(0) @map("entreprises_collectees")
  entreprisesEnrichies  Int                           @default(0) @map("entreprises_enrichies")
  debitParHeure         Float?                        @map("debit_par_heure")
  etaCompletion         DateTime?                     @map("eta_completion")
  createdBy             String?                       @map("created_by") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  cells ProspectionCoverageCell[]

  @@index([statut])
  @@index([nextRunAt])
  @@map("prospection_campaign")
}

// --- Cellule de couverture (matrice = work-list) ---
model ProspectionCoverageCell {
  id               String                       @id @default(uuid()) @db.Uuid
  campaignId       String                       @map("campaign_id") @db.Uuid
  departement      String
  region           String?
  naf              String
  secteur          ProspectionSecteur?
  taille           ProspectionTaille
  typeOrganisation ProspectionTypeOrganisation? @map("type_organisation")
  statut           ProspectionCellStatut        @default(a_faire)
  attendu          Int                          @default(0)
  collecte         Int                          @default(0)
  enrichi          Int                          @default(0)
  pageCursor       String?                      @map("page_cursor")
  lastError        String?                      @map("last_error")
  errorCode        String?                      @map("error_code")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  campaign ProspectionCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runs     ProspectionCollectRun[]

  @@unique([campaignId, departement, naf, taille])
  @@index([campaignId, statut])
  @@index([departement, secteur, taille])
  @@map("prospection_coverage_cell")
}

// --- Run de collecte d'une cellule (audit / idempotence) ---
model ProspectionCollectRun {
  id          String                      @id @default(uuid()) @db.Uuid
  cellId      String                      @map("cell_id") @db.Uuid
  startedAt   DateTime?                   @map("started_at")
  finishedAt  DateTime?                   @map("finished_at")
  nbResultats Int                         @default(0) @map("nb_resultats")
  nbNouveaux  Int                         @default(0) @map("nb_nouveaux")
  nbDoublons  Int                         @default(0) @map("nb_doublons")
  apiCalls    Int                         @default(0) @map("api_calls")
  status      ProspectionCollectRunStatus @default(running)
  errorCode   String?                     @map("error_code")
  createdAt   DateTime                    @default(now()) @map("created_at")

  cell ProspectionCoverageCell @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId])
  @@map("prospection_collect_run")
}

// --- Événement (append-only) ---
model ProspectionEvent {
  id         String               @id @default(uuid()) @db.Uuid
  type       ProspectionEventType
  actorId    String?              @map("actor_id") @db.Uuid
  reason     String?
  companyId  String?              @map("company_id") @db.Uuid
  campaignId String?              @map("campaign_id") @db.Uuid
  data       Json?
  createdAt  DateTime             @default(now()) @map("created_at")

  company ProspectionCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([companyId])
  @@index([campaignId])
  @@map("prospection_event")
}

// --- Prospection Santé V2 : praticien (RPPS / Annuaire Santé), nominatif ---
//   Spécialité fine (cardiologue, ophtalmologue…) que le NAF ne distingue pas.
//   ⚠️ Données nominatives de professionnels de santé → AIPD dédiée avant ingest.
model ProspectionHealthPractitioner {
  id                String             @id @default(uuid()) @db.Uuid
  rpps              String?            @unique
  nom               String
  prenoms           String?
  personKey         String             @map("person_key")
  professionLibelle String?            @map("profession_libelle")
  specialite        String?
  specialiteLibelle String?            @map("specialite_libelle")
  siret             String?            @db.VarChar(14)
  companyId         String?            @map("company_id") @db.Uuid
  adresse           String?
  codePostal        String?            @map("code_postal")
  commune           String?
  departement       String?
  telephone         String?
  email             String?
  modeExercice      String?            @map("mode_exercice")
  source            ProspectionSource?
  collectedAt       DateTime?          @map("collected_at")
  retentionUntil    DateTime?          @map("retention_until")
  optOut            Boolean            @default(false) @map("opt_out")
  optOutAt          DateTime?          @map("opt_out_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company ProspectionCompany? @relation("CompanyPractitioners", fields: [companyId], references: [id], onDelete: SetNull)

  // Identité = RPPS (upsert clé). PAS de @@unique([personKey, siret]) : deux
  // homonymes au même site (RPPS distincts) sont légitimes, et un praticien
  // multi-sites garde une ligne (site principal/dernier vu). Cf. audit V2.
  @@index([personKey])
  @@index([departement, specialite])
  @@index([specialite])
  @@index([companyId])
  @@map("prospection_health_practitioner")
}

// --- Journal d'accès aux données perso (RGPD) ---
model ProspectionAccessLog {
  id        String                     @id @default(uuid()) @db.Uuid
  userId    String                     @map("user_id") @db.Uuid
  action    ProspectionAccessLogAction
  cible     String?
  createdAt DateTime                   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("prospection_access_log")
}

// --- Tags hiérarchiques ---
model ProspectionTag {
  id        String             @id @default(uuid()) @db.Uuid
  type      ProspectionTagType
  value     String
  label     String?
  createdAt DateTime           @default(now()) @map("created_at")

  companyTags ProspectionCompanyTag[]

  @@unique([type, value])
  @@map("prospection_tag")
}

model ProspectionCompanyTag {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @map("company_id") @db.Uuid
  tagId      String                @map("tag_id") @db.Uuid
  assignedBy ProspectionAssignedBy @default(auto) @map("assigned_by")
  createdAt  DateTime              @default(now()) @map("created_at")

  company ProspectionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag     ProspectionTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([companyId, tagId])
  @@index([tagId])
  @@map("prospection_company_tag")
}

// --- Registre d'opposition (opt-out multi-clé — RGPD) ---
model ProspectionSuppressionEntry {
  id              String                     @id @default(uuid()) @db.Uuid
  type            ProspectionSuppressionType
  value           String
  valueNormalized String                     @map("value_normalized")
  raison          String?
  createdAt       DateTime                   @default(now()) @map("created_at")

  @@unique([type, valueNormalized])
  @@index([type, valueNormalized])
  @@map("prospection_suppression_entry")
}

// --- Dénominateur autoritatif (Stock Sirene) ---
model ProspectionStockReference {
  id               String                       @id @default(uuid()) @db.Uuid
  departement      String
  naf              String
  taille           ProspectionTaille
  typeOrganisation ProspectionTypeOrganisation? @map("type_organisation")
  stockAttendu     Int                          @default(0) @map("stock_attendu")
  stockRefreshedAt DateTime?                    @map("stock_refreshed_at")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  @@unique([departement, naf, taille])
  @@index([departement])
  @@map("prospection_stock_reference")
}

// --- Rollup dép→région→France (table Prisma — décision verrouillée) ---
model ProspectionGeoCoverageStat {
  id                          String                       @id @default(uuid()) @db.Uuid
  scope                       ProspectionGeoScope
  scopeId                     String                       @map("scope_id")
  dimKey                      String                       @map("dim_key")
  secteur                     ProspectionSecteur?
  taille                      ProspectionTaille?
  typeOrganisation            ProspectionTypeOrganisation? @map("type_organisation")
  stockAttendu                Int                          @default(0) @map("stock_attendu")
  collectees                  Int                          @default(0)
  enrichies                   Int                          @default(0)
  exploitables                Int                          @default(0)
  partiels                    Int                          @default(0)
  nonContactables             Int                          @default(0) @map("non_contactables")
  pctCompletion               Float                        @default(0) @map("pct_completion")
  pctExploitableSurCollectees Float                        @default(0) @map("pct_exploitable_sur_collectees")
  pctExploitableSurStock      Float                        @default(0) @map("pct_exploitable_sur_stock")
  pctPerime                   Float                        @default(0) @map("pct_perime")
  refreshedAt                 DateTime?                    @map("refreshed_at")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@unique([scope, scopeId, dimKey])
  @@index([scope])
  @@map("prospection_geo_coverage_stat")
}

// --- Série temporelle (courbes, débit, ETA) ---
model ProspectionStatsSnapshot {
  id              String              @id @default(uuid()) @db.Uuid
  date            DateTime            @db.Date
  scope           ProspectionGeoScope
  scopeId         String              @map("scope_id")
  dimKey          String              @map("dim_key")
  stockAttendu    Int                 @default(0) @map("stock_attendu")
  collectees      Int                 @default(0)
  enrichies       Int                 @default(0)
  exploitables    Int                 @default(0)
  partiels        Int                 @default(0)
  nonContactables Int                 @default(0) @map("non_contactables")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([date, scope, scopeId, dimKey])
  @@index([scope, scopeId, date])
  @@map("prospection_stats_snapshot")
}

/// Statut d'une mission d'audit IA (miroir des autres prestations).
enum AuditMissionStatut {
  planifiee
  en_cours
  realisee
  annulee
  reportee
}

/// Mission d'audit IA vendue à un client. TROISIEME type de prestation, a cote
/// des formations collectives (`TrainingSession`) et des coachings 1-to-1
/// (`CoachingSession`). Sans cette table, un audit ne pouvait etre ni affecte a
/// un formateur ni remunere (l'ancien rattachement `Booking` a ete retire).
model AuditMission {
  id           String      @id @default(uuid()) @db.Uuid
  numero       String      @unique @db.VarChar(40)
  titre        String      @db.VarChar(300)
  /// Origine : la demande d'audit (Submission type=audit). Lien souple.
  submissionId String?     @map("submission_id") @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  clientId     String?     @map("client_id") @db.Uuid
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  devisId      String?     @map("devis_id") @db.Uuid
  devis        Devis?      @relation(fields: [devisId], references: [id], onDelete: SetNull)

  dateDebut   DateTime @map("date_debut")
  dateFin     DateTime @map("date_fin")
  dureeHeures Int?     @map("duree_heures")

  lieuType       LieuType? @map("lieu_type")
  lieuIntitule   String?   @map("lieu_intitule") @db.VarChar(200)
  lieuAdresse    String?   @map("lieu_adresse") @db.Text
  lieuCodePostal String?   @map("lieu_code_postal") @db.VarChar(10)
  lieuVille      String?   @map("lieu_ville") @db.VarChar(120)
  lieuSalle      String?   @map("lieu_salle") @db.VarChar(120)
  lieuVisioUrl   String?   @map("lieu_visio_url") @db.Text

  formateurId String?  @map("formateur_id") @db.Uuid
  formateur   Trainer? @relation("AuditMissionFormateur", fields: [formateurId], references: [id], onDelete: SetNull)

  montantHtCents Int @map("montant_ht_cents")

  financementType           FinancementType? @map("financement_type")
  opcoStatut                OpcoStatut       @default(non_demande) @map("opco_statut")
  numeroDossierOpco         String?          @map("numero_dossier_opco") @db.VarChar(60)
  priseEnChargeMontantCents Int?             @map("prise_en_charge_montant_cents")

  // ── Acompte (suivi manuel, non lié à Stripe) ──
  acompteMontantCents  Int?      @map("acompte_montant_cents")
  acompteDateVersement DateTime? @map("acompte_date_versement") @db.Date
  acompteRecu          Boolean   @default(false) @map("acompte_recu")
  acompteMoyen         String?   @map("acompte_moyen") @db.VarChar(60)

  statut    AuditMissionStatut @default(planifiee)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  feeLines            TrainerFeeLine[]
  facturesFormation   FactureFormation[]
  dossiersFinancement DossierFinancement[]

  @@index([clientId])
  @@index([devisId])
  @@index([formateurId])
  @@index([statut])
  @@index([dateDebut])
  @@index([dateDebut, dateFin])
  @@map("audit_missions")
}

/// QR codes dynamiques (onglet admin "QR codes & liens").
/// Chaque QR imprimé encode https://axion-ia.com/qr/<slug> et redirige (302)
/// vers `destinationUrl`, modifiable à tout moment SANS réimprimer.
/// `scanCount`/`lastScanAt` = pilotage (nb de scans). Décision Will 2026-07-18.
model QrLink {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique @db.VarChar(120)
  destinationUrl String    @map("destination_url") @db.Text
  label          String    @db.VarChar(200)
  /// Regroupement pour l'admin (sous-onglets) : "catalogue-formations", "avis-catalogue", "general", …
  category       String    @default("general") @db.VarChar(80)
  active         Boolean   @default(true)
  scanCount      Int       @default(0) @map("scan_count")
  lastScanAt     DateTime? @map("last_scan_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@index([category])
  @@map("qr_links")
}

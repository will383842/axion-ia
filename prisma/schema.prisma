// ============================================================
// 1. submissions
// ============================================================

model Submission {
  id                 String           @id @default(uuid()) @db.Uuid
  type               SubmissionType
  status             SubmissionStatus @default(new)
  locale             Locale           @default(fr)
  // Identité société
  companyName        String           @map("company_name") @db.VarChar(255)
  registrationNumber String?          @map("registration_number") @db.VarChar(40)
  sector             String?          @db.VarChar(100)
  address            String?          @db.Text
  employeesCount     String?          @map("employees_count") @db.VarChar(20)
  // Contact
  contactName        String           @map("contact_name") @db.VarChar(255)
  contactRole        String?          @map("contact_role") @db.VarChar(100)
  contactEmail       String           @map("contact_email") @db.Citext
  contactPhone       String?          @map("contact_phone") @db.VarChar(30)
  // Payload form
  details            Json
  // Admin workflow
  internalNotes      String?          @map("internal_notes") @db.Text
  assignedTo         String?          @map("assigned_to") @db.VarChar(100)
  // Anti-spam / source
  ipAddress          String?          @map("ip_address") @db.VarChar(64)
  userAgent          String?          @map("user_agent") @db.Text
  referer            String?          @db.Text
  turnstileScore     Decimal?         @map("turnstile_score") @db.Decimal(4, 3)
  // Timestamps
  submittedAt        DateTime         @default(now()) @map("submitted_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  bookings               Booking[]
  // Sprint X.1 (D44) — parcours B : Submission qualifiée -> Booking via
  // `createBookingFromSubmissionAction`. Relation distincte de `bookings`
  // (qui matche le legacy `submissionId`).
  bookingsFromSubmission Booking[] @relation("BookingFromSubmission")

  @@index([type])
  @@index([status])
  @@index([locale])
  @@index([submittedAt])
  @@index([contactEmail])
  @@map("submissions")
}

// ============================================================
// 2. bookings
// ============================================================

model Booking {
  id                String           @id @default(uuid()) @db.Uuid
  interventionType  InterventionType @map("intervention_type")
  bookingDate       DateTime         @map("booking_date")
  participantsCount Int              @map("participants_count")
  // Tarification (Sprint 14.10.x — pricing.ts SSOT) — V0 conservé compat,
  // Sprint X.1 ajoute snapshot `basePriceHtCents` + frais accessoires (cf. infra).
  participantsTier  String?          @map("participants_tier") @db.VarChar(40)
  pricePaidCents    Int?             @map("price_paid_cents")
  // Locale (langue formulaire)
  locale            Locale           @default(fr)
  // Liens existants
  submissionId      String?          @map("submission_id") @db.Uuid
  submission        Submission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  slotId            String?          @unique @map("slot_id") @db.Uuid
  slot              CalendarSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  // Calendrier externe (legacy Cal.com — peut rester null après migration calendrier maison)
  calendarEventId   String?          @map("calendar_event_id") @db.VarChar(255)
  status            BookingStatus    @default(pending)
  internalNotes     String?          @map("internal_notes") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // ============================================================
  // Sprint X.1 — Extensions Booking V1 (22 colonnes)
  // Source : `_AUDIT/BOOKING-DEPOSIT-ADMIN-2026-05-12/03-ARCHITECTURE-CIBLE.md` §5.1.3
  // ============================================================

  // --- Pricing snapshot (PricingConfig snapshot au moment de la pré-réservation)
  /// Sprint X.1 — base de calcul snapshot depuis `PricingConfig`.
  basePriceHtCents      Int?     @map("base_price_ht_cents")
  /// Sprint X.1 — frais déplacement (mode real_costs).
  travelFeeCents        Int      @default(0) @map("travel_fee_cents")
  accommodationFeeCents Int      @default(0) @map("accommodation_fee_cents")
  mealFeeCents          Int      @default(0) @map("meal_fee_cents")
  additionalFeesCents   Int      @default(0) @map("additional_fees_cents")
  additionalFeesNotes   String?  @map("additional_fees_notes") @db.Text
  /// Sprint X.1 — mode frais accessoires (snapshot depuis PricingConfig).
  feesMode              FeesMode @default(real_costs) @map("fees_mode")

  // --- Acompte + solde (deposit-validation-gated)
  /// Sprint X.1 — montant acompte attendu (snapshot depuis PricingConfig).
  depositAmountCents Int?      @map("deposit_amount_cents")
  depositPaidAt      DateTime? @map("deposit_paid_at")
  /// Sprint X.1 — montant solde attendu.
  balanceAmountCents Int?      @map("balance_amount_cents")
  balancePaidAt      DateTime? @map("balance_paid_at")

  // --- Devis / NDA / contrat
  /// Sprint X.1 — dérivé `PricingConfig.quoteRequired` (snapshot).
  quoteRequired Boolean @default(false) @map("quote_required")
  ndaRequired   Boolean @default(false) @map("nda_required")

  // --- Parcours d'origine (D44, parcours A/B)
  /// Sprint X.1 (D44) — parcours visiteur (direct calendrier / devis qualifié).
  originPath       BookingOriginPath @default(direct) @map("origin_path")
  /// Sprint X.1 (D44) — FK -> Submission (parcours B uniquement). NULL parcours A.
  fromSubmissionId String?           @map("from_submission_id") @db.Uuid
  fromSubmission   Submission?       @relation("BookingFromSubmission", fields: [fromSubmissionId], references: [id], onDelete: SetNull)

  // --- Liens optionnels vers entités V1
  /// Sprint X.1 — FK -> CadrageMeeting (1-1 logique, 1 cadrage par booking).
  cadrageMeetingId         String?                 @map("cadrage_meeting_id") @db.Uuid
  cadrageMeeting           CadrageMeeting?         @relation(fields: [cadrageMeetingId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> Quote actif (semi-auto Will-A).
  quoteId                  String?                 @map("quote_id") @db.Uuid
  quote                    Quote?                  @relation("BookingActiveQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> ContractDocument actif (DocuSeal V1).
  contractDocumentId       String?                 @map("contract_document_id") @db.Uuid
  contractDocument         ContractDocument?       @relation("BookingActiveContract", fields: [contractDocumentId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> PaymentScheduleProfile (snapshot override possible).
  paymentScheduleProfileId String?                 @map("payment_schedule_profile_id") @db.Uuid
  paymentScheduleProfile   PaymentScheduleProfile? @relation(fields: [paymentScheduleProfileId], references: [id], onDelete: SetNull)

  // --- Géo-awareness (OSM Nominatim + buffer trajet, D24)
  /// Sprint X.1 — ville société normalisée pour géocodage.
  companyCityNormalized String?      @map("company_city_normalized") @db.VarChar(120)
  companyLat            Decimal?     @map("company_lat") @db.Decimal(9, 6)
  companyLng            Decimal?     @map("company_lng") @db.Decimal(9, 6)
  /// Sprint X.1 (D24) — buffer trajet auto (0/1/2 jours selon distance).
  travelBufferDays      Float        @default(0) @map("travel_buffer_days")
  /// Sprint X.1 — classification INSEE (snapshot depuis Submission.details).
  companySize           CompanySize? @map("company_size")

  // --- Sentinels cycle de vie
  confirmedAt        DateTime?           @map("confirmed_at")
  completedAt        DateTime?           @map("completed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason String?             @map("cancellation_reason") @db.VarChar(500)
  cancellationWindow CancellationWindow? @map("cancellation_window")
  cancelledByUserId  String?             @map("cancelled_by_user_id") @db.Uuid
  cancelledByUser    AdminUser?          @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  forceMajeureNotes  String?             @map("force_majeure_notes") @db.Text

  // --- Pause (D61)
  /// Sprint X.1 (D61) — sentinel activation pause + slot libéré pendant la pause.
  pausedAt    DateTime? @map("paused_at")
  pausedUntil DateTime? @map("paused_until")
  pauseReason String?   @map("pause_reason") @db.VarChar(500)

  // --- Overrides + V2 hooks
  /// Sprint X.1 (D64) — overrides JSON par booking (modes manuels togglables).
  overrides         Json?   @map("overrides")
  /// HOOK V2+ Qualiopi — pas de table V1, juste un champ FK nullable préparé.
  trainingSessionId String? @map("training_session_id") @db.Uuid

  // ============================================================
  // Sprint X.1 — relations inverses V1
  // ============================================================
  payments          Payment[]
  invoices          Invoice[]
  contractDocuments ContractDocument[]      @relation("BookingContractDocuments")
  quotes            Quote[]                 @relation("BookingQuotes")
  transitions       BookingTransition[]
  paymentSchedule   BookingPaymentSchedule?

  @@index([interventionType])
  @@index([bookingDate])
  @@index([status])
  @@index([locale])
  @@index([originPath])
  @@index([fromSubmissionId])
  @@index([companyCityNormalized])
  @@index([pausedUntil])
  @@index([cancellationWindow])
  @@map("bookings")
}


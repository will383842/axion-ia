  aucune
}

/// Évaluation des acquis d'un stagiaire (grille par objectif pédagogique).
/// Plusieurs lignes par inscription possibles (initiale + intermédiaire(s) +
/// finale). La `finale` la plus récente fait foi pour la réussite.
model EvaluationAcquis {
  id                String            @id @default(uuid()) @db.Uuid
  /// Inscription (formation collective). Nullable depuis le 1-to-1 AFEST (C1) :
  /// une évaluation peut être rattachée à un parcours coaching sans Enrollment.
  /// Invariant applicatif : exactement un de (enrollmentId, coachingSessionId).
  enrollmentId      String?           @map("enrollment_id") @db.Uuid
  enrollment        Enrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Coaching 1-to-1 AFEST (C1). Null pour une évaluation de formation collective.
  coachingSessionId String?           @map("coaching_session_id") @db.Uuid
  coachingSession   CoachingSession?  @relation("CoachingEvaluations", fields: [coachingSessionId], references: [id], onDelete: Cascade)
  type              EvaluationType
  dateEvaluation    DateTime          @map("date_evaluation")
  scoreObtenu       Int               @map("score_obtenu")
  scoreMax          Int               @map("score_max")
  scorePct          Int               @map("score_pct")
  niveauGlobal      NiveauAcquisition @map("niveau_global")
  /// scorePct ≥ seuil_reussite_pct de la formation.
  reussite          Boolean           @default(false)
  /// [{ libelle, note(1-3), observations?, objectifRef? }] — lien objectif↔éval.
  competences       Json              @default("[]")
  recommandations   String?           @db.Text
  /// Admin/formateur ayant saisi l'évaluation.
  evalueParId       String?           @map("evalue_par_id") @db.Uuid

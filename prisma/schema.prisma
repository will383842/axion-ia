  refClient                     String?                      @map("ref_client") @db.VarChar(120)
  /// Client CRM facturé (factures libres du Hub ; null pour les factures
  /// historiques dérivées d'une session — le client y est via la session).
  clientId                      String?                      @map("client_id") @db.Uuid
  client                        Client?                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Devis d'origine (conversion devis → facture).
  devisId                       String?                      @map("devis_id") @db.Uuid
  devis                         Devis?                       @relation(fields: [devisId], references: [id], onDelete: SetNull)
  /// Mission d'audit facturée (3e type de prestation, cf. AuditMission).
  auditMissionId                String?                      @map("audit_mission_id") @db.Uuid
  auditMission                  AuditMission?                @relation(fields: [auditMissionId], references: [id], onDelete: SetNull)
  /// Dossier de financement rattaché (pilotage OPCO/FT — Phase 3).
  dossierFinancementId          String?                      @map("dossier_financement_id") @db.Uuid
  dossierFinancement            DossierFinancement?          @relation(fields: [dossierFinancementId], references: [id], onDelete: SetNull)
  /// Plan récurrent générateur (brouillons mensuels — Phase 5).
  planRecurrentId               String?                      @map("plan_recurrent_id") @db.Uuid
  planRecurrent                 PlanRecurrent?               @relation(fields: [planRecurrentId], references: [id], onDelete: SetNull)
  /// Facture importée d'un système antérieur (reprise d'historique C9) :
  /// hors séquence AXI-FACT, incluse aux dashboards/balance âgée.
  estImportee                   Boolean                      @default(false) @map("est_importee")
  /// Session de formation collective. Nullable depuis le 1-to-1 AFEST (C1) :
  /// une facture peut cibler un `CoachingContract` sans TrainingSession.
  sessionId                     String?                      @map("session_id") @db.Uuid
  session                       TrainingSession?             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// Contrat de coaching 1-to-1 AFEST (C1). Null pour une facture de formation.
  coachingContractId            String?                      @map("coaching_contract_id") @db.Uuid
  coachingContract              CoachingContract?            @relation(fields: [coachingContractId], references: [id], onDelete: SetNull)
  /// Inscription ciblée (R-INTER) : facture PAR participant en inter-entreprises.
  /// Null = facture au niveau session (intra, inchangé).
  enrollmentId                  String?                      @map("enrollment_id") @db.Uuid
  enrollment                    Enrollment?                  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  destinataire                  FactureFormationDestinataire
  destinataireNom               String                       @map("destinataire_nom") @db.VarChar(250)
  destinataireSiret             String?                      @map("destinataire_siret") @db.VarChar(20)
  /// N° TVA intracommunautaire du destinataire (EN 16931 BT-48).
  destinataireTvaIntracom       String?                      @map("destinataire_tva_intracom") @db.VarChar(40)
  destinataireAdresse           String?                      @map("destinataire_adresse") @db.Text
  montantHtCents                Int                          @map("montant_ht_cents")
  /// Exonération TVA (dérivé : true si montantTvaCents == 0). Conservé pour
  /// rétro-compat / export ; la source de vérité est `regimeTva`.
  tvaExoneree                   Boolean                      @default(true) @map("tva_exoneree")
  /// Régime de TVA appliqué (snapshot) : "assujetti" | "exoneration_261" |
  /// "franchise_293b". Qualiopi n'a aucun effet sur la TVA — cf. legal/tva.ts.
  regimeTva                     String                       @default("assujetti") @map("regime_tva") @db.VarChar(30)
  /// Montant total de TVA (centimes). 0 si exonéré/franchise.
  montantTvaCents               Int                          @default(0) @map("montant_tva_cents")
  /// Montant total TTC (centimes) = HT + TVA. Null pour les anciennes factures.
  montantTtcCents               Int?                         @map("montant_ttc_cents")
  /// Lignes : [{ designation, quantite, prixUnitaireHtCents, tauxTvaPercent? }].
  lignes                        Json                         @default("[]")
  subrogation                   Boolean                      @default(false)
  numeroDossierOpco             String?                      @map("numero_dossier_opco") @db.VarChar(60)
  /// Aide France Travail (AIF/POEI) prise en charge (centimes), si financement FT.
  montantAideFranceTravailCents Int?                         @map("montant_aide_france_travail_cents")
  statut                        FactureFormationStatut       @default(brouillon)
  /// Avoir : facture d'origine rectifiée (montants de CETTE facture négatifs).
  avoirDeId                     String?                      @map("avoir_de_id") @db.Uuid
  avoirDe                       FactureFormation?            @relation("FactureFormationAvoir", fields: [avoirDeId], references: [id], onDelete: Restrict)
  avoirs                        FactureFormation[]           @relation("FactureFormationAvoir")
  /// DocumentGenere (PDF) associé.
  documentId                    String?                      @map("document_id") @db.Uuid
  emiseAt                       DateTime?                    @map("emise_at")
  echeanceAt                    DateTime?                    @map("echeance_at")
  /// Date du dernier encaissement soldant la facture (statut payee).
  paidAt                        DateTime?                    @map("paid_at")
  createdAt                     DateTime                     @default(now()) @map("created_at")
  updatedAt                     DateTime                     @updatedAt @map("updated_at")

  payments          Payment[]
  dossierPayeurs    DossierPayeur[]
  relancesProposees RelanceProposee[]

  @@index([sessionId])
  @@index([enrollmentId])
  @@index([coachingContractId])
  @@index([clientId])
  @@index([devisId])
  @@index([auditMissionId])
  @@index([dossierFinancementId])
  @@index([planRecurrentId])
  @@index([activite])
  @@index([statut])
  /// Prévisionnel d'encaissement et relances impayés (cockpit).
  @@index([statut, emiseAt])
  @@index([echeanceAt])
  @@map("factures_formation")
}


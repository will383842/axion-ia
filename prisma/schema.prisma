  dossierFinancementId String?             @map("dossier_financement_id") @db.Uuid
  dossierFinancement   DossierFinancement? @relation(fields: [dossierFinancementId], references: [id], onDelete: Cascade)

  /// Suggestion de message (pré-remplit l'email — éditable avant envoi).
  suggestion       String?   @db.Text

  parentArticleId   String?        @map("parent_article_id") @db.Uuid
  parentArticle     Article?       @relation("FaqParentArticle", fields: [parentArticleId], references: [id], onDelete: SetNull)
  /// { topic, ville, audience, similarQaIds[], parentTitle, parentSlug }

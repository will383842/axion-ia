/// Type de financeur d'un dossier de financement.
enum DossierFinancementType {
  opco
  france_travail
  cpf
  mixte
}

/// Cycle de vie d'un dossier de financement. Transitions MANUELLES (admin),
/// journalisées dans ActivityLog — aucun email automatique, jamais.
enum DossierFinancementStatut {
  a_monter
  envoye
  accord_recu
  refuse
  facture
  paiement_recu
  clos
}

/// Type de payeur d'une créance dans un dossier (multi-payeurs : un dossier
/// mixte peut combiner OPCO subrogé + entreprise + France Travail).
enum DossierPayeurType {
  entreprise
  opco_subroge
  france_travail
  stagiaire
}

/// Dossier de financement TRANSVERSAL (Hub facturation, Phase 3). Regroupe le
/// cycle de vie d'une demande (OPCO/France Travail/CPF/mixte) : demande →
/// accord/refus → facturation → paiement reçu → clos. Le montant REÇU n'est
/// jamais dupliqué ici : il se dérive des `Payment` des factures liées
/// (Payment = SSOT encaissements). Les champs OPCO historiques de
/// `TrainingSession`/`Enrollment` restent la source des validations Qualiopi ;
/// ce modèle est la vue de PILOTAGE (qui paie, combien, où en est l'accord).
model DossierFinancement {
  id                   String                   @id @default(uuid()) @db.Uuid
  type                 DossierFinancementType
  statut               DossierFinancementStatut @default(a_monter)
  /// Nom du financeur principal (ex. « OPCO Atlas », « France Travail »).
  financeurNom         String?                  @map("financeur_nom") @db.VarChar(120)
  /// N° du dossier chez le financeur (référence externe).
  numeroDossierExterne String?                  @map("numero_dossier_externe") @db.VarChar(80)
  subrogation          Boolean                  @default(false)
  montantDemandeCents  Int?                     @map("montant_demande_cents")
  montantAccordeCents  Int?                     @map("montant_accorde_cents")
  /// Date de paiement attendue du financeur (les OPCO paient à 30-60 j).
  echeanceFinanceurAt  DateTime?                @map("echeance_financeur_at")
  envoyeAt             DateTime?                @map("envoye_at")
  accordAt             DateTime?                @map("accord_at")
  refuseAt             DateTime?                @map("refuse_at")
  paiementRecuAt       DateTime?                @map("paiement_recu_at")
  closAt               DateTime?                @map("clos_at")
  notes                String?                  @db.Text

  clientId           String?           @map("client_id") @db.Uuid
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  trainingSessionId  String?           @map("training_session_id") @db.Uuid
  trainingSession    TrainingSession?  @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  coachingContractId String?           @map("coaching_contract_id") @db.Uuid
  coachingContract   CoachingContract? @relation(fields: [coachingContractId], references: [id], onDelete: SetNull)
  auditMissionId     String?           @map("audit_mission_id") @db.Uuid
  auditMission       AuditMission?     @relation(fields: [auditMissionId], references: [id], onDelete: SetNull)
  devisId            String?           @map("devis_id") @db.Uuid
  devis              Devis?            @relation(fields: [devisId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payeurs           DossierPayeur[]
  factures          FactureFormation[]
  relancesProposees RelanceProposee[]

  @@index([statut])
  @@index([clientId])
  @@index([trainingSessionId])
  @@index([type, statut])
  @@map("dossiers_financement")
}

/// Créance d'un payeur dans un dossier (N payeurs par dossier — C8 du plan).
/// En subrogation : une ligne OPCO (facture à l'OPCO) + une ligne entreprise

// ============================================================
// Sprint X.1 — Booking V1 (deposit-validation-gated)
// 15 nouvelles tables instanciées V1 (+ 1 hook V1.5+ documenté ci-dessous,
// `OnboardingDoc`, qui n'est PAS un modèle Prisma actif V1).
// Sources : `_AUDIT/BOOKING-DEPOSIT-ADMIN-2026-05-12/03-ARCHITECTURE-CIBLE.md`
// §5.1.5 → §5.1.20 + ADR 0012 à 0020.
// ============================================================

// ============================================================
// 20. payments — Sprint X.1 §5.1.5
// ============================================================

/// Sprint X.1 — paiements Stripe + manuels (virement/chèque/espèces).
/// EUR-only V1 ; reverse-charge B2B intra-UE EE (ADR 0015).
model Payment {
  id                        String          @id @default(uuid()) @db.Uuid
  bookingId                 String          @map("booking_id") @db.Uuid
  booking                   Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoiceId                 String?         @map("invoice_id") @db.Uuid
  invoice                   Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider                  PaymentProvider
  /// Stripe `event.id` (idempotence webhook) OU référence manuelle. NULL si
  /// paiement manuel sans réf. fournie.
  providerEventId           String?         @unique @map("provider_event_id") @db.VarChar(255)
  providerCustomerId        String?         @map("provider_customer_id") @db.VarChar(120)
  providerPaymentIntentId   String?         @map("provider_payment_intent_id") @db.VarChar(120)
  providerCheckoutSessionId String?         @map("provider_checkout_session_id") @db.VarChar(120)
  amountCents               Int             @map("amount_cents")
  currency                  String          @default("EUR") @db.VarChar(3)
  type                      PaymentType
  status                    PaymentStatus   @default(pending)
  paidAt                    DateTime?       @map("paid_at")
  failedAt                  DateTime?       @map("failed_at")
  /// Redacted, jamais le PAN.
  failureReason             String?         @map("failure_reason") @db.VarChar(500)
  /// Numéro virement / chèque / autre référence physique.
  receivedReference         String?         @map("received_reference") @db.VarChar(120)
  /// Mode bas-niveau : "card", "sepa_credit_transfer", "cheque", "cash".
  mode                      String?         @db.VarChar(40)
  notes                     String?         @db.Text
  recordedByAdminId         String?         @map("recorded_by_admin_id") @db.Uuid
  recordedByAdmin           AdminUser?      @relation("PaymentRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  /// D63 — true si Payment rétrofitté par script `migrate-bookings-v0-to-v1.ts`.
  isHistorical              Boolean         @default(false) @map("is_historical")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")
  Refund                    Refund[]

  @@index([bookingId, type, status])
  @@index([providerEventId])
  @@index([providerPaymentIntentId])
  @@index([status, type, paidAt])
  @@index([provider, status])
  @@index([isHistorical])
  @@map("payments")
}

// ============================================================
// 21. invoices — Sprint X.1 §5.1.6
// ============================================================

/// Sprint X.1 — factures séquentielles immuables AXION-2026-NNNN.
/// Numérotation atomique via advisory lock (cf. Agent 11 P1-6).
/// Archivage 10 ans (D30) via `archivedUntil`. Architecture TVA-agnostique
/// FR vs EE (ADR 0015) — snapshot CGV/mention TVA dans `legalSnapshot` JSONB.
model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  /// Format `AXION-2026-NNNN` séquentiel atomique (D29).
  number                String        @unique @db.VarChar(40)
  bookingId             String        @map("booking_id") @db.Uuid
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type                  InvoiceType
  installmentNumber     Int?          @map("installment_number")
  // Pricing breakdown (snapshot PricingConfig)
  basePriceHtCents      Int           @map("base_price_ht_cents")
  travelFeeCents        Int           @default(0) @map("travel_fee_cents")
  accommodationFeeCents Int           @default(0) @map("accommodation_fee_cents")
  mealFeeCents          Int           @default(0) @map("meal_fee_cents")
  additionalFeesCents   Int           @default(0) @map("additional_fees_cents")
  additionalFeesNotes   String?       @map("additional_fees_notes") @db.Text
  amountHtCents         Int           @map("amount_ht_cents")
  /// 0.00 = EE reverse-charge / 20.00 = FR (snapshot moment d'émission).
  vatRate               Decimal       @map("vat_rate") @db.Decimal(5, 2)
  vatReverseCharge      Boolean       @default(false) @map("vat_reverse_charge")
  vatMention            String?       @map("vat_mention") @db.Text
  amountTtcCents        Int           @map("amount_ttc_cents")
  depositExpectedCents  Int?          @map("deposit_expected_cents")
  balanceExpectedCents  Int?          @map("balance_expected_cents")
  /// Hetzner Storage Box signed URL OU Stripe hosted_invoice_url.
  pdfUrl                String?       @map("pdf_url") @db.Text
  hashSha256            String?       @map("hash_sha256") @db.VarChar(64)
  issuedAt              DateTime      @default(now()) @map("issued_at")
  dueAt                 DateTime?     @map("due_at")
  paidAt                DateTime?     @map("paid_at")
  status                InvoiceStatus @default(draft)
  /// = issuedAt + 10 ans (archivage légal D30).
  archivedUntil         DateTime      @map("archived_until")
  /// V1 = `client` uniquement exposé UI ; `opco_v2`/`autre_v2` hooks V2+.
  payerType             PayerType     @default(client) @map("payer_type")
  payerName             String?       @map("payer_name") @db.VarChar(300)
  payerVatNumber        String?       @map("payer_vat_number") @db.VarChar(40)
  payerAddress          String?       @map("payer_address") @db.Text
  payerEmail            String?       @map("payer_email") @db.Citext
  locale                Locale        @default(fr)
  /// Snapshot CGV + mention TVA + statut juridique au moment d'émission
  /// (immuable, exigé Agent 11 P0-4/P0-5).
  legalSnapshot         Json          @map("legal_snapshot")
  /// Avoir lié à facture origine (FK self).
  creditNoteOfId        String?       @map("credit_note_of_id") @db.Uuid
  creditNoteOf          Invoice?      @relation("InvoiceCreditNote", fields: [creditNoteOfId], references: [id], onDelete: SetNull)
  creditNotes           Invoice[]     @relation("InvoiceCreditNote")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  payments Payment[]
  refunds  Refund[]

  @@index([bookingId, type, status])
  @@index([number])
  @@index([dueAt])
  @@index([paidAt])
  @@index([status, issuedAt])
  @@index([payerEmail])
  @@map("invoices")
}

// ============================================================
// 22. refunds — Sprint X.1 §5.1.7
// ============================================================

/// Sprint X.1 — refunds Stripe ou manuels (cf. ADR 0013).
model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId      String       @map("payment_id") @db.Uuid
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents    Int          @map("amount_cents")
  reason         RefundReason
  /// "partial" | "full".
  scope          String       @db.VarChar(20)
  status         RefundStatus @default(pending)
  /// re_... Stripe (NULL si refund manuel).
  stripeRefundId String?      @unique @map("stripe_refund_id") @db.VarChar(120)
  adminUserId    String?      @map("admin_user_id") @db.Uuid
  adminUser      AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  processedAt    DateTime?    @map("processed_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}


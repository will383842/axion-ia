// ============================================================
// 1. submissions
// ============================================================

model Submission {
  id                 String            @id @default(uuid()) @db.Uuid
  /// Méta-cert 2026-05-15 — UUID v4 client-side anti double-submit (OWASP A04).
  /// Partagée avec Booking si Submission créée dans la même tx (cas
  /// `createBookingAction`). Nullable car les Submissions historiques + autres
  /// types (`contact`, `audit`) n'utilisent pas encore d'idempotency key.
  idempotencyKey     String?           @unique @map("idempotency_key") @db.VarChar(64)
  type               SubmissionType
  status             SubmissionStatus  @default(new)
  locale             Locale            @default(fr)
  // Identité société
  companyName        String            @map("company_name") @db.VarChar(255)
  registrationNumber String?           @map("registration_number") @db.VarChar(40)
  sector             String?           @db.VarChar(100)
  address            String?           @db.Text
  employeesCount     String?           @map("employees_count") @db.VarChar(20)
  // Contact
  // contact_name / contact_phone en TEXT : ces colonnes reçoivent des valeurs
  // CHIFFRÉES (encryptPii, AES-256-GCM → `enc:v1:iv:ct:tag` ~100+ chars) qui
  // débordaient VARCHAR(255)/VARCHAR(30) → P2000 « value too long » sur
  // submission.create dès que PII_ENCRYPTION_KEY est active (audit 2026-07-01).
  contactName        String            @map("contact_name") @db.Text
  contactRole        String?           @map("contact_role") @db.VarChar(100)
  contactEmail       String            @map("contact_email") @db.Citext
  contactPhone       String?           @map("contact_phone") @db.Text
  // Payload form
  details            Json
  // Admin workflow
  internalNotes      String?           @map("internal_notes") @db.Text
  assignedTo         String?           @map("assigned_to") @db.VarChar(100)
  // Anti-spam / source
  /// Sprint Correctif S+1 P0-S1-3 (2026-05-16) — DEPRECATED, à drop S+2 après
  /// backfill `prisma/scripts/backfill-ip-hash-2026-05-16.ts`. Lecture seule.
  ipAddress          String?           @map("ip_address") @db.VarChar(64)
  /// Sprint Correctif S+1 P0-S1-3 (2026-05-16) — SHA-256(salt::ip) 16 hex.
  /// Helper `src/lib/security/ip-hash.ts`. Doctrine RGPD art. 4-1.
  ipHash             String?           @map("ip_hash") @db.VarChar(64)
  userAgent          String?           @map("user_agent") @db.Text
  referer            String?           @db.Text
  turnstileScore     Decimal?          @map("turnstile_score") @db.Decimal(4, 3)
  /// Chatbot D-LEAD-SOURCE (2026-06-01) — origine du lead. NULL par défaut pour
  /// toutes les Submissions existantes/formulaires (rétro-compatible). Le tool
  /// `capturer_lead` pose `chatbot`. Filtrable en console admin.
  source             SubmissionSource? @map("source")
  // Timestamps
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  bookings               Booking[]
  // Sprint X.1 (D44) — parcours B : Submission qualifiée -> Booking via
  // `createBookingFromSubmissionAction`. Relation distincte de `bookings`
  // (qui matche le legacy `submissionId`).
  bookingsFromSubmission Booking[]      @relation("BookingFromSubmission")
  auditMissions          AuditMission[]

  // Sprint Notif Infra 2026-05-26 / Chantier 5 — reply system admin.
  // Permet à Will de répondre directement aux contacts/leads via l'admin
  // inbox + suivre delivery status. Cf. ADR 0031 reply-system.
  replies        SubmissionReply[]
  /// Compteur cache (incrémenté à chaque reply envoyée). Évite count() à
  /// chaque rendu listing pour le badge "Répondu (N)".
  replyCount     Int               @default(0) @map("reply_count")
  /// Timestamp du premier envoi réussi. Snapshot pour audit + tri.
  firstRepliedAt DateTime?         @map("first_replied_at")
  /// Timestamp du dernier envoi réussi. Filtre "Dernière réponse depuis...".
  lastRepliedAt  DateTime?         @map("last_replied_at")
  /// True = nécessite l'attention de Will (default pour toute nouvelle
  /// soumission). Passe à false dès qu'au moins 1 reply envoyé OU manual
  /// archive. Filtre par défaut du listing inbox.
  needsAttention Boolean           @default(true) @map("needs_attention")
  /// Timestamp d'archivage explicite (en plus de status="archived"). Permet
  /// de filtrer rapidement les non-archivés sans toucher au workflow status
  /// existant.
  archivedAt     DateTime?         @map("archived_at")
  /// Corbeille récupérable (soft-delete). NULL = actif. Un message supprimé
  /// depuis la console est masqué de TOUS les listings sauf l'onglet
  /// « Corbeille », d'où il peut être restauré (deletedAt→null) OU supprimé
  /// définitivement via l'effacement RGPD (eraseSubmissionAction, super_admin).
  deletedAt      DateTime?         @map("deleted_at")
  // Sprint Notif Infra 2026-05-26 / Chantier 3 — relation inverse Calendly.
  calendlyEvents CalendlyEvent[]

  @@index([type])
  @@index([status])
  @@index([locale])
  @@index([submittedAt])
  @@index([contactEmail])
  // Sprint Notif Infra 2026-05-26 — filtres inbox.
  @@index([needsAttention, archivedAt])
  @@index([lastRepliedAt])
  // Corbeille (2026-07-10) — masque les soft-deleted par défaut + onglet trash.
  @@index([deletedAt])
  @@map("submissions")
}

// ============================================================
// 1b. submission_replies (Sprint Notif Infra 2026-05-26 / Chantier 5)
// ============================================================
//
// Table dédiée : 1 Submission peut nécessiter plusieurs allers-retours
// (relance, complément d'info). Historique propre + multi-réponses +
// tracking delivery par message. Cf. ADR 0031 reply-system.

model SubmissionReply {
  id                String                @id @default(cuid())
  submissionId      String                @map("submission_id") @db.Uuid
  /// FK AdminUser (admin qui a envoyé). Nullable car onDelete=SetNull.
  repliedByUserId   String?               @map("replied_by_user_id") @db.Uuid
  /// Snapshot du nom au moment de l'envoi (immuable même si user supprimé).
  repliedByName     String                @map("replied_by_name") @db.VarChar(255)
  repliedAt         DateTime              @default(now()) @map("replied_at")
  /// Snapshot — au cas où Submission.contactEmail change après coup.
  toEmail           String                @map("to_email") @db.Citext
  subject           String                @db.VarChar(500)
  /// HTML rendu via template React Email (branded Axion-IA).
  bodyHtml          String                @map("body_html") @db.Text
  /// Version plain text (multipart MIME — auto-générée via @react-email/render).
  bodyText          String                @map("body_text") @db.Text
  deliveryStatus    SubmissionReplyStatus @default(pending) @map("delivery_status")
  /// Message-ID SMTP / id du provider (PowerMTA / Resend / etc.).
  providerMessageId String?               @map("provider_message_id") @db.VarChar(500)
  sentAt            DateTime?             @map("sent_at")
  failedAt          DateTime?             @map("failed_at")
  errorMsg          String?               @map("error_msg") @db.Text
  retryCount        Int                   @default(0) @map("retry_count")
  /// Ex "default" | "audit_followup" | "intervention_followup" | "custom".
  templateUsed      String?               @map("template_used") @db.VarChar(40)
  /// Note privée admin sur cette réponse (jamais envoyée au user).
  internalNote      String?               @map("internal_note") @db.Text

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  repliedByUser AdminUser? @relation(fields: [repliedByUserId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([deliveryStatus])
  @@index([repliedAt])
  @@map("submission_replies")
}

enum SubmissionReplyStatus {
  pending // en queue, pas encore envoyé
  sent // SMTP 250 OK reçu (envoi accepté par MTA)
  delivered // confirmation delivery via webhook bounce/delivery
  bounced // hard bounce reçu
  complained // spam complaint
  failed // erreur définitive (4xx persistant ou 5xx)

  @@map("submission_reply_status")
}

// ============================================================
// 1c. email_logs (Qualiopi T17 — traçabilité des envois d'emails)
// ============================================================
//
// Journal durable des envois via la queue `emails` (email-worker). La preuve
// d'envoi ne vivait qu'en Redis (BullMQ, purgé) → inauditable. Une ligne par
// tentative (chaque retry `failed` laisse sa trace). Migration ADDITIVE.

enum EmailLogStatus {
  pending
  sent
  failed

  @@map("email_log_status")
}

model EmailLog {
  id String @id @default(uuid()) @db.Uuid
  /// Nom du template = EmailJobName (ex. "qualiopi-convocation", "qualiopi-alerte-interne").
  template String @db.VarChar(60)
  /// Destinataire (snapshot plaintext, tel qu'enfilé dans le job BullMQ).
  recipient String @db.Citext
  locale Locale @default(fr)
  marketing Boolean @default(false)
  /// Entité liée (générique) : ex. "AlerteSysteme"/alerteId, "Enrollment"/enrollmentId.
  entityType String? @map("entity_type") @db.VarChar(80)
  entityId String? @map("entity_id") @db.VarChar(64)
  status EmailLogStatus @default(pending)
  /// jobId BullMQ (idempotence tracing — non unique car réutilisé sur idempotent jobIds).
  jobId String? @map("job_id") @db.VarChar(200)
  /// Message-ID SMTP retourné par nodemailer en cas de succès.
  providerMessageId String? @map("provider_message_id") @db.VarChar(500)
  attempts Int @default(0)
  error String? @db.Text
  sentAt DateTime? @map("sent_at")
  failedAt DateTime? @map("failed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([template])
  @@index([status])
  @@index([entityType, entityId])
  @@index([recipient])
  @@index([createdAt])
  @@map("email_logs")
}

// ============================================================
// 2. bookings
// ============================================================

model Booking {
  id                String           @id @default(uuid()) @db.Uuid
  /// Méta-cert 2026-05-15 — UUID v4 généré côté client au mount du formulaire,
  /// utilisé par `createBookingAction` pour neutraliser double-submits (OWASP A04).
  idempotencyKey    String?          @unique @map("idempotency_key") @db.VarChar(64)
  interventionType  InterventionType @map("intervention_type")
  bookingDate       DateTime         @map("booking_date")
  participantsCount Int              @map("participants_count")
  // Tarification (Sprint 14.10.x — pricing.ts SSOT) — V0 conservé compat,
  // Sprint X.1 ajoute snapshot `basePriceHtCents` + frais accessoires (cf. infra).
  participantsTier  String?          @map("participants_tier") @db.VarChar(40)
  pricePaidCents    Int?             @map("price_paid_cents")
  // Locale (langue formulaire)
  locale            Locale           @default(fr)
  // Liens existants
  submissionId      String?          @map("submission_id") @db.Uuid
  submission        Submission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  slotId            String?          @unique @map("slot_id") @db.Uuid
  slot              CalendarSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  // Formateur affecté à l'intervention (Phase 2 calendrier, 2026-06-10). Optionnel,
  // libre parmi les formateurs actifs. SetNull si le formateur est supprimé.
  formateurId       String?          @map("formateur_id") @db.Uuid
  formateur         Trainer?         @relation("BookingFormateur", fields: [formateurId], references: [id], onDelete: SetNull)
  // Calendrier externe (legacy Cal.com — peut rester null après migration calendrier maison)
  calendarEventId   String?          @map("calendar_event_id") @db.VarChar(255)
  status            BookingStatus    @default(pending)
  internalNotes     String?          @map("internal_notes") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // ============================================================
  // Sprint X.1 — Extensions Booking V1 (22 colonnes)
  // Source : `_AUDIT/BOOKING-DEPOSIT-ADMIN-2026-05-12/03-ARCHITECTURE-CIBLE.md` §5.1.3
  // ============================================================

  // --- Pricing snapshot (PricingConfig snapshot au moment de la pré-réservation)
  /// Sprint X.1 — base de calcul snapshot depuis `PricingConfig`.
  basePriceHtCents      Int?     @map("base_price_ht_cents")
  /// Sprint X.1 — frais déplacement (mode real_costs).
  travelFeeCents        Int      @default(0) @map("travel_fee_cents")
  accommodationFeeCents Int      @default(0) @map("accommodation_fee_cents")
  mealFeeCents          Int      @default(0) @map("meal_fee_cents")
  additionalFeesCents   Int      @default(0) @map("additional_fees_cents")
  additionalFeesNotes   String?  @map("additional_fees_notes") @db.Text
  /// Sprint X.1 — mode frais accessoires (snapshot depuis PricingConfig).
  feesMode              FeesMode @default(real_costs) @map("fees_mode")

  // --- Acompte + solde (deposit-validation-gated)
  /// Sprint X.1 — montant acompte attendu (snapshot depuis PricingConfig).
  depositAmountCents Int?      @map("deposit_amount_cents")
  depositPaidAt      DateTime? @map("deposit_paid_at")
  /// Sprint X.1 — montant solde attendu.
  balanceAmountCents Int?      @map("balance_amount_cents")
  balancePaidAt      DateTime? @map("balance_paid_at")

  // --- Devis / NDA / contrat
  /// Sprint X.1 — dérivé `PricingConfig.quoteRequired` (snapshot).
  quoteRequired Boolean @default(false) @map("quote_required")
  ndaRequired   Boolean @default(false) @map("nda_required")

  // --- Parcours d'origine (D44, parcours A/B)
  /// Sprint X.1 (D44) — parcours visiteur (direct calendrier / devis qualifié).
  originPath       BookingOriginPath @default(direct) @map("origin_path")
  /// Sprint X.1 (D44) — FK -> Submission (parcours B uniquement). NULL parcours A.
  fromSubmissionId String?           @map("from_submission_id") @db.Uuid
  fromSubmission   Submission?       @relation("BookingFromSubmission", fields: [fromSubmissionId], references: [id], onDelete: SetNull)

  // --- Liens optionnels vers entités V1
  /// Sprint X.1 — FK -> CadrageMeeting (1-1 logique, 1 cadrage par booking).
  cadrageMeetingId         String?                 @map("cadrage_meeting_id") @db.Uuid
  cadrageMeeting           CadrageMeeting?         @relation(fields: [cadrageMeetingId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> Quote actif (semi-auto Will-A).
  quoteId                  String?                 @map("quote_id") @db.Uuid
  quote                    Quote?                  @relation("BookingActiveQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> ContractDocument actif (DocuSeal V1).
  contractDocumentId       String?                 @map("contract_document_id") @db.Uuid
  contractDocument         ContractDocument?       @relation("BookingActiveContract", fields: [contractDocumentId], references: [id], onDelete: SetNull)
  /// Sprint X.1 — FK -> PaymentScheduleProfile (snapshot override possible).
  paymentScheduleProfileId String?                 @map("payment_schedule_profile_id") @db.Uuid
  paymentScheduleProfile   PaymentScheduleProfile? @relation(fields: [paymentScheduleProfileId], references: [id], onDelete: SetNull)

  // --- Géo-awareness (OSM Nominatim + buffer trajet, D24)
  /// Sprint X.1 — ville société normalisée pour géocodage.
  companyCityNormalized String?      @map("company_city_normalized") @db.VarChar(120)
  companyLat            Decimal?     @map("company_lat") @db.Decimal(9, 6)
  companyLng            Decimal?     @map("company_lng") @db.Decimal(9, 6)
  /// Sprint X.1 (D24) — buffer trajet auto (0/1/2 jours selon distance).
  travelBufferDays      Float        @default(0) @map("travel_buffer_days")
  /// Sprint X.1 — classification INSEE (snapshot depuis Submission.details).
  companySize           CompanySize? @map("company_size")

  // --- Sentinels cycle de vie
  confirmedAt        DateTime?           @map("confirmed_at")
  completedAt        DateTime?           @map("completed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason String?             @map("cancellation_reason") @db.VarChar(500)
  cancellationWindow CancellationWindow? @map("cancellation_window")
  cancelledByUserId  String?             @map("cancelled_by_user_id") @db.Uuid
  cancelledByUser    AdminUser?          @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  forceMajeureNotes  String?             @map("force_majeure_notes") @db.Text

  // --- Pause (D61)
  /// Sprint X.1 (D61) — sentinel activation pause + slot libéré pendant la pause.
  pausedAt    DateTime? @map("paused_at")
  pausedUntil DateTime? @map("paused_until")
  pauseReason String?   @map("pause_reason") @db.VarChar(500)

  // --- Overrides + V2 hooks
  /// Sprint X.1 (D64) — overrides JSON par booking (modes manuels togglables).
  overrides         Json?   @map("overrides")
  /// HOOK V2+ Qualiopi — pas de table V1, juste un champ FK nullable préparé.
  trainingSessionId String? @map("training_session_id") @db.Uuid

  // ============================================================
  // Sprint X.1 — relations inverses V1
  // ============================================================
  payments          Payment[]
  invoices          Invoice[]
  contractDocuments ContractDocument[]      @relation("BookingContractDocuments")
  quotes            Quote[]                 @relation("BookingQuotes")
  transitions       BookingTransition[]
  paymentSchedule   BookingPaymentSchedule?

  @@index([interventionType])
  @@index([bookingDate])
  @@index([status])
  @@index([locale])
  @@index([originPath])
  @@index([fromSubmissionId])
  @@index([companyCityNormalized])
  @@index([pausedUntil])
  @@index([cancellationWindow])
  @@index([formateurId])
  @@map("bookings")
}

// ============================================================
// 3. calendar_slots
// ============================================================

model CalendarSlot {
  id                String             @id @default(uuid()) @db.Uuid
  slotDate          DateTime           @map("slot_date") @db.Date
  status            CalendarSlotStatus @default(available)
  displaySector     String?            @map("display_sector") @db.VarChar(100)
  participantsCount Int?               @map("participants_count")
  interventionType  InterventionType?  @map("intervention_type")
  showPublicly      Boolean            @default(true) @map("show_publicly")
  blockedReason     String?            @map("blocked_reason") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  booking Booking?
  options BookingOption[]

  @@unique([slotDate])
  @@index([status])
  @@map("calendar_slots")
}

// ============================================================
// 4. bookings_options
// ============================================================

model BookingOption {
  id                String              @id @default(uuid()) @db.Uuid
  slotId            String              @map("slot_id") @db.Uuid
  slot              CalendarSlot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  // Société
  companyName       String              @map("company_name") @db.VarChar(255)
  companySector     String              @map("company_sector") @db.VarChar(100)
  participantsCount Int                 @map("participants_count")
  interventionType  InterventionType    @map("intervention_type")
  // Contact
  contactName       String              @map("contact_name") @db.VarChar(255)
  contactEmail      String              @map("contact_email") @db.Citext
  contactPhone      String              @map("contact_phone") @db.VarChar(30)
  // RGPD
  consentDisplay    Boolean             @default(false) @map("consent_display")
  // Lifecycle
  status            BookingOptionStatus @default(pending)
  expiresAt         DateTime            @map("expires_at")
  reminderSentAt    DateTime?           @map("reminder_sent_at")
  confirmedAt       DateTime?           @map("confirmed_at")
  notes             String?             @db.Text
  locale            Locale              @default(fr)

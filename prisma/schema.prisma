/// Country (PRÉREQUIS image-bank) — seedé depuis REST Countries API (~249 lignes).
/// Utilisé par image-country-detector.service.ts pour résoudre nom → ISO code.
model Country {
  isoCode   String   @id @map("iso_code") @db.VarChar(2)
  iso3      String?  @unique @db.VarChar(3)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  slugFr    String   @map("slug_fr") @db.VarChar(100)
  slugEn    String   @map("slug_en") @db.VarChar(100)
  continent String?  @db.VarChar(20)
  flagEmoji String?  @map("flag_emoji") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nameFr])
  @@index([nameEn])
  @@index([slugFr])
  @@index([slugEn])
  @@map("countries")
}

model ImageAsset {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  // File data
  filePath      String  @map("file_path") @db.VarChar(500)
  thumbnailPath String? @map("thumbnail_path") @db.VarChar(500)
  avifPath      String? @map("avif_path") @db.VarChar(500)
  lqipDataUri   String? @map("lqip_data_uri") @db.Text
  fileFormat    String  @default("webp") @map("file_format") @db.VarChar(10)
  fileSize      Int     @default(0) @map("file_size")
  width         Int
  height        Int
  orientation   String  @db.VarChar(20)
  aspectRatio   String? @map("aspect_ratio") @db.VarChar(10)
  srcset        String? @db.Text
  fileHash      String? @map("file_hash") @db.VarChar(64)

  // SEO core
  // Slug strategy (audit V1 verification 2026-05-16 P1-10) :
  //   - ImageAsset.slug    = identifiant CANONIQUE language-neutral (unique global),
  //                          dérivé du title FR à la création (slugifyAscii), sert
  //                          aux chemins fichier storage `image-bank/<id>/...`.
  //   - ImageAssetTranslation.slug = slug PER-LANG (unique via [imageId, languageCode]),
  //                                  sert au routing public `/galerie/<slug-fr>` ou
  //                                  `/gallery/<slug-en>`. Calculé par le worker
  //                                  translate (Claude Sonnet 4.6 vision) avec retour
  //                                  à slugifyAscii(title traduit) si null.
  slug              String  @unique @db.VarChar(255)
  keywordsPrimary   String? @map("keywords_primary") @db.VarChar(255)
  keywordsSecondary Json?   @map("keywords_secondary")
  seoScore          Int     @default(0) @map("seo_score") @db.SmallInt

  // Geo targeting (monde ISO, PAS regions.ts France)
  targetCountries Json?   @map("target_countries")
  targetLanguages Json?   @map("target_languages")
  geoRegion       String? @map("geo_region") @db.VarChar(10)
  geoPlacename    String? @map("geo_placename") @db.VarChar(255)
  geoPosition     String? @map("geo_position") @db.VarChar(50)

  // License (CC BY 4.0 par défaut)
  licenseType      String  @default("cc-by-4.0") @map("license_type") @db.VarChar(50)
  licenseUrl       String? @default("https://creativecommons.org/licenses/by/4.0/") @map("license_url") @db.VarChar(500)
  copyrightHolder  String  @default("Axion-IA OÜ") @map("copyright_holder") @db.VarChar(255)
  photographerName String? @map("photographer_name") @db.VarChar(255)
  photographerUrl  String? @map("photographer_url") @db.VarChar(500)

  // Source (origin tracking)
  sourceUrl  String? @map("source_url") @db.Text
  sourceType String  @default("photo") @map("source_type") @db.VarChar(20)
  aiModel    String? @map("ai_model") @db.VarChar(60)

  // Tracking
  viewCount     Int @default(0) @map("view_count")
  downloadCount Int @default(0) @map("download_count")
  embedCount    Int @default(0) @map("embed_count")

  // State
  isActive    Boolean   @default(true) @map("is_active")
  isFeatured  Boolean   @default(false) @map("is_featured")
  sortOrder   Int       @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at")

  // V1.1 — Taxonomie métier (SSOT @/server/image-bank/taxonomy.ts)
  module         String? @map("module") @db.VarChar(20)
  subModule      String? @map("sub_module") @db.VarChar(60)
  targetEntity   String? @map("target_entity") @db.VarChar(120)
  targetCity     String? @map("target_city") @db.VarChar(80)
  targetRegion   String? @map("target_region") @db.VarChar(60)
  targetSize     String? @map("target_size") @db.VarChar(20)
  targetPersona  String? @map("target_persona") @db.VarChar(40)
  targetSector   String? @map("target_sector") @db.VarChar(40)
  targetTechno   String? @map("target_techno") @db.VarChar(30)
  targetFormat   String? @map("target_format") @db.VarChar(20)
  targetDuration String? @map("target_duration") @db.VarChar(30)

  // V1.1 — Cross-référence page métier canonique
  subjectOfUrl  String? @map("subject_of_url") @db.VarChar(500)
  subjectOfType String? @map("subject_of_type") @db.VarChar(30)

  // V1.1 — Flags qualité + AI + watermark
  isAiGenerated         Boolean @default(false) @map("is_ai_generated")
  requiresHumanReview   Boolean @default(false) @map("requires_human_review")
  requiresHumanTaxonomy Boolean @default(false) @map("requires_human_taxonomy")
  watermarkEnabled      Boolean @default(false) @map("watermark_enabled")

  // V1.5 — pHash + custom XMP namespace
  pHash         String? @map("p_hash") @db.VarChar(32)
  customXmpData Json?   @map("custom_xmp_data")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     ImageCategory?          @relation(fields: [categoryId], references: [id])
  translations ImageAssetTranslation[]
  tags         ImageAssetTag[]
  usageLogs    ImageUsageLog[]
  downloadLogs ImageDownloadLog[]

  @@index([isActive, categoryId, sortOrder])
  @@index([isActive, publishedAt])
  @@index([sourceType])
  @@index([fileHash])
  @@index([module, subModule])
  @@index([module, targetCity])
  @@index([module, targetRegion])
  @@index([subjectOfType])
  @@index([requiresHumanReview])
  @@index([requiresHumanTaxonomy])
  @@index([pHash])
  @@map("image_assets")
}

model ImageAssetTranslation {
  id           Int    @id @default(autoincrement())
  imageId      String @map("image_id") @db.Uuid
  languageCode String @map("language_code") @db.VarChar(5)

  title       String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  alt         String  @db.VarChar(255)
  caption     String? @db.VarChar(500)
  description String? @db.Text

  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(255)
  ogTitle         String? @map("og_title") @db.VarChar(255)
  ogDescription   String? @map("og_description") @db.VarChar(255)

  aiSummary  String? @map("ai_summary") @db.Text
  embedTitle String? @map("embed_title") @db.VarChar(255)


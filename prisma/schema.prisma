// ============================================================
// Calendly events (Sprint Notif Infra 2026-05-26 / Chantier 3)
// ============================================================
//
// Persistance des réservations captées via le widget Calendly inline sur
// `/appel`. Mode Embed JS gratuit : on écoute postMessage iframe Calendly
// côté client + POST notre endpoint serveur. Capture les créations uniquement
// (limitation Calendly Free — pas de webhook officiel). Cf. ADR 0030.

model CalendlyEvent {
  id                 String              @id @default(cuid())
  /// Nom humain de l'event-type (ex "Appel découverte 30 min"). Will peut
  /// l'éditer manuellement après capture.
  eventTypeName      String              @map("event_type_name") @db.VarChar(255)
  /// Slug extrait de l'URL Calendly (ex "appel-decouverte"). Sert de
  /// référence stable pour matching.
  eventTypeSlug      String              @map("event_type_slug") @db.VarChar(100)
  status             CalendlyEventStatus @default(scheduled)
  /// Embed JS ne fournit pas tjrs précis — best effort, complétable manuel.
  startTime          DateTime?           @map("start_time")
  endTime            DateTime?           @map("end_time")
  timezone           String              @default("Europe/Paris") @db.VarChar(80)
  /// Extrait du payload Embed JS si dispo, sinon Will complète via admin.
  inviteeName        String?             @map("invitee_name") @db.VarChar(255)
  inviteeEmail       String?             @map("invitee_email") @db.Citext
  inviteePhone       String?             @map("invitee_phone") @db.VarChar(40)
  /// Sprint Notif Infra 2026-05-26 / fix P1-4 audit 2026-05-27 — lieu du
  /// RDV si fourni par Calendly (ex Google Meet URL, adresse physique). Si
  /// absent du payload Embed JS, reste null et Will complète manuellement.
  location           String?             @db.VarChar(500)
  source             CalendlyEventSource @default(embed_js)
  /// Payload complet du postMessage event (debug + future re-process).
  rawPayload         Json                @map("raw_payload")
  /// URL où l'event a été capté (ex "https://axion-ia.com/fr/appel").
  pageUrl            String?             @map("page_url") @db.VarChar(500)
  utmSource          String?             @map("utm_source") @db.VarChar(100)
  utmCampaign        String?             @map("utm_campaign") @db.VarChar(100)
  utmMedium          String?             @map("utm_medium") @db.VarChar(100)
  referrer           String?             @db.VarChar(500)
  /// Match manuel par Will via admin (lien vers une Submission existante).
  linkedSubmissionId String?             @map("linked_submission_id") @db.Uuid
  capturedAt         DateTime            @default(now()) @map("captured_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  /// Notes admin manuelles (debrief post-call, etc.).
  notes              String?             @db.Text

  linkedSubmission Submission? @relation(fields: [linkedSubmissionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startTime])
  @@index([inviteeEmail])
  @@index([capturedAt])
  @@index([linkedSubmissionId])
  @@map("calendly_events")
}

enum CalendlyEventStatus {
  scheduled // créé via Embed JS, par défaut
  canceled // marqué manuellement par Will (Calendly Free ne notifie pas)
  completed // marqué manuellement post-call
  no_show // marqué manuellement post-call

  @@map("calendly_event_status")
}

enum CalendlyEventSource {
  embed_js // capté via postMessage iframe Calendly (V1 par défaut)
  manual_import // ajouté manuellement par Will via admin
  webhook // réservé pour V2 future si upgrade Calendly Standard

  @@map("calendly_event_source")
}

// ============================================================
// SAUVEGARDES & DR (module admin /infra/backups) — ADR 0032
// Journal d'ops alimenté par scripts/backup-*.sh + restore-*-test*.sh
// (cron VPS + CI) via POST HMAC /api/internal/backups[/drills].
// Pas de FK : table autonome. cf. src/server/backups/**.
// ============================================================

/// Composant logique sauvegardé. Aligné sur le périmètre DR réel (ADR 0032).
enum BackupComponent {
  postgres // dump logique pg_dump
  postgres_pitr // WAL / pgBackRest
  redis // snapshot RDB
  files_image_bank // originaux + variants banque d'images
  docuseal // DB + PDF signés
  plausible_pg // Postgres interne Plausible
  plausible_clickhouse // events ClickHouse Plausible
  secrets // archive chiffrée age (.secrets + env Coolify)
  git_mirror // miroir repo off-GitHub

  @@map("backup_component")
}

/// Cadence / nature du run. Aligné sur BACKUP_TYPE des scripts.
enum BackupKind {
  daily
  weekly
  monthly
  pitr // full/diff pgBackRest
  manual // déclenché depuis l'admin

  @@map("backup_kind")
}

/// Issue d'un run de backup.
enum BackupStatus {
  success
  warning // terminé mais anomalie non bloquante
  failed
  running // run en cours
  skipped // composant volontairement désactivé

  @@map("backup_status")
}

/// Issue d'un test de restauration (drill).
enum RestoreDrillStatus {
  passed
  failed
  partial // restauré mais vérifications partielles
  running

  @@map("restore_drill_status")
}

/// Un run de sauvegarde d'un composant. Journal append-only (transition
/// running→final via idempotencyKey). Écrit par POST /api/internal/backups.
model BackupRun {
  id                  String          @id @default(cuid())
  component           BackupComponent
  kind                BackupKind
  status              BackupStatus
  startedAt           DateTime        @default(now())
  finishedAt          DateTime?
  durationSec         Int?
  sizeBytes           BigInt?
  checksum            String?         @db.VarChar(128)
  /// Destinations réussies (ex. ["r2","storagebox"]). Multi-dest (ADR 0022).
  destinations        String[]        @default([])
  remotePath          String?         @db.Text
  /// RPO cible du composant (minutes) au moment du run — enrichi serveur.
  rpoTargetMin        Int?
  /// Retard vs RPO en minutes (>0 = en retard) — enrichi serveur, pour le bandeau.
  ageVsRpoMin         Int?
  failReason          String?         @db.Text
  consecutiveFailures Int             @default(0)
  source              String          @default("cron_vps") @db.VarChar(32)
  idempotencyKey      String?         @db.VarChar(64)
  metadata            Json?
  createdAt           DateTime        @default(now())

  @@unique([idempotencyKey])
  @@index([component, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([kind, startedAt(sort: Desc)])
  @@map("backup_runs")
}

/// Un test de restauration (drill) d'un composant. Écrit par
/// restore-*-test*.sh + restore-drill-monthly.yml via /api/internal/backups/drills.
model RestoreDrill {
  id             String             @id @default(cuid())
  component      BackupComponent
  status         RestoreDrillStatus
  startedAt      DateTime           @default(now())
  finishedAt     DateTime?
  durationSec    Int?
  /// Backup testé (clé/filename distant). Indicatif.
  backupRef      String?            @db.Text
  /// Total rows vérifiées (sanity check).
  verifiedRows   BigInt?
  /// Détail des vérifs (counts par table critique). Shape libre.
  checks         Json?
  failReason     String?            @db.Text
  source         String             @default("cron_vps") @db.VarChar(32)
  idempotencyKey String?            @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@unique([idempotencyKey])
  @@index([component, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("restore_drills")
}

// ============================================================
// CHATBOT (ADR-CB-03, doc 03) — 8 tables chat_* cloisonnées.
// Migration core `chatbot_core` (T-01) : crée toutes les colonnes SAUF les
// colonnes pgvector / tsvector (`embedding`, `tsv`, `question_embedding`), qui
// sont ajoutées + indexées (HNSW + GIN) via `migrations_fts/*_chatbot_fts.sql`
// (T-02, appliqué par psql), exactement comme `knowledge_translations.search_vector`
// et `knowledge_embeddings.embedding`. Ces colonnes Unsupported sont déclarées
// ici (visibilité client + cohérence schéma) mais lues via $queryRaw (Prisma ne
// gère ni cosine ni tsvector dans son API de query).
// Multi-tenant : `tenant_id` sur toutes les tables (MVP : 1 tenant `axion-ia`).
// Flag global `CHATBOT_ENABLED=false` jusqu'à activation (D-PROD).
// ============================================================

/// Tenant chatbot (MVP : un seul « axion-ia » seedé ; conçu multi-tenant pour Ulixai).
model ChatTenant {
  id        String   @id @default(uuid()) @db.Uuid
  cle       String   @unique @db.VarChar(120) // clé transmise par le widget
  nom       String   @db.VarChar(200)
  domaine   String?  @db.VarChar(255) // CORS (ex. axion-ia.com)
  reglages  Json? // seuils, ton, budget, curseur conversion, palier LLM (D-LLM-TIER)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations  ChatConversation[]
  kbChunks       ChatKbChunk[]
  semanticCache  ChatSemanticCache[]
  promptVersions ChatPromptVersion[]
  escalations    ChatEscalation[]

  @@map("chat_tenants")
}

/// Chunks RAG vectorisés (amorcés depuis KnowledgeEntry/KbFact/FAQ/pages services).
/// `embedding vector(1024)` + `tsv tsvector` ajoutés via migrations_fts (T-02).
model ChatKbChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  tenantId   String                       @map("tenant_id") @db.Uuid
  tenant     ChatTenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType String                       @map("source_type") @db.VarChar(40) // knowledge_entry | kb_fact | faq | service_page | article
  sourceRef  String                       @map("source_ref") @db.VarChar(255) // id/slug de la source
  categorie  String                       @db.VarChar(60) // prestations|tarifs|faq|methodo|cas|...
  priorite   String                       @default("moyenne") @db.VarChar(20)
  contenu    String                       @db.Text
  contexte   String?                      @db.Text // phrase de contextualisation (cahier §9)
  // Colonnes ajoutées via migrations_fts (T-02), lues via $queryRaw :
  embedding  Unsupported("vector(1024)")?
  tsv        Unsupported("tsvector")?
  version    Int                          @default(1)
  actif      Boolean                      @default(true)
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  @@unique([tenantId, sourceType, sourceRef, version])
  @@index([tenantId, categorie])
  @@index([tenantId, actif])
  @@map("chat_kb_chunks")
}

/// Cache sémantique (ADR-CB-05) — `question_embedding vector(1024)` via migrations_fts (T-02).
model ChatSemanticCache {
  id                String                       @id @default(uuid()) @db.Uuid
  tenantId          String                       @map("tenant_id") @db.Uuid
  tenant            ChatTenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  question          String                       @db.Text
  questionEmbedding Unsupported("vector(1024)")? @map("question_embedding")
  reponse           String                       @db.Text
  sources           Json?
  valideJusqu       DateTime?                    @map("valide_jusqu")
  hits              Int                          @default(0)
  knowledgeVersion  Int                          @map("knowledge_version") // pour invalidation par version
  createdAt         DateTime                     @default(now()) @map("created_at")

  @@index([tenantId, knowledgeVersion])
  @@map("chat_semantic_cache")
}

/// Prompt système versionné + rollback (console admin, T-20).
model ChatPromptVersion {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    ChatTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contenu   String     @db.Text
  version   Int
  actif     Boolean    @default(false)
  note      String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([tenantId, version])
  @@index([tenantId, actif])
  @@map("chat_prompt_versions")
}

/// Conversation (état serveur, stateless). Champs MVP5 (T-38) `searchSlots`/
/// `proposedOffers`/`linkState` inclus dès T-01 (migration additive groupée).
model ChatConversation {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          ChatTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionUuid     String     @map("session_uuid") @db.Uuid
  persona         String?    @db.VarChar(60)
  statut          String     @default("active") @db.VarChar(20)
  pageContext     String?    @map("page_context") @db.Text // page d'origine (accueil proactif)
  submissionId    String?    @map("submission_id") @db.Uuid // lien lead capturé (Submission interne)
  resume          String?    @db.Text // contexte long résumé
  ipHash          String?    @map("ip_hash") @db.VarChar(64) // SHA-256 salée
  // MVP2 qualification non-intrusive (T-13, qualifier_prospect) — profil prospect :
  prospectProfile Json?      @map("prospect_profile") // type_structure/secteur/besoin/maturite_ia/urgence
  // MVP5 « cœur vendeur-conseiller » (T-38) — état de la boucle catalogue :
  searchSlots     Json?      @map("search_slots") // critères extraits (prix/durée/effectif/sujet/format/vertical)
  proposedOffers  Json?      @map("proposed_offers") // offres proposées au tour courant
  linkState       String?    @map("link_state") @db.VarChar(20) // null|proposed|confirmed|sent
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  messages    ChatMessage[]
  escalations ChatEscalation[]

  @@unique([sessionUuid])
  @@index([tenantId, statut])
  @@map("chat_conversations")
}

/// Message (persistance latence/modèle/coût/sources, T-07).
model ChatMessage {
  id              String           @id @default(uuid()) @db.Uuid
  conversationId  String           @map("conversation_id") @db.Uuid
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String           @db.VarChar(20) // user | assistant | system
  contenu         String           @db.Text
  sources         Json? // chunks cités
  toolCalls       Json?            @map("tool_calls")
  feedback        Int? // pouce +1/-1
  latenceMs       Int?             @map("latence_ms")
  modele          String?          @db.VarChar(80)
  coutEstime      Decimal?         @map("cout_estime") @db.Decimal(10, 5)
  servedFromCache Boolean          @default(false) @map("served_from_cache")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Escalade vers l'équipe (trou KB / score faible) — T-14.
model ChatEscalation {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         ChatTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String?           @map("conversation_id") @db.Uuid
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  question       String            @db.Text
  contexte       String?           @db.Text
  contactEmail   String?           @map("contact_email") @db.Citext
  statut         String            @default("ouverte") @db.VarChar(20)
  emailEnvoye    Boolean           @default(false) @map("email_envoye")
  submissionId   String?           @map("submission_id") @db.Uuid // si converti en lead
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([tenantId, statut])
  @@map("chat_escalations")
}

/// Idempotency des actions outillées (capturer_lead, T-17). cle = sha256(conversationId+outil+payload).
model ChatActionIdempotency {
  cle       String   @id @db.VarChar(64)
  resultat  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("chat_action_idempotency")
}

// ============================================================
// QUALIOPI / FORMATION ENGINE — T1 : référentiel offres_site
// Modèles additifs cloisonnés (skill axionia-qualiopi). Le prix N'est PAS
// stocké : il est dérivé de `src/content/pricing.ts` via `tierId` (SSOT).
// ============================================================

/// Catégorie de prestation rattachable au Formation Engine (v1 : intervention).
enum OffreCategorie {
  intervention
}

/// Format pédagogique d'une offre (dérive l'applicabilité des règles métier
/// du Formation Engine — effectif, durée, ratio pratique).
enum OffreFormatPedagogique {
  collectif_4h
  collectif_1jour
  collectif_2jours
  collectif_3jours
  conference
  dirigeant_1to1
  individuel
  sur_devis
}

/// Type d'affichage tarifaire (le montant lui-même vient de pricing.ts).
enum OffreTarifType {
  fixe
  a_partir_de
  sur_devis
}

/// Référentiel des offres publiques rattachables à une formation (PART5 A.1).
/// Le Formation Engine ne crée QUE des formations correspondant à une offre
/// active. Offres legacy : `tierId` lie au SSOT pricing.ts. Offres catalogue V2 :
/// `tierId` null, prix dérivé de `FORMATION_PRICE_MATRIX` via `gamme`+`dureeCode`.
model OffreSite {
  id                       String                 @id @default(uuid()) @db.Uuid
  /// Numérotation séquentielle officielle AXI-OFF-NNN.
  code                     String                 @unique @db.VarChar(40)
  /// Identifiant de tier pricing.ts (SSOT prix/durée legacy). Null pour le
  /// catalogue V2 (prix dérivé de la matrice via gamme+dureeCode).
  tierId                   String?                @unique @map("tier_id") @db.VarChar(80)
  /// Catalogue V2 — gamme ("ia-standard" | "agents-automatisations" | "claude").
  gamme                    String?                @db.VarChar(40)
  /// Catalogue V2 — code durée ("4h" | "1j" | "2j" | "3j").
  dureeCode                String?                @map("duree_code") @db.VarChar(8)
  titreFr                  String                 @map("titre_fr") @db.VarChar(200)
  /// Slug public (fiche `/formations/[slug]` Phase B).
  slug                     String                 @unique @db.VarChar(160)
  categorie                OffreCategorie         @default(intervention)
  formatPedagogique        OffreFormatPedagogique @map("format_pedagogique")
  publicViseFr             String                 @map("public_vise_fr") @db.Text
  dureeHeuresMin           Int                    @map("duree_heures_min")
  dureeHeuresMax           Int                    @map("duree_heures_max")
  /// Modalités possibles : presentiel | distanciel | hybride.
  modalites                String[]               @default([])
  tarifType                OffreTarifType         @map("tarif_type")
  promessePrincipaleFr     String                 @map("promesse_principale_fr") @db.Text
  nbModulesMin             Int                    @default(2) @map("nb_modules_min")
  nbModulesMax             Int                    @default(6) @map("nb_modules_max")
  /// Ratio pratique plancher (cf. SiteSetting qualiopi.ratio_pratique_min).
  ratioPratiqueMin         Float                  @default(0.6) @map("ratio_pratique_min")
  anglePedagogiqueFr       String                 @map("angle_pedagogique_fr") @db.VarChar(300)
  actif                    Boolean                @default(true)
  /// Dernière vérification de cohérence offre ↔ pricing.ts (alerte si > 30 j).
  derniereVerifCoherenceAt DateTime?              @map("derniere_verif_coherence_at")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  formations Formation[]

  @@index([categorie])
  @@index([actif])
  @@index([gamme])
  @@map("offres_site")
}

// ============================================================
// QUALIOPI — T2 : CRM clients + devis (stade prospect)
// Modèles dédiés (avant Booking). Le pont vers Quote/ContractDocument/Booking
// se fait à l'acceptation du devis (T7 convention). Prix devis = montants
// snapshot (négociés) ; les tarifs catalogue restent dans pricing.ts.
// ============================================================

/// Cycle de vie commercial d'un client.
enum ClientStatut {
  prospect
  devis_envoye
  client_actif
  client_inactif
  perdu
}

/// Type de client : entreprise (B2B) ou particulier (B2C, ex. CPF perso). [R-B2C]
enum ClientType {
  entreprise
  particulier
}

/// Activité facturée — transversale aux 5 métiers d'Axion-IA. Pré-remplit le
/// régime TVA et les mentions du document (formation/un_a_un exonérables
/// 261-4-4° CGI si attestation ; audit/implementation/site_web = taxables 20 %).
enum ActiviteFacturation {
  formation
  un_a_un
  audit
  implementation
  site_web
}

/// Statut d'un devis (CRM, distinct de QuoteStatus lié au Booking).
enum DevisStatut {
  brouillon
  envoye
  accepte
  refuse
  expire
  transforme_convention
}

/// Client / prospect CRM. NAF → OPCO inféré (cf. crm/naf-opco.ts).
model Client {
  id                         String       @id @default(uuid()) @db.Uuid
  /// Numérotation séquentielle AXI-CLI-NNN.
  numero                     String       @unique @db.VarChar(40)
  /// entreprise (B2B) | particulier (B2C). Pour un particulier, raisonSociale = "Prénom Nom".
  type                       ClientType   @default(entreprise)
  raisonSociale              String       @map("raison_sociale") @db.VarChar(250)
  siret                      String?      @db.VarChar(14)
  /// SIREN (9 chiffres) — clé de routage annuaire facturation électronique 2026.
  siren                      String?      @db.VarChar(9)
  /// N° TVA intracommunautaire du client (B2B, EN 16931 BT-48).
  tvaIntracom                String?      @map("tva_intracom") @db.VarChar(40)
  nafCode                    String?      @map("naf_code") @db.VarChar(6)
  conventionCollective       String?      @map("convention_collective") @db.VarChar(200)
  /// Code IDCC de la branche (précise la convention collective — saisi, NAF non fiable). [T18]
  idcc                       String?      @db.VarChar(10)
  secteur                    String?      @db.VarChar(200)
  taille                     CompanySize?
  adresse                    String?      @db.Text
  /// Adresse structurée (EN 16931 BG-8) — remplace progressivement `adresse`
  /// (champ libre conservé en repli d'affichage).
  adresseRue                 String?      @map("adresse_rue") @db.VarChar(300)
  adresseCodePostal          String?      @map("adresse_code_postal") @db.VarChar(12)
  adresseVille               String?      @map("adresse_ville") @db.VarChar(120)
  adressePaysCode            String?      @map("adresse_pays_code") @db.VarChar(2)
  /// Entité du secteur public (mairie, université, collectivité…) → factures à
  /// déposer sur Chorus Pro (obligation en vigueur, distincte de la réforme 2026).
  estPublic                  Boolean      @default(false) @map("est_public")
  contactNom                 String?      @map("contact_nom") @db.VarChar(200)
  contactEmail               String?      @map("contact_email") @db.Citext
  contactTelephone           String?      @map("contact_telephone") @db.VarChar(40)
  contactFonction            String?      @map("contact_fonction") @db.VarChar(150)
  /// OPCO inféré depuis le code NAF (ou saisi manuellement).
  opcoIdentifie              String?      @map("opco_identifie") @db.VarChar(60)
  opcoNumeroAdherent         String?      @map("opco_numero_adherent") @db.VarChar(80)
  opcoEnveloppeAnnuelleCents Int?         @map("opco_enveloppe_annuelle_cents")
  statut                     ClientStatut @default(prospect)
  source                     String?      @db.VarChar(120)
  /// Contexte injecté au Formation Engine pour la génération sur-mesure.
  contexteIa                 String?      @map("contexte_ia") @db.Text
  besoinsIdentifies          Json?        @map("besoins_identifies")
  notes                      String?      @db.Text
  /// Agrégats commerciaux (mis à jour à la clôture des sessions).
  nbSessions                 Int          @default(0) @map("nb_sessions")
  nbStagiaires               Int          @default(0) @map("nb_stagiaires")
  caCents                    Int          @default(0) @map("ca_cents")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  devis               Devis[]
  formations          Formation[]
  sessions            TrainingSession[]
  documents           DocumentGenere[]
  enrollmentsFinances Enrollment[]       @relation("EnrollmentClient")
  coachingContracts   CoachingContract[]
  auditMissions       AuditMission[]
  facturesFormation   FactureFormation[]
  dossiersFinancement DossierFinancement[]
  plansRecurrents     PlanRecurrent[]

  @@index([statut])
  @@index([nafCode])
  @@index([opcoIdentifie])
  @@map("clients")
}

/// Devis commercial (CRM). Lignes snapshot ; pas de prix catalogue dupliqué.
model Devis {
  id                     String      @id @default(uuid()) @db.Uuid
  /// Numérotation séquentielle AXI-DEV-YYYY-NNN.
  numero                 String      @unique @db.VarChar(40)
  /// Activité facturée (sélecteur du Hub — pré-remplit régime TVA + mentions).
  activite               ActiviteFacturation?
  /// Référence client / n° de bon de commande (exigé par ETI, grands comptes, OPCO).
  refClient              String?     @map("ref_client") @db.VarChar(120)
  /// Révision : ce devis remplace une version antérieure (v2 → v1). L'ancienne
  /// version passe `expire` à l'envoi de la nouvelle — jamais d'écrasement.
  replacesDevisId        String?     @map("replaces_devis_id") @db.Uuid
  replacesDevis          Devis?      @relation("DevisRevision", fields: [replacesDevisId], references: [id], onDelete: SetNull)
  revisions              Devis[]     @relation("DevisRevision")
  /// Soumission DocuSeal « bon pour accord » (signature électronique du devis).
  docusealSubmissionId   String?     @map("docuseal_submission_id") @db.VarChar(120)
  /// URL de signature DocuSeal du client (embed_src du 1er signataire) —
  /// envoyée au client dans l'email pour qu'il signe en ligne.
  docusealEmbedUrl       String?     @map("docuseal_embed_url") @db.Text
  clientId               String      @map("client_id") @db.Uuid
  client                 Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Lignes : [{ designation, quantite, prixUnitaireHtCents, offreTierId? }].
  lignes                 Json
  montantTotalHtCents    Int         @map("montant_total_ht_cents")
  /// Mention TVA (exonération 261-4-4° CGI par défaut).
  mentionTva             String      @map("mention_tva") @db.Text
  /// direct | opco | cpf | france_travail.
  financementSuggere     String?     @map("financement_suggere") @db.VarChar(40)
  montantOpcoEstimeCents Int?        @map("montant_opco_estime_cents")
  resteAChargeCents      Int?        @map("reste_a_charge_cents")
  statut                 DevisStatut @default(brouillon)
  /// = createdAt + 30 j par défaut.
  dateValidite           DateTime    @map("date_validite")
  fichierPdfUrl          String?     @map("fichier_pdf_url") @db.Text
  sentAt                 DateTime?   @map("sent_at")
  acceptedAt             DateTime?   @map("accepted_at")
  declinedAt             DateTime?   @map("declined_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  sessions            TrainingSession[]
  auditMissions       AuditMission[]
  facturesFormation   FactureFormation[]
  dossiersFinancement DossierFinancement[]
  relancesProposees   RelanceProposee[]

  @@index([clientId])
  @@index([statut])
  @@map("devis")
}

// ============================================================
// QUALIOPI — T3 : modèles cœur (Formation, Session, Trainer, Trainee,
// Enrollment) + machine à états session. Modèles additifs (nouvelles tables).
// Lien Booking = scalaire `trainingSessionId` existant (lien logique, pas de
// FK ajoutée → table bookings intacte). PII handicap chiffrée via pii-crypto.
// ============================================================

enum FormationStatutGeneration {
  intention
  structure_generee
  contenu_evalue
  structure_validee
  contenu_genere
  contenu_valide
  assemble
  publie
  archive
}

enum FormationStatut {
  actif
  publie
  archive
}

enum TrainingSessionStatut {
  planifiee
  en_cours
  realisee
  annulee
  reportee
}

enum EnrollmentStatut {
  planifiee
  presente
  abandon
  exclu
}

/// Types d'action Qualiopi (multi-valeur). Pilote l'applicabilité des
/// indicateurs conditionnels + lecture miroir CPF V9.
enum TypeActionQualiopi {
  classique
  certifiante
  foad
  alternance_afest
  sous_traitance
  cpf
  opco
  france_travail
  handicap
}

enum TrainerStatut {
  salarie
  sous_traitant
  // Dirigeant-formateur : l'OF lui-même anime des formations. Ni salarié (pas de
  // contrat de travail), ni sous-traitant (pas de vigilance URSSAF/RC pro). Compétences
  // justifiées par CV + diplômes (ind. 21). Compté « interne » au BPF, comme un salarié.
  dirigeant
}

/// Pièces justificatives REÇUES d'un formateur (à ne pas confondre avec
/// `DocumentGenere`, les PDF produits par l'OF). Les pièces requises dépendent
/// du statut : un salarié fournit un contrat de travail, un indépendant une
/// attestation de vigilance URSSAF, un NDA, une RC pro…
enum TrainerDocumentType {
  // ── Salarié ──
  contrat_travail
  dpae
  // ── Indépendant / sous-traitant ──
  /// Art. L.8222-1 : à collecter dès 5 000 € HT de contrat, renouvelée tous les
  /// 6 mois. Sans elle, l'OF est SOLIDAIREMENT responsable des cotisations
  /// impayées du prestataire.
  attestation_vigilance_urssaf
  kbis_avis_sirene
  nda_sous_traitant
  attestation_qualiopi
  assurance_rc_pro
  contrat_sous_traitance
  // ── Communs ──
  cv
  diplome
  certification
  autre
}

/// Cycle de validation d'une pièce. L'expiration n'est PAS un statut : elle se
/// déduit de `dateExpiration`, sinon une pièce validée resterait « valide »
/// après sa péremption.
enum DocumentValidationStatut {
  en_attente
  valide
  rejete
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMISSIONNEMENT DES FORMATEURS (pilier C)
//
// Moteur de calcul (pur, testé) : `src/server/qualiopi/remuneration/calcul.ts`.
// Ces modèles ne font que PERSISTER ce qu'il produit.
// ─────────────────────────────────────────────────────────────────────────────

/// Modèle de rémunération d'une prestation.
enum CompensationModel {
  taux_journalier
  taux_horaire
  commission_ca_pct
  forfait_prestation
}

/// Type de prestation rémunérée.
enum PrestationType {
  formation_collective
  coaching_1to1
  audit
}

/// Nature COMPTABLE de la ligne. Découle du STATUT du formateur, pas du modèle
/// de rémunération :
///   - `analytique`   : salarié — valorisation indicative du coût-formateur. Le
///     salaire réel est en paie externe. JAMAIS « à payer », jamais au BPF.
///   - `honoraire_du` : indépendant — honoraires réellement dus, à facturer par
///     lui, à payer par l'OF, et à porter en charges du BPF.
/// Snapshotée sur la ligne : changer le statut du formateur ne reclasse pas le passé.
enum FeeLineNature {
  analytique
  honoraire_du
}

enum FeeLineStatut {
  /// Prestation pas encore réalisée : montant estimé, non engageant.
  previsionnel
  /// Prestation réalisée : montant calculé.
  calcule
  /// Figé dans un relevé validé. Ne se recalcule plus (correction = ligne d'ajustement).
  valide
  /// Prestation annulée/reportée, ou ligne écartée.
  annule
}

enum StatementStatut {
  brouillon
  a_valider
  valide
  /// Facture d'honoraires reçue du formateur. Gate DUR avant paiement.
  facture_recue
  paye
  annule
}

/// Régime de TVA des HONORAIRES d'un indépendant. Dépend du régime fiscal DU
/// FORMATEUR (celui qui facture), PAS de l'OF ni du financeur. `franchise_293b`
/// et `exonere_formation` donnent tous deux 0 %, mais sur des bases légales
/// DIFFÉRENTES — ne pas les confondre.
enum TvaRegimeHonoraires {
  franchise_293b
  exonere_formation
  assujetti_20
}

/// Une VERSION de barème d'un formateur. On ne mute JAMAIS une règle en vigueur :
/// on la clôt (`effectiveTo`) et on en crée une nouvelle. `effectiveFrom` inclus,
/// `effectiveTo` exclu. C'est ce qui garantit l'invariant comptable : changer un
/// taux en septembre ne recalcule jamais les sessions de juin.
model TrainerCompensationRule {
  id                 String            @id @default(uuid()) @db.Uuid
  trainerId          String            @map("trainer_id") @db.Uuid
  trainer            Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  /// Null = barème global du formateur (tous types de prestation).
  prestationType     PrestationType?   @map("prestation_type")
  /// Null = tous les slugs. Sinon cible fine (ex. un coaching précis).
  interventionSlug   String?           @map("intervention_slug") @db.VarChar(80)
  model              CompensationModel
  tauxJourneeHtCents Int?              @map("taux_journee_ht_cents")
  tauxHoraireHtCents Int?              @map("taux_horaire_ht_cents")
  /// Pourcentage du CA HT (ex. 40.00). Decimal : jamais de flottant sur de l'argent.
  commissionPct      Decimal?          @map("commission_pct") @db.Decimal(5, 2)
  forfaitHtCents     Int?              @map("forfait_ht_cents")
  effectiveFrom      DateTime          @map("effective_from")
  /// Null = en vigueur.
  effectiveTo        DateTime?         @map("effective_to")
  note               String?           @db.Text
  createdById        String?           @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")

  feeLines TrainerFeeLine[]

  @@index([trainerId, prestationType, effectiveFrom])
  @@index([trainerId, interventionSlug])
  @@index([effectiveTo])
  @@map("trainer_compensation_rules")
}

/// Ligne de rémunération d'un formateur pour UNE prestation. Colonne vertébrale
/// monétaire, commune aux trois types de prestation. Le barème résolu y est
/// SNAPSHOTÉ : le passé est figé par la copie, pas par une relecture.
model TrainerFeeLine {
  id                String         @id @default(uuid()) @db.Uuid
  trainerId         String         @map("trainer_id") @db.Uuid
  trainer           Trainer        @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  prestationType    PrestationType @map("prestation_type")
  /// Rattachement souple : exactement une de ces références est renseignée.
  sessionId         String?        @map("session_id") @db.Uuid
  coachingSessionId String?        @map("coaching_session_id") @db.Uuid
  bookingId         String?        @map("booking_id") @db.Uuid
  auditMissionId    String?        @map("audit_mission_id") @db.Uuid
  auditMission      AuditMission?  @relation(fields: [auditMissionId], references: [id], onDelete: SetNull)

  ruleId String?                  @map("rule_id") @db.Uuid
  rule   TrainerCompensationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  // ── Snapshot du barème résolu (fige le passé) ──
  model                 CompensationModel
  nature                FeeLineNature
  tauxSnapshotCents     Int?              @map("taux_snapshot_cents")
  commissionPctSnapshot Decimal?          @map("commission_pct_snapshot") @db.Decimal(5, 2)

  // ── Base de calcul figée ──
  heures      Decimal? @db.Decimal(6, 2)
  nbJours     Decimal? @map("nb_jours") @db.Decimal(6, 2)
  caBaseCents Int?     @map("ca_base_cents")

  /// Le DÛ (ou la valorisation analytique si `nature = analytique`).
  montantHtCents Int           @default(0) @map("montant_ht_cents")
  statut         FeeLineStatut @default(previsionnel)
  motif          String?       @db.Text

  /// Période de rattachement (mois de réalisation) — pilote le relevé mensuel.
  periodeYear  Int @map("periode_year")
  periodeMonth Int @map("periode_month")

  statementId String?           @map("statement_id") @db.Uuid
  statement   TrainerStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  calculatedAt DateTime? @map("calculated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([trainerId, periodeYear, periodeMonth])
  @@index([statut])
  @@index([statementId])
  @@index([sessionId])
  @@index([coachingSessionId])
  @@index([bookingId])
  @@index([auditMissionId])
  @@index([prestationType, periodeYear, periodeMonth])
  @@map("trainer_fee_lines")
}

/// Relevé mensuel d'honoraires d'un INDÉPENDANT (jamais émis pour un salarié).
/// Garde dure : on ne passe à `paye` qu'après réception d'une facture conforme.
/// Le relevé est un PRÉ-DÉCOMPTE interne, pas une auto-facture.
model TrainerStatement {
  id           String          @id @default(uuid()) @db.Uuid
  trainerId    String          @map("trainer_id") @db.Uuid
  trainer      Trainer         @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  periodeYear  Int             @map("periode_year")
  periodeMonth Int             @map("periode_month")
  statut       StatementStatut @default(brouillon)

  totalHtCents  Int                 @default(0) @map("total_ht_cents")
  /// Snapshot du régime TVA du formateur au moment de la validation.
  tvaRegime     TvaRegimeHonoraires @map("tva_regime")
  tvaCents      Int                 @default(0) @map("tva_cents")
  totalTtcCents Int                 @default(0) @map("total_ttc_cents")

  // ── Rapprochement avec la facture d'honoraires REÇUE du formateur ──
  numeroFacture          String?   @map("numero_facture") @db.VarChar(60)
  dateFacture            DateTime? @map("date_facture")
  montantFactureTtcCents Int?      @map("montant_facture_ttc_cents")
  factureUrl             String?   @map("facture_url") @db.Text
  echeanceAt             DateTime? @map("echeance_at")

  // ── Paiement ──
  payeAt            DateTime? @map("paye_at")
  moyenPaiement     String?   @map("moyen_paiement") @db.VarChar(30)
  referenceVirement String?   @map("reference_virement") @db.VarChar(80)

  validatedById String?  @map("validated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  feeLines TrainerFeeLine[]

  @@unique([trainerId, periodeYear, periodeMonth], map: "statement_unique_trainer_periode")
  @@index([statut])
  @@index([echeanceAt])
  @@map("trainer_statements")
}

/// Pièce justificative d'un formateur. Alimente les contrôles de conformité
/// (Qualiopi off.21/27, obligation de vigilance URSSAF) et les alertes
/// d'expiration.
model TrainerDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  trainerId        String                   @map("trainer_id") @db.Uuid
  trainer          Trainer                  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  type             TrainerDocumentType
  /// N° de la pièce (n° NDA, n° de police RC pro, code de vérification URSSAF…).
  numeroPiece      String?                  @map("numero_piece") @db.VarChar(60)
  fichierUrl       String?                  @map("fichier_url") @db.Text
  hashSha256       String?                  @map("hash_sha256") @db.VarChar(64)
  dateEmission     DateTime?                @map("date_emission")
  /// Null = pièce sans échéance (un diplôme). Sinon pilote les alertes.
  dateExpiration   DateTime?                @map("date_expiration")
  statutValidation DocumentValidationStatut @default(en_attente) @map("statut_validation")
  valideParUserId  String?                  @map("valide_par_user_id") @db.Uuid
  valideAt         DateTime?                @map("valide_at")
  rejetMotif       String?                  @map("rejet_motif") @db.Text
  notes            String?                  @db.Text
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([trainerId])
  @@index([type])
  @@index([statutValidation])
  @@index([dateExpiration])
  @@map("trainer_documents")
}

enum ModaliteFormation {
  presentiel
  distanciel
  hybride
}

/// Lieu PHYSIQUE d'une prestation. Complète (sans remplacer) `modalite` : une
/// session `presentiel` peut se tenir chez le client (`sur_site`) ou dans nos
/// locaux (`nos_locaux`). Requis pour la convention L.6353-1 et la convocation
/// (Qualiopi off.9 — information sur les conditions de déroulement).
enum LieuType {
  sur_site
  nos_locaux
  distanciel
}

/// Niveau visé des participants — pilote la profondeur/registre du contenu généré.
enum NiveauFormation {
  debutant
  intermediaire
  avance
  tous_niveaux
}

enum CertificationType {
  aucune
  rs
  rncp
}

enum FinancementType {
  direct
  opco
  cpf
  france_travail
  mixte
}

enum OpcoStatut {
  non_demande
  demande_en_cours
  accord_recu
  refuse
  paiement_recu
}

/// Formation (pivot Module A↔B). Sélectionnable pour une session UNIQUEMENT si
/// statutGeneration='publie' ET statut='actif'. Contenu IA marqué (AI Act 50).
model Formation {
  id                       String                    @id @default(uuid()) @db.Uuid
  numero                   String                    @unique @db.VarChar(40)
  titre                    String                    @db.VarChar(255)
  slug                     String                    @unique @db.VarChar(180)
  /// Offre rattachée (OBLIGATOIRE — pas de formation hors catalogue).
  offreSiteId              String                    @map("offre_site_id") @db.Uuid
  offreSite                OffreSite                 @relation(fields: [offreSiteId], references: [id], onDelete: Restrict)
  /// Client si formation sur-mesure.
  clientId                 String?                   @map("client_id") @db.Uuid
  client                   Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  estSurMesure             Boolean                   @default(false) @map("est_sur_mesure")
  dureeHeures              Int                       @map("duree_heures")
  modalite                 ModaliteFormation         @default(presentiel)
  /// [{ id, verbe, description, niveauBloom }] — verbes d'action (indicateur 5).
  objectifsPedagogiques    Json                      @default("[]") @map("objectifs_pedagogiques")
  /// [{ moduleId, titre, dureeMin, sequences:[...] }].
  programmeDetaille        Json                      @default("[]") @map("programme_detaille")
  supports                 SupportFormation[]
  methodesPedagogiques     String                    @default("") @map("methodes_pedagogiques") @db.Text
  /// Moyens techniques mis à disposition (off.17/21 : salle, plateforme, matériel). [T11]
  moyensTechniques         String                    @default("") @map("moyens_techniques") @db.Text
  /// Ressources pédagogiques fournies (off.17/22) : [{ type, libelle }]. [T11]
  ressourcesPedagogiques   Json                      @default("[]") @map("ressources_pedagogiques")
  /// Indicateurs de résultats publiés (off.2) : [{ libelle, valeur, unite, annee }]. [T17]
  indicateursPublies       Json                      @default("[]") @map("indicateurs_publies")
  /// Méthode de calcul affichée des indicateurs publiés (off.2). [T17]
  methodeCalculIndicateurs String                    @default("") @map("methode_calcul_indicateurs") @db.Text
  /// Date de publication/mise à jour des indicateurs (off.2). [T17]
  indicateursPubliesAt     DateTime?                 @map("indicateurs_publies_at")
  seuilReussitePct         Int                       @default(70) @map("seuil_reussite_pct")
  ratioPratiquePct         Int?                      @map("ratio_pratique_pct")
  // ── Paramètres pédagogiques enrichissant la génération IA (chantier Excellence) ──
  /// Niveau visé des participants — calibre profondeur/vocabulaire/difficulté.
  niveau                   NiveauFormation           @default(tous_niveaux)
  /// Prérequis explicites (ce que le stagiaire doit déjà savoir/avoir). Vide = aucun.
  prerequis                String                    @default("") @map("prerequis") @db.Text
  /// Secteur / métier cible (ex. « cabinet d'avocats ») — ancre les exemples générés.
  secteurCible             String                    @default("") @map("secteur_cible") @db.VarChar(200)
  /// Outils/logiciels réellement utilisés par le client (ex. « Microsoft 365 + Salesforce »).
  outilsClient             String                    @default("") @map("outils_client") @db.Text
  accessibleHandicap       Boolean                   @default(false) @map("accessible_handicap")
  certificationType        CertificationType         @default(aucune) @map("certification_type")
  codeCpf                  String?                   @map("code_cpf") @db.VarChar(20)
  // ── Certification France Compétences (RS / RNCP) — finançabilité CPF. [T18] ──
  /// Code RNCP (Répertoire National des Certifications Professionnelles).
  codeRncp                 String?                   @map("code_rncp") @db.VarChar(20)
  /// Code RS (Répertoire Spécifique — compétences ciblées).
  codeRs                   String?                   @map("code_rs") @db.VarChar(20)
  /// N° d'enregistrement France Compétences.
  numeroEnregistrementFc   String?                   @map("numero_enregistrement_fc") @db.VarChar(40)
  /// Nom du certificateur (déposant France Compétences).
  certificateurNom         String?                   @map("certificateur_nom") @db.VarChar(250)
  /// True si Axion-IA est le certificateur (déposant) ; false si partenaire habilité.
  estCertificateur         Boolean                   @default(false) @map("est_certificateur")
  /// N° d'habilitation si Axion-IA est partenaire d'un certificateur tiers.
  numeroHabilitation       String?                   @map("numero_habilitation") @db.VarChar(60)
  dateEnregistrementCertif DateTime?                 @map("date_enregistrement_certif")
  dateEcheanceCertif       DateTime?                 @map("date_echeance_certif")
  /// Blocs de compétences (RNCP) : [{ code, libelle }].
  blocsCompetences         Json                      @default("[]") @map("blocs_competences")
  /// Éligible CPF (dérivé : certifiante RS/RNCP ou bloc + EDOF vérifié).
  cpfEligible              Boolean                   @default(false) @map("cpf_eligible")
  edofVerifieAt            DateTime?                 @map("edof_verifie_at")
  edofVerifiePar           String?                   @map("edof_verifie_par") @db.Uuid
  statutGeneration         FormationStatutGeneration @default(intention) @map("statut_generation")
  statut                   FormationStatut           @default(actif)
  versionProgramme         String                    @default("1.0") @map("version_programme")
  versionHistorique        Json                      @default("[]") @map("version_historique")
  langueGeneration         String                    @default("fr") @map("langue_generation")
  typesActionQualiopi      TypeActionQualiopi[]      @default([]) @map("types_action_qualiopi")
  /// AI Act art. 50 (ADR 0024) — traçabilité + validation humaine bloquante.
  aiGenerated              Boolean                   @default(false) @map("ai_generated")
  aiModel                  String?                   @map("ai_model") @db.VarChar(80)
  aiPromptVersion          Int?                      @map("ai_prompt_version")
  validatedBy              String?                   @map("validated_by") @db.Uuid
  validatedAt              DateTime?                 @map("validated_at")
  /// Prix négocié optionnel (sinon dérivé offre/pricing.ts).
  tarifHtCents             Int?                      @map("tarif_ht_cents")
  // ── Réconciliation catalogue → DB (WS2) — Formation auto-syncée depuis ──
  //    catalog-v2.ts (SSOT public). Snapshot 3-way pour ne jamais clobber une
  //    édition admin : valeurs catalogue à la dernière synchro réussie.
  /// Valeurs catalogue (7 champs) à la dernière synchro — baseline du merge 3-way.
  catalogSnapshot          Json?                     @map("catalog_snapshot")
  /// Dernière synchro catalogue→DB réussie (champs alignés sur le catalogue).
  catalogSyncedAt          DateTime?                 @map("catalog_synced_at")
  /// Dernier écart non résolu (édition admin ≠ catalogue qui a bougé) → revue.
  catalogDriftAt           DateTime?                 @map("catalog_drift_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  sessions        TrainingSession[]
  fileValidations FileValidation[]
  generationJobs  FormationGenerationJob[]
  documents       DocumentGenere[]
  habilitations   TrainerHabilitation[]

  @@index([offreSiteId])
  @@index([clientId])
  @@index([statut])
  @@index([statutGeneration])
  @@index([certificationType])
  @@map("formations")
}

/// Session de formation (machine à états planifiee→en_cours→realisee).
model TrainingSession {
  id                                 String                   @id @default(uuid()) @db.Uuid
  numero                             String                   @unique @db.VarChar(40)
  titreSession                       String                   @map("titre_session") @db.VarChar(300)
  formationId                        String                   @map("formation_id") @db.Uuid
  formation                          Formation                @relation(fields: [formationId], references: [id], onDelete: Restrict)
  dateDebut                          DateTime                 @map("date_debut")
  dateFin                            DateTime                 @map("date_fin")
  dureeReelleHeures                  Int?                     @map("duree_reelle_heures")
  modalite                           ModaliteFormation
  // ── Lieu de déroulement (Qualiopi off.9 + convention L.6353-1). Tout additif :
  // null = session legacy, les documents retombent sur `modalite` seule. ──────
  lieuType                           LieuType?                @map("lieu_type")
  /// Intitulé libre du lieu (ex. « Siège du client », « Salle Fraunces »).
  lieuIntitule                       String?                  @map("lieu_intitule") @db.VarChar(200)
  lieuAdresse                        String?                  @map("lieu_adresse") @db.Text
  lieuCodePostal                     String?                  @map("lieu_code_postal") @db.VarChar(10)
  lieuVille                          String?                  @map("lieu_ville") @db.VarChar(120)
  lieuSalle                          String?                  @map("lieu_salle") @db.VarChar(120)
  /// URL de visioconférence (lieu de déroulement en distanciel).
  lieuVisioUrl                       String?                  @map("lieu_visio_url") @db.Text
  icalUid                            String?                  @map("ical_uid") @db.VarChar(255)
  clientId                           String?                  @map("client_id") @db.Uuid
  client                             Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  devisId                            String?                  @map("devis_id") @db.Uuid
  devis                              Devis?                   @relation(fields: [devisId], references: [id], onDelete: SetNull)
  financementType                    FinancementType?         @map("financement_type")
  montantHtCents                     Int                      @map("montant_ht_cents")
  /// Snapshot légal (WS5) — copie figée des champs Formation engageants (titre,
  /// durée, objectifs, programme…) à la création de la session. Les documents
  /// légaux (convention, attestation, facture) le lisent en priorité pour ne pas
  /// diverger si la formation évolue après coup. Null = session legacy → fallback
  /// lecture LIVE de la Formation.
  formationSnapshot                  Json?                    @map("formation_snapshot")
  opcoStatut                         OpcoStatut               @default(non_demande) @map("opco_statut")
  opcoSubrogation                    Boolean                  @default(false) @map("opco_subrogation")
  conventionTripartiteSigneeAt       DateTime?                @map("convention_tripartite_signee_at")
  edofVerifieAt                      DateTime?                @map("edof_verifie_at")
  ftPoeiOffreEmploiNumero            String?                  @map("ft_poei_offre_emploi_numero") @db.VarChar(50)
  ftPoeiAccordFinancementAt          DateTime?                @map("ft_poei_accord_financement_at")
  ftPoeiEngagementSigneAt            DateTime?                @map("ft_poei_engagement_signe_at")
  ftAifPrescriptionDate              DateTime?                @map("ft_aif_prescription_date")
  /// Dispositif France Travail (AIF / POEI / CSP). [T11]
  ftDispositif                       FranceTravailDispositif? @map("ft_dispositif")
  /// Numéro de dossier OPCO (mention obligatoire sur la facture en subrogation). [T11]
  numeroDossierOpco                  String?                  @map("numero_dossier_opco") @db.VarChar(60)
  // ── Prise en charge OPCO PAR DOSSIER (relevée sur le portail de la branche). [T18] ──
  /// Montant de prise en charge relevé (centimes), selon `priseEnChargeUnite`.
  priseEnChargeMontantCents          Int?                     @map("prise_en_charge_montant_cents")
  priseEnChargeUnite                 PriseEnChargeUnite?      @map("prise_en_charge_unite")
  priseEnChargePlafondFormationCents Int?                     @map("prise_en_charge_plafond_formation_cents")
  priseEnChargePlafondAnnuelCents    Int?                     @map("prise_en_charge_plafond_annuel_cents")
  /// Traçabilité auditeur : URL du portail OPCO + date du relevé du barème.
  priseEnChargeSourceUrl             String?                  @map("prise_en_charge_source_url") @db.Text
  priseEnChargeReleveLe              DateTime?                @map("prise_en_charge_releve_le")
  /// Payeur du reste à charge CPF (stagiaire/employeur/opco/france_travail/exonere). [T11]
  cpfPayeurResteCharge               String?                  @map("cpf_payeur_reste_charge") @db.VarChar(40)
  nbParticipantsPrevus               Int                      @map("nb_participants_prevus")
  nbParticipantsReels                Int?                     @map("nb_participants_reels")
  /// Session INTER-entreprises (R-INTER) : ouverte au catalogue, participants de
  /// sociétés différentes → financement + facture PAR inscription (cf. Enrollment).
  /// false (défaut) = intra : 1 commanditaire/financement au niveau session.
  interEntreprises                   Boolean                  @default(false) @map("inter_entreprises")
  /// [{ trainerId, role, heuresAnimees }] — 1 principal obligatoire.
  coFormateurs                       Json                     @default("[]") @map("co_formateurs")
  /// Formateur principal assigné (R9) — la garde isTrainerHabilite empêche
  /// d'assigner un formateur non habilité / sous-traitant non vérifié.
  formateurPrincipalId               String?                  @map("formateur_principal_id") @db.Uuid
  formateurPrincipal                 Trainer?                 @relation("SessionFormateurPrincipal", fields: [formateurPrincipalId], references: [id], onDelete: SetNull)
  /// Récurrence (self-relation, max 52 occurrences).
  sessionParentId                    String?                  @map("session_parent_id") @db.Uuid
  sessionParent                      TrainingSession?         @relation("SessionRecurrences", fields: [sessionParentId], references: [id], onDelete: SetNull)
  sessionEnfants                     TrainingSession[]        @relation("SessionRecurrences")
  /// Report (self-relation).
  sessionReporteeId                  String?                  @map("session_reportee_id") @db.Uuid
  sessionReportee                    TrainingSession?         @relation("SessionReportees", fields: [sessionReporteeId], references: [id], onDelete: SetNull)
  sessionRemplacement                TrainingSession[]        @relation("SessionReportees")
  // ── Acompte (suivi manuel, non lié à Stripe) ──
  acompteMontantCents                Int?                     @map("acompte_montant_cents")
  acompteDateVersement               DateTime?                @map("acompte_date_versement") @db.Date
  acompteRecu                        Boolean                  @default(false) @map("acompte_recu")
  acompteMoyen                       String?                  @map("acompte_moyen") @db.VarChar(60)
  statut                             TrainingSessionStatut    @default(planifiee)
  createdAt                          DateTime                 @default(now()) @map("created_at")
  updatedAt                          DateTime                 @updatedAt @map("updated_at")

  enrollments         Enrollment[]
  transitions         FormationTransition[]
  documents           DocumentGenere[]
  relevesConnexion    ReleveConnexionImport[]
  facturesFormation   FactureFormation[]
  dossiersFinancement DossierFinancement[]
  /// Jointure normalisée session ↔ formateur (remplace `coFormateurs` Json).
  sessionFormateurs   SessionFormateur[]
  /// Incidents rattachés à la session (registre des incidents — LOT 4).
  incidents           Incident[]

  @@index([formationId])
  @@index([clientId])
  @@index([devisId])
  @@index([statut])
  @@index([dateDebut])
  @@index([sessionParentId])
  @@index([sessionReporteeId])
  @@index([formateurPrincipalId])
  // ── Index composites du cockpit (règle : égalité d'abord, plage ensuite). ──
  /// Requête calendrier : sessions chevauchant une plage (`dateDebut <= to AND
  /// dateFin >= from`). `dateFin` n'avait AUCUN index.
  @@index([dateDebut, dateFin])
  /// Calendrier filtré par statut / financement (prévisionnel).
  @@index([statut, dateDebut])
  @@index([financementType, dateDebut])
  /// Charge d'un formateur sur une période.
  @@index([formateurPrincipalId, dateDebut])
  @@map("training_sessions")
}

/// Formateur (salarié ou sous-traitant). Habilitations = liste de formationIds.
model Trainer {
  id                    String        @id @default(uuid()) @db.Uuid
  nom                   String        @db.VarChar(200)
  prenom                String        @db.VarChar(200)
  email                 String        @unique @db.Citext
  telephone             String?       @db.VarChar(40)
  statut                TrainerStatut
  /// Région d'intervention (Phase 2 calendrier 2026-06-10). Slug parmi les 13
  /// régions FR (cf. src/content/regions.ts). Null = non renseigné.
  region                String?       @map("region") @db.VarChar(60)
  cvUrl                 String?       @map("cv_url") @db.Text
  cvUploadedAt          DateTime?     @map("cv_uploaded_at")
  /// [{ domaine, niveauMaitrise, verifiedAt }].
  domainesCompetences   Json          @default("[]") @map("domaines_competences")
  /// formationIds pour lesquels le formateur est habilité.
  formationsHabilitees  String[]      @default([]) @map("formations_habilitees")
  dateEmbauche          DateTime?     @map("date_embauche")
  tarifJourneeHtCents   Int?          @map("tarif_journee_ht_cents")
  /// Sous-traitant (off.19/27) : NDA propre + vérification data.gouv.fr. [T11]
  sousTraitantNda       String?       @map("sous_traitant_nda") @db.VarChar(20)
  sousTraitantVerifieAt DateTime?     @map("sous_traitant_verifie_at")
  actif                 Boolean       @default(true)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  sessionsAnimees TrainingSession[] @relation("SessionFormateurPrincipal")
  bookingsAnimes  Booking[]         @relation("BookingFormateur")

  // Espace formateur passwordless + coaching 1-to-1 (2026-06-13).
  lastFormateurLoginAt DateTime?                 @map("last_formateur_login_at")
  /// Habilitation formateur/accompagnateur AFEST (D.6313-3-1 §2). Date de
  /// l'habilitation tracée. Null = non habilité. L'enforcement (obligatoire ou
  /// non) est piloté par le flag SiteSetting `qualiopi.afest_formateur_habilitation_requise`.
  afestHabiliteAt      DateTime?                 @map("afest_habilite_at")
  magicLinks           FormateurMagicLink[]
  coachingSessions     CoachingSession[]
  /// Affectations normalisées aux sessions (principal + co-animateurs).
  sessionFormateurs    SessionFormateur[]
  /// Pièces justificatives reçues (contrat, vigilance URSSAF, NDA, RC pro…).
  documents            TrainerDocument[]
  /// Régime de TVA de SES honoraires (indépendant). Renseigné par un humain,
  /// justificatif à l'appui : la machine calcule, elle ne devine pas le régime.
  regimeTvaHonoraires  TvaRegimeHonoraires?      @map("regime_tva_honoraires")
  compensationRules    TrainerCompensationRule[]
  feeLines             TrainerFeeLine[]
  statements           TrainerStatement[]
  habilitations        TrainerHabilitation[]
  indisponibilites     TrainerAvailability[]
  auditMissions        AuditMission[]            @relation("AuditMissionFormateur")
  developmentActions   TrainerDevelopmentAction[]

  @@index([statut])
  @@index([actif])
  @@index([region])
  @@map("trainers")
}

/// Type d'action de développement des compétences d'un intervenant (ind. 22).
enum TrainerDevelopmentActionType {
  entretien_professionnel
  formation_suivie
  veille
  autre
}

/// Action d'entretien / développement des compétences d'un formateur dans le
/// temps (indicateur RNQ 22 : « Entretien et développement des compétences des
/// intervenants »). Trace DATÉE d'un entretien professionnel, d'une formation
/// suivie ou d'une veille — preuve distincte du seul CV (ind. 21).
model TrainerDevelopmentAction {
  id          String                       @id @default(uuid()) @db.Uuid
  trainerId   String                       @map("trainer_id") @db.Uuid
  trainer     Trainer                      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  type        TrainerDevelopmentActionType
  dateAction  DateTime                     @map("date_action")
  description String                       @default("") @db.Text
  createdAt   DateTime                     @default(now()) @map("created_at")

  @@index([trainerId])
  @@index([dateAction])
  @@map("trainer_development_actions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SOCLE FORMATEURS (pilier D) — habilitations normalisées + indisponibilités
// ─────────────────────────────────────────────────────────────────────────────

/// Habilitation d'un formateur sur UNE formation. Remplace `Trainer.formationsHabilitees`
/// (`String[]`), qui n'offrait ni FK, ni index, ni traçabilité : on ne pouvait pas
/// répondre à « qui peut animer cette formation ? » en SQL, ni savoir QUI a habilité
/// QUAND. Le tableau reste écrit en dual-write le temps du backfill (zéro perte).
model TrainerHabilitation {
  id           String    @id @default(uuid()) @db.Uuid
  trainerId    String    @map("trainer_id") @db.Uuid
  trainer      Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  formationId  String    @map("formation_id") @db.Uuid
  formation    Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  /// Qui a prononcé l'habilitation, et quand. Exigence Qualiopi (ind. 21/22).
  habiliteAt   DateTime  @default(now()) @map("habilite_at")
  habiliteById String?   @map("habilite_by_id") @db.Uuid
  note         String?   @db.Text

  @@unique([trainerId, formationId], map: "trainer_habilitation_unique")
  @@index([formationId])
  @@map("trainer_habilitations")
}

/// Nature d'une indisponibilité. Toutes bloquent l'affectation de la même façon ;
/// le type ne sert qu'à l'affichage et au reporting (combien de jours de congés ?).
enum TrainerAvailabilityType {
  conge
  maladie
  formation_interne
  indisponible
}

/// Fenêtre pendant laquelle un formateur NE PEUT PAS être mobilisé.
///
/// Remplace `CapacityWindow`, vestige du module de réservation retiré : celui-ci
/// comptait des créneaux globaux, jamais la disponibilité d'une personne.
///
/// Bornes INCLUSIVES en jours (`date`, pas `timestamp`) : un congé « du 3 au 7 »
/// couvre le 3 ET le 7. Une demi-journée n'est pas modélisée — un formateur
/// absent une demi-journée reste affectable, et l'arbitrage est humain.
model TrainerAvailability {
  id          String                  @id @default(uuid()) @db.Uuid
  trainerId   String                  @map("trainer_id") @db.Uuid
  trainer     Trainer                 @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  type        TrainerAvailabilityType @default(conge)
  /// Premier jour indisponible (inclus).
  dateDebut   DateTime                @map("date_debut") @db.Date
  /// Dernier jour indisponible (INCLUS).
  dateFin     DateTime                @map("date_fin") @db.Date
  motif       String?                 @db.Text
  createdById String?                 @map("created_by_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  @@index([trainerId, dateDebut, dateFin])
  @@index([dateDebut])
  @@map("trainer_availabilities")
}

/// Rôle d'un formateur sur une session de formation collective.
enum SessionFormateurRole {
  principal
  co_formateur
  assistant
  tuteur_afest
}

/// Jointure normalisée session ↔ formateur. Remplace le champ Json
/// `TrainingSession.coFormateurs` (non indexable, non agrégeable) : socle de la
/// charge par formateur et du commissionnement. Le formateur `principal` reste
/// dupliqué dans `TrainingSession.formateurPrincipalId` (cache dénormalisé lu par
/// la garde d'habilitation) ; un index partiel SQL garantit un seul `principal`
/// par session. `tarifHtCents` = snapshot du tarif du formateur figé à
/// l'affectation (la rémunération ne dérive pas si le tarif change ensuite).
model SessionFormateur {
  id            String               @id @default(uuid()) @db.Uuid
  sessionId     String               @map("session_id") @db.Uuid
  session       TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainerId     String               @map("trainer_id") @db.Uuid
  trainer       Trainer              @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  role          SessionFormateurRole @default(co_formateur)
  heuresAnimees Decimal?             @map("heures_animees") @db.Decimal(6, 2)
  tarifHtCents  Int?                 @map("tarif_ht_cents")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@unique([sessionId, trainerId], map: "session_formateur_unique")
  @@index([trainerId, sessionId])
  @@map("session_formateurs")
}

/// Stagiaire. PII ; détails handicap chiffrés AES-256-GCM (pii-crypto).
model Trainee {
  id                     String    @id @default(uuid()) @db.Uuid
  nom                    String    @db.VarChar(200)
  prenom                 String    @db.VarChar(200)
  email                  String    @unique @db.Citext
  telephone              String?   @db.VarChar(40)
  entreprise             String?   @db.VarChar(250)
  fonction               String?   @db.VarChar(200)
  situationHandicap      Boolean   @default(false) @map("situation_handicap")
  /// Chiffré pii-crypto (jamais en clair). Lecture serveur référent uniquement.
  handicapDetailsChiffre String?   @map("handicap_details_chiffre") @db.Text
  handicapVerifiePar     String?   @map("handicap_verifie_par") @db.Uuid
  handicapVerifieAt      DateTime? @map("handicap_verifie_at")
  consentementFormation  Boolean   @default(false) @map("consentement_formation")
  consentementEmail      Boolean   @default(false) @map("consentement_email")
  consentementVersion    String?   @map("consentement_version") @db.VarChar(20)
  consentementAt         DateTime? @map("consentement_at")
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  enrollments       Enrollment[]
  documents         DocumentGenere[]
  portailAcces      PortailAcces[]
  appreciations     Appreciation[]
  rgpdDemandes      RgpdDemande[]
  coachingSessions  CoachingSession[]
  coachingContracts CoachingContract[]

  @@index([email])
  @@index([entreprise])
  @@index([situationHandicap])
  @@map("trainees")
}

/// Inscription stagiaire ↔ session (unicité par couple).
model Enrollment {
  id                    String                   @id @default(uuid()) @db.Uuid
  sessionId             String                   @map("session_id") @db.Uuid
  session               TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId             String                   @map("trainee_id") @db.Uuid
  trainee               Trainee                  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  statut                EnrollmentStatut         @default(planifiee)
  tauxPresencePct       Int?                     @map("taux_presence_pct")
  emargementSigneAt     DateTime?                @map("emargement_signe_at")
  adaptationsRealisees  String?                  @map("adaptations_realisees") @db.Text
  /// Résultat d'attestation calculé (décision #7 : ≥80 complète / 60-79 partielle / <60 aucune).
  attestationResultat   AttestationResultat?     @map("attestation_resultat")
  /// Attestation officielle générée (DocumentGenere). Null tant que non émise / si <60%.
  attestationDocumentId String?                  @map("attestation_document_id") @db.Uuid
  attestationDocument   DocumentGenere?          @relation("EnrollmentAttestation", fields: [attestationDocumentId], references: [id], onDelete: SetNull)
  attestationGenereeAt  DateTime?                @map("attestation_generee_at")
  // ── Inter-entreprises (R-INTER) : financement PAR PARTICIPANT ──────────────
  // Utilisés uniquement quand la session est `interEntreprises` (participants de
  // sociétés différentes, chacun son financeur/sa facture). En intra : null
  // (le financement reste au niveau session, inchangé).
  /// Financeur de CE participant (override du financement session si renseigné).
  financementType       FinancementType?         @map("financement_type")
  /// Employeur/payeur de CE participant (pour la facture inter).
  clientId              String?                  @map("client_id") @db.Uuid
  client                Client?                  @relation("EnrollmentClient", fields: [clientId], references: [id], onDelete: SetNull)
  numeroDossierOpco     String?                  @map("numero_dossier_opco") @db.VarChar(60)
  edofVerifieAt         DateTime?                @map("edof_verifie_at")
  ftDispositif          FranceTravailDispositif? @map("ft_dispositif")
  /// Prix HT du siège pour ce participant (inter). Null = utilise le prix session.
  montantHtCents        Int?                     @map("montant_ht_cents")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  presences         PresenceCreneau[]
  evaluations       EvaluationAcquis[]
  questionnaires    Questionnaire[]
  facturesFormation FactureFormation[]

  @@unique([sessionId, traineeId], map: "enrollment_unique_per_session")
  @@index([sessionId])
  @@index([traineeId])
  @@index([statut])
  @@index([clientId])
  @@map("enrollments")
}

/// Event sourcing des transitions d'état de session (miroir BookingTransition).
model FormationTransition {
  id               String                 @id @default(uuid()) @db.Uuid
  sessionId        String                 @map("session_id") @db.Uuid
  session          TrainingSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromStatus       TrainingSessionStatut? @map("from_status")
  toStatus         TrainingSessionStatut  @map("to_status")
  trigger          String                 @db.VarChar(80)
  triggeredBy      TransitionTriggeredBy  @map("triggered_by")
  triggeredById    String?                @map("triggered_by_id") @db.Uuid
  triggeredByAdmin AdminUser?             @relation("FormationTransitionActor", fields: [triggeredById], references: [id], onDelete: SetNull)
  reason           String?                @db.VarChar(500)
  snapshotBefore   Json?                  @map("snapshot_before")
  snapshotAfter    Json?                  @map("snapshot_after")
  notes            String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")

  @@unique([sessionId, toStatus, trigger], map: "formation_transitions_idempotence")
  @@index([sessionId, createdAt])
  @@index([triggeredBy])
  @@map("formation_transitions")
}

// ============================================================
// QUALIOPI — T4 : Formation Engine (pipeline génération IA)
// Réutilise provider Anthropic + cost-tracker + retry de content-gen.
// Modèles additifs : grille qualité, cache IA, validation humaine, traçabilité.
// ============================================================

enum EtapeGeneration {
  structure
  contenu
  assemblage
}

enum FileValidationStatut {
  en_attente
  approuve
  rejete
}

/// Grille de qualité pédagogique (critères pondérés, somme=100). Une seule
/// active. Versionnée (promptVersion → invalidation cache_ia).
model GrilleQualiteConfig {
  id            String   @id @default(uuid()) @db.Uuid
  cleUnique     String   @unique @map("cle_unique") @db.VarChar(100)
  /// [{ id, libelle, poids, scoreMin, descriptif? }] — validé Zod.
  criteres      Json     @default("[]")
  scorePlancher Int      @default(80) @map("score_plancher")
  nbPassesMax   Int      @default(3) @map("nb_passes_max")
  actif         Boolean  @default(false)
  promptVersion Int      @default(1) @map("prompt_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([actif])
  @@map("grille_qualite_configs")
}

/// Cache des appels IA (clé = SHA-256(prompt+promptVersion+langue)).
model CacheIa {
  id            String    @id @default(uuid()) @db.Uuid
  cle           String    @unique @db.VarChar(64)
  valeur        Json
  modele        String    @db.VarChar(80)
  tokensIn      Int       @default(0) @map("tokens_in")
  tokensOut     Int       @default(0) @map("tokens_out")
  coutUsd       Decimal   @default(0) @map("cout_usd") @db.Decimal(10, 4)
  promptVersion Int       @map("prompt_version")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([promptVersion])
  @@index([expiresAt])
  @@map("cache_ia")
}

/// Validation humaine par étape (structure/contenu/assemblage). Snapshot
/// conservé horodaté (jamais purgé — décision Will, traçabilité).
model FileValidation {
  id             String               @id @default(uuid()) @db.Uuid
  formationId    String               @map("formation_id") @db.Uuid
  formation      Formation            @relation(fields: [formationId], references: [id], onDelete: Cascade)
  etape          EtapeGeneration
  statut         FileValidationStatut @default(en_attente)
  consigne       String?              @db.Text
  contenuPropose Json?                @map("contenu_propose")
  validePar      String?              @map("valide_par") @db.Uuid
  valideAt       DateTime?            @map("valide_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([formationId, etape])
  @@index([statut])
  @@map("file_validations")
}

/// Traçabilité fine d'une génération (coûts/tokens/cache par étape). AI Act.
model FormationGenerationJob {
  id           String    @id @default(uuid()) @db.Uuid
  formationId  String    @map("formation_id") @db.Uuid
  formation    Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  etape        String    @db.VarChar(64)
  tentative    Int       @default(1)
  status       String    @db.VarChar(32)
  tokensIn     Int       @default(0) @map("tokens_in")
  tokensOut    Int       @default(0) @map("tokens_out")
  coutUsd      Decimal   @default(0) @map("cout_usd") @db.Decimal(10, 4)
  modele       String?   @db.VarChar(80)
  dureeMs      Int?      @map("duree_ms")
  cacheHit     Boolean   @default(false) @map("cache_hit")
  errorMessage String?   @map("error_message") @db.Text
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([formationId, etape])
  @@map("formation_generation_jobs")
}

// ============================================================
// QUALIOPI — T7 : documents légaux générés (React-PDF)
// Traçabilité + numérotation immuable + QR vérif publique + rétention 5 ans.
// PAS de @@unique(session,type) : attestation/certificat sont PAR stagiaire.
// ============================================================

enum DocumentType {
  convention
  convention_tripartite
  contrat
  convocation
  emargement
  releve_connexion
  positionnement
  grille_evaluation
  satisfaction
  attestation
  attestation_partielle
  certificat_realisation
  facture
  kit_opco
  kit_cpf
  kit_france_travail
  lettre_mission
  reglement_interieur
  livret_accueil
  /// Protocole individuel AFEST (décret D.6313-3-1 §3) — coaching 1-to-1.
  protocole_afest
  /// Devis commercial PDF (Hub facturation — le PDF affiche Devis.numero).
  devis
  /// Avoir (facture rectificative, montants négatifs, lié à la facture d'origine).
  avoir
  /// Inventaire des moyens pédagogiques et techniques (off.17/18/19 — doc A14).
  inventaire_moyens
  /// Contrat de sous-traitance écrit avec un intervenant/prestataire (ind. 27) :
  /// missions confiées + clause de vérification de la conformité RNQ du
  /// sous-traitant. Lié au registre `SousTraitant`.
  contrat_sous_traitance
  /// Fiche formateur versée au dossier de preuves (ind. 21) : parcours,
  /// compétences et leur adéquation aux formations habilitées. Distincte de
  /// l'export éphémère de `exports-pdf.ts` — celle-ci est numérotée, hashée et
  /// conservée, et `Trainer.cvUrl` pointe vers sa route de téléchargement.
  cv_formateur
}

/// Document officiel généré (PDF react-pdf). Numéro immuable, hash SHA-256,
/// signed URL S3, QR de vérification (attestation/certificat), conservation 5 ans.
model DocumentGenere {
  id                  String           @id @default(uuid()) @db.Uuid
  type                DocumentType
  numero              String           @unique @db.VarChar(40)
  formationId         String?          @map("formation_id") @db.Uuid
  formation           Formation?       @relation(fields: [formationId], references: [id], onDelete: SetNull)
  sessionId           String?          @map("session_id") @db.Uuid
  session             TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  traineeId           String?          @map("trainee_id") @db.Uuid
  trainee             Trainee?         @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  clientId            String?          @map("client_id") @db.Uuid
  client              Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Coaching 1-to-1 AFEST (C1) : rattache un document généré à son parcours.
  /// Null pour les documents de formation collective (inchangé).
  coachingSessionId   String?          @map("coaching_session_id") @db.Uuid
  coachingSession     CoachingSession? @relation("CoachingDocuments", fields: [coachingSessionId], references: [id], onDelete: SetNull)
  /// URL signée S3/R2 (expiration courte). Regénérée à la demande.
  pdfUrl              String?          @map("pdf_url") @db.Text
  hashSha256          String           @map("hash_sha256") @db.VarChar(64)
  sizeBytes           Int              @default(0) @map("size_bytes")
  /// Filigrane COPIE si true.
  estCopie            Boolean          @default(false) @map("est_copie")
  /// Token QR de vérification publique (timingSafeEqual), attestation/certificat.
  qrToken             String?          @unique @map("qr_token") @db.VarChar(64)
  qrTokenCreatedAt    DateTime?        @map("qr_token_created_at")
  envoyeAt            DateTime?        @map("envoye_at")
  /// = createdAt + 5 ans (rétention légale).
  suppressionPrevueAt DateTime         @map("suppression_prevue_at")
  /// Pointe vers le fichier source ORIGINAL archivé (ex. CSV Zoom/Teams pour un
  /// relevé de connexion). Obligation CDC : archiver l'original, pas que le PDF.
  fichierOriginalPath String?          @map("fichier_original_path") @db.Text
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  enrollmentsAttestation Enrollment[] @relation("EnrollmentAttestation")

  @@index([type, sessionId])
  @@index([traineeId, type])
  @@index([coachingSessionId])
  @@index([suppressionPrevueAt])
  @@map("documents_generes")
}

// ============================================================
// QUALIOPI — T8 : Émargement présentiel + relevé de connexion distanciel
// Suivi de l'exécution (indicateur 12). Présence par créneau (demi-journée)
// → consolidation tauxPresencePct sur Enrollment. Import CSV Zoom/Teams/Meet
// → parsing → matching → présence distancielle. Migration ADDITIVE.
// ============================================================

/// Demi-journée d'un créneau de présence. `journee` = créneau plein (distanciel
/// global ou journée continue sans pause méridienne).
enum DemiJournee {
  matin
  apres_midi
  journee
}

/// Origine d'un enregistrement de présence (traçabilité émargement vs import).
enum PresenceSource {
  emargement_presentiel
  import_zoom
  import_teams
  import_meet
  manuel
}

/// Plateforme distancielle source du relevé de connexion.
enum PlateformeDistanciel {
  zoom
  teams
  meet
  autre
}

/// Créneau de présence d'un stagiaire (1 ligne = 1 inscription × 1 demi-journée).
/// Source unique de vérité pour `Enrollment.tauxPresencePct` (= Σ minutes
/// réalisées / Σ minutes prévues). Présentiel : saisie émargement. Distanciel :
/// alimenté par l'import du relevé de connexion (Zoom/Teams/Meet).
model PresenceCreneau {
  id                   String                 @id @default(uuid()) @db.Uuid
  enrollmentId         String                 @map("enrollment_id") @db.Uuid
  enrollment           Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Jour du créneau (date civile, heure de Paris).
  date                 DateTime               @db.Date
  demiJournee          DemiJournee            @map("demi_journee")
  /// Libellé lisible (ex. "2026-06-10 matin"). Stable pour affichage/PDF.
  libelle              String                 @map("libelle") @db.VarChar(120)
  /// Durée planifiée du créneau (minutes). Base du dénominateur du taux.
  dureePrevueMinutes   Int                    @map("duree_prevue_minutes")
  /// Durée réellement réalisée (minutes). 0 si absent.
  dureeRealiseeMinutes Int                    @default(0) @map("duree_realisee_minutes")
  /// Présence validée pour ce créneau (réalisé ≥ seuil × prévu).
  present              Boolean                @default(false)
  source               PresenceSource
  /// Distanciel : horodatage connexion/déconnexion (UTC stocké, affiché Paris).
  heureConnexion       DateTime?              @map("heure_connexion")
  heureDeconnexion     DateTime?              @map("heure_deconnexion")
  /// Import associé (si distanciel) — permet traçabilité + re-calcul.
  importId             String?                @map("import_id") @db.Uuid
  import               ReleveConnexionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  commentaire          String?                @db.Text
  /// Admin ayant saisi/validé (null si import système).
  enregistreParId      String?                @map("enregistre_par_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([enrollmentId, date, demiJournee], map: "presence_creneau_unique")
  @@index([enrollmentId])
  @@index([importId])
  /// Heatmap « demi-journées réalisées » par mois (cockpit). `date` n'avait aucun index.
  @@index([date, present])
  @@map("presence_creneaux")
}


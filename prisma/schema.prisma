/// Facture de formation (OF). Distincte de `Invoice` (booking générique). TVA
/// exonérée (261-4-4° CGI). Lignes = ventilation (forfait OU horaire OPCO).
/// Libellée à l'OPCO si subrogation, sinon à l'entreprise/stagiaire/FT.
model FactureFormation {
  id                            String                       @id @default(uuid()) @db.Uuid
  numero                        String                       @unique @db.VarChar(40)
  /// Activité facturée. Historiquement formation/un_a_un ; depuis le Hub

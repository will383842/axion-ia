/// Event-sourcing des transitions d'état d'une séance/parcours coaching
/// (miroir FormationTransition). Idempotence par (session, toStatus, trigger).
model CoachingTransition {
  id                String                 @id @default(uuid()) @db.Uuid
  coachingSessionId String                 @map("coaching_session_id") @db.Uuid
  coachingSession   CoachingSession        @relation(fields: [coachingSessionId], references: [id], onDelete: Cascade)
  fromStatus        CoachingSessionStatut? @map("from_status")
  toStatus          CoachingSessionStatut  @map("to_status")
  trigger           String                 @db.VarChar(80)
  triggeredBy       TransitionTriggeredBy  @map("triggered_by")
  triggeredById     String?                @map("triggered_by_id") @db.Uuid
  reason            String?                @db.VarChar(500)
  snapshotBefore    Json?                  @map("snapshot_before")
  snapshotAfter     Json?                  @map("snapshot_after")
  notes             String?                @db.Text
  createdAt         DateTime               @default(now()) @map("created_at")

  @@unique([coachingSessionId, toStatus, trigger], map: "coaching_transitions_idempotence")
  @@index([coachingSessionId, createdAt])
  @@index([triggeredBy])
  @@map("coaching_transitions")
}


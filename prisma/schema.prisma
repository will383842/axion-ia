// --- Unité légale (1 SIREN = 1 ligne) ---
model ProspectionCompany {
  id                       String                           @id @default(uuid()) @db.Uuid
  siren                    String                           @unique @db.VarChar(9)
  denomination             String?
  nomComplet               String?                          @map("nom_complet")
  sigle                    String?
  formeJuridique           String?                          @map("forme_juridique")
  formeJuridiqueLibelle    String?                          @map("forme_juridique_libelle")
  natureJuridique          String?                          @map("nature_juridique")
  natureJuridiqueLibelle   String?                          @map("nature_juridique_libelle")
  dateCreation             DateTime?                        @map("date_creation")
  etatAdministratif        ProspectionEtatAdministratif     @default(actif) @map("etat_administratif")
  economieSocialeSolidaire Boolean?                         @map("economie_sociale_solidaire")
  naf                      String?
  nafLibelle               String?                          @map("naf_libelle")
  sectionNaf               String?                          @map("section_naf")
  secteur                  ProspectionSecteur?
  trancheEffectif          String?                          @map("tranche_effectif")
  effectifEstime           Int?                             @map("effectif_estime")
  taille                   ProspectionTaille?
  tailleSource             ProspectionTailleSource?         @map("taille_source")
  categorieEntreprise      ProspectionCategorieEntreprise?  @map("categorie_entreprise")
  typeOrganisation         ProspectionTypeOrganisation?     @map("type_organisation")
  departement              String?
  codePostal               String?                          @map("code_postal")
  commune                  String?
  communeCode              String?                          @map("commune_code")
  region                   String?
  adresse                  String?
  latitude                 Float?
  longitude                Float?
  siteWeb                  String?                          @map("site_web")
  siteWebStatus            ProspectionSiteWebStatus?        @map("site_web_status")
  domainMatchMethod        ProspectionDomainMatchMethod?    @map("domain_match_method")
  domainConfidence         Float?                           @map("domain_confidence")
  emailPublic              String?                          @map("email_public")
  telephonePublic          String?                          @map("telephone_public")
  contactFormUrl           String?                          @map("contact_form_url")
  linkedinUrl              String?                          @map("linkedin_url")
  socials                  Json?
  langueSite               String?                          @map("langue_site")
  tvaIntracom              String?                          @map("tva_intracom")
  capitalSocial            String?                          @map("capital_social")
  rcs                      String?
  horaires                 String?
  contactabilite           ProspectionContactabilite?
  contactabiliteNuance     ProspectionContactabiliteNuance? @map("contactabilite_nuance")
  hasEmail                 Boolean                          @default(false) @map("has_email")
  hasTelephone             Boolean                          @default(false) @map("has_telephone")
  leadScore                Int?                             @map("lead_score")
  enrichmentStatus         ProspectionEnrichmentStatus      @default(pending) @map("enrichment_status")
  lastEnrichedAt           DateTime?                        @map("last_enriched_at")
  dataQuality              Int?                             @map("data_quality")
  firstSeenAt              DateTime?                        @map("first_seen_at")
  lastCollectedAt          DateTime?                        @map("last_collected_at")
  lastCheckedAt            DateTime?                        @map("last_checked_at")
  contentHash              String?                          @map("content_hash")
  refreshAfter             DateTime?                        @map("refresh_after")
  statutDiffusion          ProspectionStatutDiffusion?      @map("statut_diffusion")
  oppositionProspectionRNE Boolean                          @default(false) @map("opposition_prospection_rne")
  optOut                   Boolean                          @default(false) @map("opt_out")
  optOutAt                 DateTime?                        @map("opt_out_at")
  retentionUntil           DateTime?                        @map("retention_until")
  fieldProvenance          Json?                            @map("field_provenance")
  source                   ProspectionSource?

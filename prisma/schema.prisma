// ============================================================
// QUALIOPI — T18 : Certification RS/RNCP + prise en charge OPCO PAR DOSSIER.
// Les barèmes OPCO varient par branche (IDCC) × taille × dispositif → le barème
// reste saisi PAR DOSSIER (sur la session), relevé sur le portail OPCO de la
// branche du client au moment du montage, avec source + date (traçabilité
// auditeur). LE BARÈME DOSSIER RESTE LA SOURCE DE VÉRITÉ.
// Lot 5 (2026-07-13) ajoute EN COMPLÉMENT un référentiel central VERSIONNÉ
// (model BaremeOpco) : source de PRÉ-REMPLISSAGE / d'estimation quand aucune
// valeur dossier n'est saisie (fallback conservé). Champs prise-en-charge
// portés par TrainingSession + Client.idcc (cf. schema).
// ============================================================

/// Unité du montant de prise en charge OPCO relevé sur le portail de la branche.
enum PriseEnChargeUnite {
  euro_heure
  euro_jour
  euro_formation
  euro_an_salarie
}

/// OPCO (opérateur de compétences) agréé — les 11 OPCO au 2026. Les 5 premiers
/// identifiants (atlas, akto, opco2i, constructys, opcommerce) reprennent VERBATIM
/// ceux déjà émis par `inferOpcoFromNaf` (src/server/qualiopi/crm/naf-opco.ts) :
/// ne PAS les renommer sous peine de casser l'inférence NAF → OPCO.
enum Opco {
  atlas
  opco_ep
  akto
  opco2i
  mobilites
  afdas
  uniformation
  ocapiat
  constructys
  opcommerce
  opco_sante
}

/// Barème OPCO centralisé et VERSIONNÉ (Lot 5). Complète — sans le remplacer — le
/// barème saisi par dossier sur TrainingSession : sert de source de PRÉ-REMPLISSAGE
/// et d'estimation devis quand aucune valeur dossier n'est saisie. Le barème dossier
/// reste la source de vérité (override auditeur ; aucun recalcul rétroactif).
///
/// Versionnement (les barèmes CHANGENT) : chaque relevé = une NOUVELLE ligne portant
/// une `dateEffet`. Une modification NE MODIFIE JAMAIS une ligne existante — elle en
/// crée une nouvelle et ferme la précédente (`effectiveTo`). L'historique est conservé
/// intégralement. Les dossiers déjà engagés gardent le barème snapshoté sur la session
/// (pas de relecture) ; seuls les nouveaux dossiers résolvent la version en vigueur à
/// leur date. `releveLe` = date du relevé portail (pilote l'alerte « barème > 12 mois »).
/// VALEURS saisies par un humain (relevés portails OPCO) — jamais inventées ; structure
/// livrée VIDE (tous les plafonds nullable).
model BaremeOpco {
  id                    String    @id @default(uuid()) @db.Uuid
  opco                  Opco
  /// Libellé optionnel du périmètre (branche/IDCC, taille, dispositif) couvert —
  /// texte libre car les barèmes varient par branche × taille × dispositif.
  perimetre             String?   @db.VarChar(200)
  /// Plafonds en CENTIMES (nullable : structure vide tant que non relevé).
  intraHoraireCents     Int?      @map("intra_horaire_cents")
  interPresentielCents  Int?      @map("inter_presentiel_cents")
  interDistancielCents  Int?      @map("inter_distanciel_cents")
  plafondFormationCents Int?      @map("plafond_formation_cents")
  plafondAnnuelCents    Int?      @map("plafond_annuel_cents")
  /// Traçabilité auditeur : URL du portail OPCO + date du relevé.
  sourceUrl             String?   @map("source_url") @db.Text
  releveLe              DateTime? @map("releve_le")
  /// Versionnement : date d'effet + fermeture (`effectiveTo` null = en vigueur).
  dateEffet             DateTime  @map("date_effet")
  effectiveTo           DateTime? @map("effective_to")
  note                  String?   @db.Text
  createdById           String?   @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([opco, dateEffet])
  @@index([effectiveTo])
  @@map("baremes_opco")
}

/// Import d'un relevé de connexion distanciel (CSV Zoom/Teams/Meet). Archive le
/// fichier ORIGINAL (obligation CDC) et trace le rapprochement participants↔
/// stagiaires (matched/unmatched). Génère les `PresenceCreneau` distanciels.
model ReleveConnexionImport {
  id                  String               @id @default(uuid()) @db.Uuid
  sessionId           String               @map("session_id") @db.Uuid
  session             TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  plateforme          PlateformeDistanciel
  /// Nom du fichier d'origine (ex. "participants_2026-06-10.csv").
  fichierOriginalNom  String               @map("fichier_original_nom") @db.VarChar(255)
  /// Clé R2 du CSV original archivé (conservation 5 ans). Null si R2 absent.
  fichierOriginalPath String?              @map("fichier_original_path") @db.Text
  /// SHA-256 du contenu brut importé (intégrité).
  hashSha256          String               @map("hash_sha256") @db.VarChar(64)
  nbLignes            Int                  @default(0) @map("nb_lignes")
  nbMatched           Int                  @default(0) @map("nb_matched")
  nbUnmatched         Int                  @default(0) @map("nb_unmatched")
  /// Participants non rapprochés (pour revue manuelle) : [{ nom, email, dureeMin }].
  unmatched           Json                 @default("[]")
  /// Métadonnées du parse (idReunion, fuseau détecté, etc.).
  meta                Json                 @default("{}")
  importeParId        String?              @map("importe_par_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")

  presences PresenceCreneau[]

  @@index([sessionId])
  @@map("releves_connexion_imports")
}

// ============================================================================
// OFFRES D'EMPLOI — système carrières DB-piloté (hub /carrieres + page/offre +
// candidature). Voir _AUDIT/PLAN-OFFRES-EMPLOI-2026-06-08. Clone archi FAQ.
// ============================================================================

enum JobCategory {
  developpement
  ia
  data
  design
  produit
  conseil
  commercial
  marketing
  operations
  support
  autre
}

enum JobWorkMode {
  on_site
  hybrid
  remote
}

enum JobApplicationStatus {
  new
  reviewing
  shortlisted
  rejected
  hired
  archived
}

/// Une offre d'emploi pilotée depuis la console admin (publiée en dynamique).
model JobOffer {
  id       String        @id @default(uuid()) @db.Uuid
  slug     String        @unique @db.VarChar(180)
  status   PublishStatus @default(draft)
  category JobCategory   @default(autre)

  // Bilingue (colonnes séparées, comme FAQ)
  titleFr   String @map("title_fr") @db.VarChar(160)
  titleEn   String @map("title_en") @db.VarChar(160)
  summaryFr String @map("summary_fr") @db.VarChar(320)
  summaryEn String @map("summary_en") @db.VarChar(320)

  // Corps riche Tiptap — 3 sources par locale (html rendu / json canon / texte FTS)
  bodyFr     String @map("body_fr") @db.Text
  bodyJsonFr Json?  @map("body_json_fr")
  bodyTextFr String @map("body_text_fr") @db.Text
  bodyEn     String @map("body_en") @db.Text
  bodyJsonEn Json?  @map("body_json_en")
  bodyTextEn String @map("body_text_en") @db.Text

  // JobPosting / Google for Jobs
  employmentType String      @default("FULL_TIME") @map("employment_type") @db.VarChar(20)
  workMode       JobWorkMode @default(on_site) @map("work_mode")
  city           String?     @db.VarChar(120)
  region         String?     @db.VarChar(120)
  country        String      @default("FR") @db.VarChar(2)
  // Zone d'emploi multi-villes (postes itinérants/territoriaux) : tableau JSON de
  // { city, region? } → JobPosting multi-location (visible Google for Jobs dans
  // toutes ces villes depuis UNE annonce, sans pages dupliquées). FR-only.
  jobLocations   Json?       @map("job_locations")
  salaryMin      Int?        @map("salary_min")
  salaryMax      Int?        @map("salary_max")
  salaryPeriod   String      @default("YEAR") @map("salary_period") @db.VarChar(10)
  salaryCurrency String      @default("EUR") @map("salary_currency") @db.VarChar(3)
  salaryVisible  Boolean     @default(true) @map("salary_visible")
  isCommission   Boolean     @default(false) @map("is_commission")

  // Mobilité — n'affiche permis/véhicule sur le formulaire que si true
  requiresDriverLicense Boolean @default(false) @map("requires_driver_license")
  requiresVehicle       Boolean @default(false) @map("requires_vehicle")

  // Questions par offre : [{ id, labelFr, labelEn, required }]
  screeningQuestions Json? @map("screening_questions")

  // Éditorial pilotable (rendu hub + détail)
  contractLabel       String?   @map("contract_label") @db.VarChar(60)
  startDate           DateTime? @map("start_date")
  applicationDeadline DateTime? @map("application_deadline")
  remoteDaysPerWeek   Int?      @map("remote_days_per_week")
  perks               Json?
  teamName            String?   @map("team_name") @db.VarChar(120)
  managerName         String?   @map("manager_name") @db.VarChar(120)
  heroImagePath       String?   @map("hero_image_path") @db.VarChar(255)

  // SEO / indexation (anti-doorway)
  metaTitle       String?        @map("meta_title") @db.VarChar(70)
  metaDescription String?        @map("meta_description") @db.VarChar(160)
  indexationTier  IndexationTier @default(tier_1_indexable) @map("indexation_tier")
  ogImagePath     String?        @map("og_image_path") @db.VarChar(255)

  // Cycle de vie
  datePosted   DateTime  @default(now()) @map("date_posted")
  validThrough DateTime? @map("valid_through")
  publishedAt  DateTime? @map("published_at")
  filledAt     DateTime? @map("filled_at")
  displayOrder Int       @default(0) @map("display_order")
  viewCount    Int       @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications JobApplication[]

  @@index([status])
  @@index([category, status])
  @@index([indexationTier, status])
  @@index([status, displayOrder])
  @@map("job_offers")
}

/// Une candidature reçue pour une offre (PII chiffrées, CV optionnel sur disque).
model JobApplication {
  id             String   @id @default(uuid()) @db.Uuid
  offerId        String   @map("offer_id") @db.Uuid
  offer          JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerTitleSnap String   @map("offer_title_snap") @db.VarChar(160)

  // PII — chiffrées at-rest (encryptPii). PAS de sexe/âge (anti-discrimination).
  civility   String? @db.VarChar(20)
  firstName  String  @map("first_name") @db.Text
  lastName   String  @map("last_name") @db.Text
  email      String  @db.Text
  phone      String  @db.Text
  city       String? @db.VarChar(120)
  motivation String? @db.Text

  // Profil structuré (questions, CV pas obligatoire)
  currentRole      String?  @map("current_role") @db.VarChar(200)
  experienceBand   String?  @map("experience_band") @db.VarChar(40)
  availability     String?  @db.VarChar(120)
  linkedinUrl      String?  @map("linkedin_url") @db.VarChar(255)
  hasDriverLicense Boolean? @map("has_driver_license")
  hasVehicle       Boolean? @map("has_vehicle")
  answers          Json?

  // CV optionnel (volume disque /var/data/cv)
  cvStoragePath  String? @map("cv_storage_path") @db.VarChar(255)
  cvOriginalName String? @map("cv_original_name") @db.VarChar(255)
  cvMimeType     String? @map("cv_mime_type") @db.VarChar(100)
  cvSizeBytes    Int?    @map("cv_size_bytes")

  // Photo candidat — OPTIONNELLE (le candidat choisit). Stockage disque admin-only,
  // comme le CV. Note : photo non requise (anti-discrimination), purement facultative.
  photoStoragePath  String? @map("photo_storage_path") @db.VarChar(255)
  photoOriginalName String? @map("photo_original_name") @db.VarChar(255)
  photoMimeType     String? @map("photo_mime_type") @db.VarChar(100)

  // Prétention de revenus — OPTIONNELLE (salaire souhaité, PAS l'historique :
  // conforme directive UE 2023/970 qui interdit l'historique, pas les attentes).
  salaryExpectation String? @map("salary_expectation") @db.VarChar(80)

  // RGPD / sécurité
  ipHash         String? @map("ip_hash") @db.VarChar(64)
  userAgent      String? @map("user_agent") @db.Text
  consentVersion String  @map("consent_version") @db.VarChar(40)
  locale         Locale  @default(fr)

  // Workflow admin
  status         JobApplicationStatus @default(new)
  internalNotes  String?              @map("internal_notes") @db.Text
  assignedTo     String?              @map("assigned_to") @db.VarChar(100)
  needsAttention Boolean              @default(true) @map("needs_attention")
  submittedAt    DateTime             @default(now()) @map("submitted_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([offerId])
  @@index([status, needsAttention])
  @@index([submittedAt])
  @@map("job_applications")
}

// ============================================================================
// ESPACE FORMATEUR (passwordless) + COACHING 1-to-1 EN LIGNE (2026-06-13)
// Comptes formateurs sans mot de passe (magic-token HMAC, cf. src/lib/magic-token.ts)
// + formulaires 1-to-1 remplis en ligne. Ancre = modèle Trainer existant.
// ============================================================================

enum CoachingSessionStatut {
  planifiee
  realisee
  annulee
  reportee
}

enum OptimisationType {
  automatisation
  delegation
  simplification
  outillage
  organisation
}

/// Lien magique à usage unique pour la connexion passwordless d'un formateur.
/// Le token en clair n'est JAMAIS stocké (seul son hash SHA-256). TTL court +
/// usage unique (usedAt) ; intégrité signée HMAC en plus (src/lib/magic-token.ts).
model FormateurMagicLink {
  id        String    @id @default(uuid()) @db.Uuid
  trainerId String    @map("trainer_id") @db.Uuid
  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdIp String?   @map("created_ip") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([trainerId])
  @@index([expiresAt])
  @@map("formateur_magic_links")
}

/// Séance/parcours de coaching 1-to-1. Parent reliant le formateur (coach), le
/// bénéficiaire (Trainee, ou champs libres si ad-hoc), l'intervention et la date.
/// Les formulaires (cartographie, optimisations, plan, CR, journal) s'y rattachent.
model CoachingSession {
  id                       String                @id @default(uuid()) @db.Uuid
  trainerId                String                @map("trainer_id") @db.Uuid
  trainer                  Trainer               @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  traineeId                String?               @map("trainee_id") @db.Uuid
  trainee                  Trainee?              @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  /// Référence souple vers un Booking (pas de FK : un coaching peut exister sans booking).
  bookingId                String?               @map("booking_id") @db.Uuid
  /// Slug d'intervention (cf. booking-catalog : dirigeant-vision-strategique, coaching-decouverte…).
  interventionSlug         String                @map("intervention_slug") @db.VarChar(80)
  /// Début de la séance. Historiquement une date sans heure (minuit) → le
  /// calendrier retombe sur un événement « journée entière » si `dateSeanceFin`
  /// est null.
  dateSeance               DateTime              @map("date_seance")
  /// Fin planifiée de la séance (créneau horaire). Null = séance legacy sans heure.
  dateSeanceFin            DateTime?             @map("date_seance_fin")
  // ── Lieu de déroulement (miroir TrainingSession). Tout additif. ─────────────
  lieuType                 LieuType?             @map("lieu_type")
  lieuIntitule             String?               @map("lieu_intitule") @db.VarChar(200)
  lieuAdresse              String?               @map("lieu_adresse") @db.Text
  lieuCodePostal           String?               @map("lieu_code_postal") @db.VarChar(10)
  lieuVille                String?               @map("lieu_ville") @db.VarChar(120)
  lieuSalle                String?               @map("lieu_salle") @db.VarChar(120)
  lieuVisioUrl             String?               @map("lieu_visio_url") @db.Text
  statut                   CoachingSessionStatut @default(planifiee)
  beneficiaireNom          String?               @map("beneficiaire_nom") @db.VarChar(200)
  beneficiaireEmail        String?               @map("beneficiaire_email") @db.Citext
  beneficiaireEntreprise   String?               @map("beneficiaire_entreprise") @db.VarChar(250)
  // ── Couche administrative/légale AFEST (C1, 2026-06-14) — tout additif ──────
  /// Contrat de coaching récurrent rattaché (un-a-un-recurrent), si applicable.
  coachingContractId       String?               @map("coaching_contract_id") @db.Uuid
  coachingContract         CoachingContract?     @relation(fields: [coachingContractId], references: [id], onDelete: SetNull)
  /// Parcours cadré en AFEST (active l'applicabilité des indicateurs off.13/14/15/28).
  estAfest                 Boolean               @default(false) @map("est_afest")
  /// Coaching 1-to-1 = intra par défaut (1 bénéficiaire, 1 entreprise).
  interEntreprises         Boolean               @default(false) @map("inter_entreprises")
  /// Objectifs pédagogiques : [{ id, libelle }] (miroir Formation.objectifsPedagogiques).
  objectifsPedagogiques    Json                  @default("[]") @map("objectifs_pedagogiques")
  /// Snapshot légal anti-stale (WS9) — copie figée du contenu pédagogique
  /// engageant (intitulé résolu, objectifs, heures prévues, modalité, mention
  /// certifiante) au moment de la PREMIÈRE émission d'un document légal. Garantit
  /// que protocole/attestation/certificat/kits d'un même parcours restent
  /// cohérents même si le contenu (ou le libellé catalogue) change ensuite.
  /// Null = parcours legacy sans document émis → repli lecture LIVE.
  coachingSnapshot         Json?                 @map("coaching_snapshot")
  conventionSigneeAt       DateTime?             @map("convention_signee_at")
  /// Cache des heures réellement réalisées = Σ CompteRenduSeance.dureeMinutes / 60.
  /// Recalculé à la clôture du parcours. Source de vérité OPCO/attestation.
  dureeReelleHeures        Decimal?              @map("duree_reelle_heures") @db.Decimal(6, 2)
  /// Heures prévues à la convention (dénominateur des seuils d'attestation).
  heuresPrevuesConvention  Decimal?              @map("heures_prevues_convention") @db.Decimal(6, 2)

// ============================================================
// 35. booking_transitions — Sprint X.1 §5.1.20 (event sourcing)
// ============================================================

/// Sprint X.1 — event sourcing transitions state machine (Agent 3 R2).
/// Idempotence transition one-shot via index unique partiel
/// `(bookingId, toStatus, trigger)` (cf. §5.1.20).
model BookingTransition {
  id               String                @id @default(uuid()) @db.Uuid
  bookingId        String                @map("booking_id") @db.Uuid
  booking          Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus       BookingStatus?        @map("from_status")
  toStatus         BookingStatus         @map("to_status")
  /// 'admin.validate_option' | 'webhook.stripe.checkout_completed' |
  /// 'cron.j7_reminder' | etc.
  trigger          String                @db.VarChar(80)
  triggeredBy      TransitionTriggeredBy @map("triggered_by")
  triggeredById    String?               @map("triggered_by_id") @db.Uuid
  triggeredByAdmin AdminUser?            @relation("BookingTransitionActor", fields: [triggeredById], references: [id], onDelete: SetNull)
  reason           String?               @db.VarChar(500)
  /// {before, after, fields:[...]}.
  snapshotBefore   Json?                 @map("snapshot_before")
  snapshotAfter    Json?                 @map("snapshot_after")
  notes            String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")

  @@unique([bookingId, toStatus, trigger], map: "booking_transitions_idempotence")
  @@index([bookingId, createdAt])
  @@index([triggeredBy])
  @@map("booking_transitions")
}

// ============================================================
// KB-1 — Knowledge Base unifiée (11 modèles)
// Source : `_AUDIT/KNOWLEDGE-BASE-2026/01-DATA-MODEL.md`
// V1.5 (différé) : `KnowledgeEmbedding` (pgvector) → Sprint KB-21
// ============================================================

/// Table racine polymorphique (16 types via `type`).
model KnowledgeEntry {
  id String @id @default(uuid()) @db.Uuid

  // Discriminator + classification
  type            KbType
  domain          KbDomain
  audience        KbAudience        @default(team)
  confidentiality KbConfidentiality @default(internal)
  status          KbStatus          @default(draft)
  pipelineStage   KbPipelineStage   @default(idea)

  // Présentation
  coverImageId  String?         @map("cover_image_id") @db.Uuid
  coverImage    KnowledgeAsset? @relation("CoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  heroLayout    String?         @map("hero_layout") @db.VarChar(40)
  pinned        Boolean         @default(false)
  featured      Boolean         @default(false)
  featuredUntil DateTime?       @map("featured_until")

  // Série / collection (V1.5 — préparé V1, nullable string)
  seriesId String? @map("series_id") @db.Uuid

  // Slug racine (locale-agnostique, identifiant stable cross-langue)
  slug String @unique @db.VarChar(180)

  // Compteurs aggregés (dénormalisés pour perf liste)
  viewsCount       Int @default(0) @map("views_count")
  helpfulUpCount   Int @default(0) @map("helpful_up_count")
  helpfulDownCount Int @default(0) @map("helpful_down_count")

  // Planning éditorial
  scheduledFor DateTime? @map("scheduled_for")
  embargoUntil DateTime? @map("embargo_until")
  publishedAt  DateTime? @map("published_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewDueAt  DateTime? @map("review_due_at")
  expiresAt    DateTime? @map("expires_at")

  // Imputation
  createdById        String? @map("created_by_id") @db.Uuid
  updatedById        String? @map("updated_by_id") @db.Uuid
  reviewerId         String? @map("reviewer_id") @db.Uuid
  assignedAuthorId   String? @map("assigned_author_id") @db.Uuid
  assignedAuthor     Author? @relation(fields: [assignedAuthorId], references: [id], onDelete: SetNull)
  assignedReviewerId String? @map("assigned_reviewer_id") @db.Uuid

  // Brief éditorial
  briefMarkdown   String? @map("brief_markdown") @db.Text
  targetWordCount Int?    @map("target_word_count")
  targetKeyword   String? @map("target_keyword") @db.VarChar(180)

  // Soft-delete
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  translations        KnowledgeTranslation[]
  versions            KnowledgeVersion[]
  tags                KnowledgeTagOnEntry[]
  outgoingRelations   KnowledgeRelation[]           @relation("FromEntry")
  incomingRelations   KnowledgeRelation[]           @relation("ToEntry")
  feedback            KnowledgeFeedback[]
  bookmarks           KnowledgeBookmark[]
  reviewerAssignments KnowledgeReviewerAssignment[]
  slugHistory         KnowledgeSlugHistory[]
  annotations         KnowledgeAnnotation[]
  collectionItems     KnowledgeCollectionItem[]
  serviceBindings     KnowledgeServiceBinding[]

  // KB V4 — Source tracking factory (Sprint KB-13 V4, §17.5/§17.7 prompt master).
  // Permet audit immuable + remontée à la source en cas de problème.
  // NULL pour les entries legacy migrées kb-2/kb-5 (pas factory-générées).
  sourceFactoryId   String?   @map("source_factory_id") @db.VarChar(80)
  sourcePromptId    String?   @map("source_prompt_id") @db.VarChar(120)
  sourceModelUsed   String?   @map("source_model_used") @db.VarChar(80)
  sourceCostCents   Int?      @map("source_cost_cents")
  sourceGeneratedAt DateTime? @map("source_generated_at")

  /// City Domination 2026-05-18 P1-6 — Topic fingerprint SimHash 64-bit hex
  /// pour dedup sémantique cross-entry. Voir model Article même champ.
  /// Cohérence : permet `topic_fingerprint` matching à la fois sur Article
  /// (blog) et KnowledgeEntry (KB V4) → bloque la republication thématique
  /// quasi-identique entre les deux pipelines.
  topicFingerprint String? @map("topic_fingerprint") @db.VarChar(64)

  @@index([type, status, audience])
  @@index([type, publishedAt(sort: Desc)])
  @@index([status, pipelineStage])
  @@index([publishedAt(sort: Desc)])
  @@index([reviewDueAt])
  @@index([expiresAt])
  @@index([pinned, featured])
  @@index([domain, status])
  @@index([assignedAuthorId])
  @@index([assignedReviewerId])
  @@index([scheduledFor])
  @@index([deletedAt])
  @@index([sourceFactoryId])
  @@map("knowledge_entries")
}

/// Traduction locale-scoped (pattern `ArticleTranslation`).
/// Triple-source body (HTML + JSON + text plain) — Sprint 24 C4.
model KnowledgeTranslation {
  id      String         @id @default(uuid()) @db.Uuid
  entryId String         @map("entry_id") @db.Uuid
  entry   KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale  Locale

  title   String  @db.VarChar(255)
  slug    String  @db.VarChar(255)
  excerpt String? @db.Text

  // Triple-source Tiptap
  body     String  @db.Text
  bodyJson Json?   @map("body_json")
  bodyText String? @map("body_text") @db.Text

  // SEO meta locale-scoped
  metaTitle       String?         @map("meta_title") @db.VarChar(70)
  metaDescription String?         @map("meta_description") @db.VarChar(160)
  ogImageId       String?         @map("og_image_id") @db.Uuid
  ogImage         KnowledgeAsset? @relation("OgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  // Métriques rédaction
  readingTime      Int?   @map("reading_time")
  wordCount        Int?   @map("word_count")
  readabilityScore Float? @map("readability_score")
  qualityScore     Float? @map("quality_score")

  // Alt text (bloquant publication, assertion server-side)
  alts Json?

  versions  KnowledgeVersion[]
  embedding KnowledgeEmbedding?
  seoCache  KnowledgeSeoCache[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // KB-7 FTS tsvector matérialisé via migration SQL `kb_fts_setup.sql` (GENERATED ALWAYS).
  // Index GIN + index trigram sur title gérés hors Prisma (Unsupported types).
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@unique([entryId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@index([locale, qualityScore])
  @@map("knowledge_translations")
}

/// Versions immutables (forensique). 1 row par save (entry + translation snapshot).
model KnowledgeVersion {
  id            String                @id @default(uuid()) @db.Uuid
  entryId       String                @map("entry_id") @db.Uuid
  entry         KnowledgeEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  translationId String?               @map("translation_id") @db.Uuid
  translation   KnowledgeTranslation? @relation(fields: [translationId], references: [id], onDelete: SetNull)
  version       Int

  snapshotJson Json @map("snapshot_json")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([entryId, translationId, version])
  @@index([entryId, version(sort: Desc)])
  @@index([createdAt])
  @@map("knowledge_versions")
}

/// Tags KB (libres modérés, M2M via `KnowledgeTagOnEntry`).
model KnowledgeTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  nameFr    String   @map("name_fr") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
  descFr    String?  @map("desc_fr") @db.Text
  descEn    String?  @map("desc_en") @db.Text
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")

  entries KnowledgeTagOnEntry[]

  @@index([slug])
  @@map("knowledge_tags")
}

/// Table de liaison M2M tag ↔ entry (pattern `ArticleTagOnArticle`).
model KnowledgeTagOnEntry {
  entryId String         @map("entry_id") @db.Uuid
  tagId   String         @map("tag_id") @db.Uuid
  entry   KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     KnowledgeTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
  @@map("knowledge_tags_on_entries")
}

/// KB V4.1 Service Binding — rattache une entrée KB à un service Axion-IA
/// (offre commerciale). Additif strict (Sprint Service-Binding 2026-05-29).
///
/// La VISIBILITÉ (bloc « connaissances liées » + CTA + Offer JSON-LD) est déjà
/// assurée sans cette table, via les tags `service:*` + `pricing.ts` (helpers
/// `service-binding.ts`). Cette table apporte la couche GOUVERNANCE :
///   - `isPrimary` : binding principal (1 service mis en avant) vs secondaires ;
///   - `audienceTarget` : variante par cible (dirigeant / équipe / technique…) ;
///   - override manuel admin (futur) sans toucher aux tags dérivés du seed.
///
/// `serviceKind` = slug canonique du service (= suffixe du tag `service:<slug>`,
/// SSOT `src/content/knowledge/services.ts`). Stocké en VarChar (pas d'enum DB)
/// pour rester additif et tolérer l'ajout d'un service sans migration d'enum.
model KnowledgeServiceBinding {
  id      String         @id @default(uuid()) @db.Uuid
  entryId String         @map("entry_id") @db.Uuid
  entry   KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Slug du service (audit / implementation / interventions-formations /
  /// un-a-un / sites-web-augmentes). Cf. SERVICE_SLUGS.
  serviceKind String  @map("service_kind") @db.VarChar(60)
  isPrimary   Boolean @default(false) @map("is_primary")

  /// Variante par cible (optionnel) : dirigeant / equipe / technique / generale.
  audienceTarget KbAudienceTarget? @map("audience_target")

  /// Provenance : `seed` (dérivé verticales) ou `admin` (override manuel).
  source String @default("seed") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entryId, serviceKind])
  @@index([serviceKind, isPrimary])
  @@map("knowledge_service_bindings")
}

/// Cible d'audience d'un binding service (variante de discours/CTA). Optionnel.
enum KbAudienceTarget {
  dirigeant
  equipe
  technique
  generale

  @@map("kb_audience_target")
}

/// Graphe typé entry-to-entry (cycle detection en server action Sprint KB-4).
model KnowledgeRelation {
  id          String         @id @default(uuid()) @db.Uuid
  fromEntryId String         @map("from_entry_id") @db.Uuid
  fromEntry   KnowledgeEntry @relation("FromEntry", fields: [fromEntryId], references: [id], onDelete: Cascade)
  toEntryId   String         @map("to_entry_id") @db.Uuid
  toEntry     KnowledgeEntry @relation("ToEntry", fields: [toEntryId], references: [id], onDelete: Cascade)
  kind        KbRelationKind

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromEntryId, toEntryId, kind])
  @@index([toEntryId, kind])
  @@index([fromEntryId, kind])
  @@map("knowledge_relations")
}

/// Vote 👍/👎 anonymisé public. Rate-limit 1/IP/entry/24h via Redis bucket.
model KnowledgeFeedback {
  id        String         @id @default(uuid()) @db.Uuid
  entryId   String         @map("entry_id") @db.Uuid
  entry     KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale    Locale
  vote      KbFeedbackVote
  ipHash    String         @map("ip_hash") @db.VarChar(64)
  sessionId String?        @map("session_id") @db.VarChar(64)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([entryId, locale, vote])
  @@index([createdAt])
  @@map("knowledge_feedback")
}

/// Asset library partagée (Sprint KB-11 — sharp AVIF/WebP + EXIF strip).
model KnowledgeAsset {
  id             String  @id @default(uuid()) @db.Uuid
  mimeType       String  @map("mime_type") @db.VarChar(80)
  originalPath   String  @map("original_path") @db.VarChar(512)
  processedPaths Json?   @map("processed_paths")
  width          Int?
  height         Int?
  bytes          Int
  hash           String  @unique @db.VarChar(64)
  altText        String? @map("alt_text") @db.Text
  caption        String? @db.Text

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  usageCount   Int     @default(0) @map("usage_count")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Reverse relations
  coverFor   KnowledgeEntry[]       @relation("CoverImage")
  ogImageFor KnowledgeTranslation[] @relation("OgImage")

  @@index([hash])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([mimeType])
  @@map("knowledge_assets")
}

/// Historique slug → entrée cible. Middleware Next 301 lookup O(1).
model KnowledgeSlugHistory {
  id        String         @id @default(uuid()) @db.Uuid
  oldLocale Locale         @map("old_locale")
  oldType   KbType         @map("old_type")
  oldSlug   String         @map("old_slug") @db.VarChar(255)
  entryId   String         @map("entry_id") @db.Uuid
  entry     KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedAt DateTime       @default(now()) @map("changed_at")
  reason    String?        @db.Text

  @@unique([oldLocale, oldType, oldSlug])
  @@index([entryId])
  @@map("knowledge_slug_history")
}

/// Bookmark client (surface `/mes-ressources/`).
model KnowledgeBookmark {
  id                  String         @id @default(uuid()) @db.Uuid
  entryId             String         @map("entry_id") @db.Uuid
  entry               KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  clientEmail         String?        @map("client_email") @db.Citext
  sessionId           String?        @map("session_id") @db.VarChar(64)
  privateNoteMarkdown String?        @map("private_note_markdown") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")

  @@unique([entryId, clientEmail])
  @@index([clientEmail, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("knowledge_bookmarks")
}

/// KB V4 (Sprint KB-18) — Annotations équipe sur entries (revue collaborative).
/// Différent des bookmarks (côté client) : ici c'est l'éditorial/SEO team qui commente.
model KnowledgeAnnotation {
  id           String         @id @default(uuid()) @db.Uuid
  entryId      String         @map("entry_id") @db.Uuid
  entry        KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId     String         @map("author_id") @db.Uuid
  /// Référence optionnelle à un anchor (id de heading TOC ou translationId)
  anchorRef    String?        @map("anchor_ref") @db.VarChar(120)
  bodyMarkdown String         @map("body_markdown") @db.Text
  /// review_comment | seo_suggestion | factual_check | typo | content_request
  kind         String         @default("review_comment") @db.VarChar(40)
  /// open | resolved | wont_fix
  status       String         @default("open") @db.VarChar(20)
  resolvedAt   DateTime?      @map("resolved_at")
  resolvedById String?        @map("resolved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entryId, status])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("knowledge_annotations")
}

/// KB V4 (Sprint KB-18) — Séries/Collections éditoriales (curation manuelle).
/// Ex : « Parcours dirigeants : 10 articles IA fondamentaux »
model KnowledgeCollection {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(120)
  titleFr       String    @map("title_fr") @db.VarChar(255)
  titleEn       String?   @map("title_en") @db.VarChar(255)
  descriptionFr String?   @map("description_fr") @db.Text
  descriptionEn String?   @map("description_en") @db.Text
  /// public | unlisted | team
  visibility    String    @default("public") @db.VarChar(20)
  ownerId       String?   @map("owner_id") @db.Uuid
  coverAssetId  String?   @map("cover_asset_id") @db.Uuid
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  items KnowledgeCollectionItem[]

  @@index([visibility, publishedAt])
  @@map("knowledge_collections")
}

/// Join collection × entry avec ordre explicite.
model KnowledgeCollectionItem {
  collectionId String              @map("collection_id") @db.Uuid
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entryId      String              @map("entry_id") @db.Uuid
  entry        KnowledgeEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position     Int
  noteFr       String?             @map("note_fr") @db.Text
  noteEn       String?             @map("note_en") @db.Text
  addedAt      DateTime            @default(now()) @map("added_at")

  @@id([collectionId, entryId])
  @@unique([collectionId, position])
  @@index([entryId])
  @@map("knowledge_collection_items")
}

/// Audit imports — traçabilité provenance (Sprint KB-15+).
model KnowledgeImportBatch {
  id           String         @id @default(uuid()) @db.Uuid
  source       KbImportSource
  sourceRef    String?        @map("source_ref") @db.VarChar(255)
  importedById String?        @map("imported_by_id") @db.Uuid
  entriesCount Int            @default(0) @map("entries_count")
  status       KbImportStatus @default(pending)
  errorLog     Json?          @map("error_log")
  createdAt    DateTime       @default(now()) @map("created_at")
  completedAt  DateTime?      @map("completed_at")

  @@index([source, status])
  @@index([importedById])
  @@map("knowledge_import_batches")
}

/// Assignation reviewer éditorial (Sprint KB-13 calendar + queue).
model KnowledgeReviewerAssignment {
  id           String                     @id @default(uuid()) @db.Uuid
  entryId      String                     @map("entry_id") @db.Uuid
  entry        KnowledgeEntry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reviewerId   String                     @map("reviewer_id") @db.Uuid
  assignedById String?                    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime                   @default(now()) @map("assigned_at")
  status       KbReviewerAssignmentStatus @default(pending)
  dueAt        DateTime?                  @map("due_at")
  acceptedAt   DateTime?                  @map("accepted_at")
  completedAt  DateTime?                  @map("completed_at")
  reviewerNote String?                    @map("reviewer_note") @db.Text

  @@unique([entryId, reviewerId])
  @@index([reviewerId, status])
  @@index([dueAt])
  @@map("knowledge_reviewer_assignments")
}

/// KB V4 (Sprint KB-12.5) — Embeddings pgvector pour dedup factory + recherche hybride.
/// Pattern : 1 vecteur par translation. Indexé HNSW cosine_ops.
/// Modèle d'embedding stocké pour permettre migrations futures (Voyage AI / OpenAI / Cohere).
/// Vector size 1024 = Voyage AI voyage-3-lite (default V4) ; voyage-3 = 1536, à
/// reconfigurer si bascule.
model KnowledgeEmbedding {
  id             String                      @id @default(uuid()) @db.Uuid
  translationId  String                      @unique @map("translation_id") @db.Uuid
  translation    KnowledgeTranslation        @relation(fields: [translationId], references: [id], onDelete: Cascade)
  // Vector dim 1024 (Voyage AI voyage-3-lite default). Index HNSW créé via SQL raw migration.
  embedding      Unsupported("vector(1024)")
  model          String                      @db.VarChar(80)
  modelVersion   String                      @map("model_version") @db.VarChar(40)
  dimensionality Int                         @default(1024)
  embeddedAt     DateTime                    @default(now()) @map("embedded_at")

  @@index([model])
  @@map("knowledge_embeddings")
}

/// KB V4 (Sprint KB-13) — Idempotency-key tracking pour factory ingest API.
/// Permet de re-jouer la même requête sans créer de doublon (factory retry safe).
model KnowledgeIngestRequest {
  idempotencyKey String    @id @map("idempotency_key") @db.VarChar(64)
  factoryId      String    @map("factory_id") @db.VarChar(80)
  /// entryId créé en cas de succès (NULL si en cours / échec)
  entryId        String?   @map("entry_id") @db.Uuid
  /// status final : queued | processing | published | rejected | failed
  status         String    @default("queued") @db.VarChar(40)
  rejectReason   String?   @map("reject_reason") @db.Text
  receivedAt     DateTime  @default(now()) @map("received_at")
  completedAt    DateTime? @map("completed_at")

  @@index([factoryId, status])
  @@index([receivedAt])
  @@map("knowledge_ingest_requests")
}

/// KB V4 (Sprint KB-17) — Journal d'audit immuable append-only.
/// Hash-chain SHA-256 sur (prevHash + serializedPayload) pour intégrité forensique.
/// Aucun UPDATE/DELETE autorisé en code applicatif (enforce via policy DB optionnelle V2).
model KnowledgeAuditLog {
  id          BigInt   @id @default(autoincrement())
  /// Type d'événement : ingest_accepted | ingest_rejected | publish | unpublish | edit | kill_switch_engaged | etc.
  eventKind   String   @map("event_kind") @db.VarChar(60)
  /// UUID translation/entry concerné (peut être NULL pour events globaux comme kill_switch)
  entryId     String?  @map("entry_id") @db.Uuid
  /// Acteur : factoryId | userId | "system"
  actor       String   @db.VarChar(120)
  /// Payload JSON sérialisé (snapshot input + résultat)
  payloadJson Json     @map("payload_json")
  /// SHA-256 du précédent log entry (chain). NULL pour le tout premier event.
  prevHash    String?  @map("prev_hash") @db.VarChar(64)
  /// SHA-256(prevHash + canonicalPayload) — vérifiable a posteriori
  selfHash    String   @map("self_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventKind, createdAt])
  @@index([entryId])
  @@index([actor])
  @@map("knowledge_audit_log")
}

/// KB V4 (Sprint KB-14) — Cache LLM auto-SEO/AEO/GEO par traduction.
/// V1 : stub déterministe (provider="stub", providerVersion="v1"). V2 wire OpenAI/Claude.
/// Évite re-paiement LLM sur chaque republish quand contenu inchangé (hash-based invalidation possible V2).
model KnowledgeSeoCache {
  id              String               @id @default(uuid()) @db.Uuid
  translationId   String               @map("translation_id") @db.Uuid
  translation     KnowledgeTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  locale          Locale
  provider        String               @db.VarChar(40)
  providerVersion String               @map("provider_version") @db.VarChar(40)

  /// SEO meta — auto-générée si KnowledgeTranslation.metaTitle/metaDescription vides
  seoTitle       String @map("seo_title") @db.VarChar(70)
  seoDescription String @map("seo_description") @db.VarChar(200)

  /// AEO — array de Q&A extraites pour FAQPage schema.org { question, answer }
  aeoFaqJson Json @map("aeo_faq_json")

  /// GEO — entités géo détectées (regions, villes) pour areaServed JSON-LD
  geoEntitiesJson Json @map("geo_entities_json")

  costCents   Int      @default(0) @map("cost_cents")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([translationId, provider, providerVersion])
  @@index([locale, provider])
  @@map("knowledge_seo_cache")
}

// ============================================================
// CONTENT GENERATOR — Sprint 1 (Sprint S1 Day 1 AGT-A)
// Source : _AUDIT/PROMPT-CONTENT-GENERATOR-MASTER-2026.md (v2.5 post-S0ter)
//          + _AUDIT/SPRINT-1-DAY-BY-DAY.md v2.5
//          + AxionIA_Dossier_FINAL_ABSOLU_v10.1/axionia-megapack-skills/
//            .claude/skills/axionia-content-generator/auto-pilot.md
//
// ⚠️ NE PAS recréer ici les enums KB (KbType, KbDomain, KbAudience, …) ou
// `Locale` / `CompanySize` — ils existent déjà plus haut dans ce schema.
// Le content-gen consomme la KB V4 mergée via les helpers `src/lib/knowledge/*`.
//
// ENUMS ci-dessous (16) : ContentType, ContentGenJobStatus, LogLevel,
// IndexationTier, ExpansionMode, ProviderKey, ProviderRole, ReviewStatus,
// CoverageStatus, CoverageScope, OrganisationType, SearchIntent, TrustTier,
// WebVitalMetric, WebVitalRating. (CompanySize/Locale réutilisés existants.)
// ============================================================

/// 9 types de contenu V1 (§ 5.1 master prompt). Stable DB —
/// ajout de valeur = `ALTER TYPE` non-destructif. À ne PAS confondre
/// avec `KbType` (28 valeurs côté KB V4) — un `ContentType` est
/// mappé vers un `KbType` côté factory ingest (§ 11.0 master prompt).
enum ContentType {
  landing_ville
  blog_article
  blog_from_rss
  blog_from_keywords
  blog_from_title
  comparison
  guide_pilier
  qa_derived
  faq_standalone
  // ─── Sprint v7 Phase 8 — 12 nouveaux content types ────────────────────────
  // Ajoutés par migration 2026-05-23 (v7_phase8_add_12_content_types).
  // Mapping generators dans src/server/content-gen/generators/index.ts.
  long_tail_keyword
  pain_point_solution
  vs_comparator
  alternative_to
  top_x_in_y
  how_to_x_in_y
  best_for_x_in_y
  calculator_roi
  glossary_term
  what_is_x
  faq_geo
  case_study_local
  // ─── Observatoire IA 2026 ─────────────────────────────────────────────────
  // Ajouté par migration observatoire_ia_2026. Générateur d'articles ancrés sur
  // les chiffres réels du BarometerSnapshot ("DONNÉES VÉRIFIÉES").
  // Generator : src/server/content-gen/generators/barometer-insight.ts
  barometer_insight
}

/// 12 statuts pipeline (§ 5.1 + § 27 boucle qualité v1.7).
/// `quality_improving` v1.7 = passage boucle qualité auto si score 40-74.
/// 14 statuts pipeline (§ 5.1 + § 27 boucle qualité v1.7 + P4 sprint P0-7).
/// `quarantined_critical` P4-P0-7 = violation P0 LLM-judge (AI Act, SIREN hardcodé…).
/// `quarantined_factcheck` P4-P0-6 = score fact-check < 50 — revue manuelle.
enum ContentGenJobStatus {
  queued
  running
  generating_text
  generating_image
  running_qa
  quality_improving
  needs_review
  approved
  publishing
  published
  failed
  cancelled
  quarantined_critical
  quarantined_factcheck
}

/// Niveaux de log applicatifs côté workers content-gen.
enum LogLevel {
  debug
  info
  warn
  error
}

/// Pyramide d'indexation 3-tiers anti-doorway HCU 2024 (§ 6 PROMPT-CONTENT-FACTORY-SPEC).
/// Default applicatif : `tier_2_noindex_follow` (sécurité bulk).
enum IndexationTier {
  tier_1_indexable
  tier_2_noindex_follow
  tier_3_noindex_nofollow
}

/// Modes d'expansion d'un ContentTemplate (parité SOS-Expat). 8 valeurs.
enum ExpansionMode {
  manual
  all_villes
  all_regions
  custom_villes
  from_keywords
  from_questions
  from_rss_items
  from_csv
}

/// 5 providers IA externes pilotables depuis l'admin (toggles + cost caps).
/// `gpt_image` réservé V2 (Q4 v2.0 acté Will : Unsplash uniquement V1).
enum ProviderKey {
  openai
  anthropic
  perplexity
  unsplash
  gpt_image
}

/// Rôle joué par un provider dans le routeur (§ 7.1).
/// Un même ProviderKey peut couvrir plusieurs rôles via plusieurs ProviderConfig rows.
enum ProviderRole {
  text
  image
  data
  stock_image
  rerank
}

/// Statut review queue (§ 14). `promoted_t1` = passé tier-1 via Will.
enum ReviewStatus {
  pending
  approved
  rejected
  needs_edits
  promoted_t1
}

/// Statut campagne de couverture territoriale (§ 25.2 v1.7).
enum CoverageStatus {
  draft
  queued
  running
  paused
  completed
  failed
  cancelled
  scheduled
}

/// Mode de traitement des villes dans une campagne (§ 25.2 v1.8 Sprint Campaign Controls).
/// `parallel` : toutes les villes simultanément (défaut, comportement antérieur).
/// `sequential` : ville par ville dans l'ordre sélectionné (currentCityIndex trace la progression).
enum CityProcessingMode {
  parallel
  sequential
}

/// Mode scope villes pour une campagne (Sprint v7 Phase 1 — D3 prompt 2026-05-23).
/// `global_queue` : la campagne consomme la file CityGenerationOrder partagée
/// (ordre rank ascendant, modifiable depuis `/content-gen/cities-order`).
/// `custom_subset` : sous-ensemble explicite de villeSlugs renseigné via
/// CoverageCampaign.customVilleSlugs (wizard step 2 drag-and-drop).
enum VilleScopeMode {
  global_queue
  custom_subset
}

/// Mode mix contenu pour une campagne (Sprint v7 Phase 1 — D8 prompt 2026-05-23).
/// `percentage` : sliders 0-100 par contentType, sum = 100% (distribute by weight).
/// `manual` : quotas absolus par contentType (Int count, override % entièrement).
enum MixMode {
  percentage
  manual
}

/// Mode « ville & alentours » pour une campagne multi-axes (2026-06-21).
/// `none` : uniquement les villes du scope (comportement historique).
/// `radius` : étend chaque ville d'ancrage aux communes dans un rayon
///   (villeSurroundingRadiusKm, défaut 50 km) via geo.ts getNearbyVilles.
/// `same_departement` : étend aux communes du même département.
enum VilleSurroundingMode {
  none
  radius
  same_departement
}

/// Mode de durée d'une campagne multi-axes (2026-06-21).
/// `fixed` : s'arrête quand totalTargetCount est atteint (ou endDate).
/// `unlimited` : tourne en continu jusqu'à arrêt manuel (pause/stop) ou endDate ;
///   totalTargetCount n'est PAS un critère de complétion.
enum DurationMode {
  fixed
  unlimited
}

/// Phase démarrage progressif (Sprint v7 Phase 9 — D16 prompt 2026-05-23).
/// `phase_a` : pilote 1 verticale x 39 villes pilotes (mois 1-3).
/// `phase_b` : 5 verticales x 39 villes pilotes (mois 4-6).
/// `phase_c` : 5 verticales x 200 villes T1+T2 (mois 7-12).
/// `phase_d` : 5 verticales x 2150 villes (mois 13-24, nationale).
/// Transitions gated par worker `phase-transition-monitor.ts` (Phase 9).
enum ExpansionPhase {
  phase_a
  phase_b
  phase_c
  phase_d
}

/// Périmètre d'une campagne (§ 25.2 v1.7).
enum CoverageScope {
  ville
  departement
  region
  multi
}

/// 12 types d'organisation cible (§ 25 v1.7 — audience mix).
/// `autre` = fallback explicite (jamais NULL côté `targetAudienceOrganisation`).
enum OrganisationType {
  entreprise_privee
  ecole
  universite
  mairie
  collectivite
  hopital
  association
  comite_entreprise
  opco
  carsat
  etablissement_public
  autre
}

/// 5 intentions de recherche (§ 26 v1.7) — pilier doctrine.
/// `navigational` dans l'enum pour exhaustivité, auto-exclu des campagnes
/// (cf. § 26.4 — distribution par défaut 0 %).
/// Phase D Sprint Perfection 2026-05-22 : +3 intents 2026 best-practice.
enum SearchIntent {
  informational
  commercial_investigation
  transactional
  navigational
  local
  voice_search // conversationnel Alexa/Siri/Google Assistant
  ai_overview // optimise Google AI Overview / SGE factuel
  featured_snippet // position 0 paragraph 40-60 mots
}

/// 5 niveaux de confiance des sources externes (§ 9bis.5bis v2.2).
/// Driver de pondération du `seoScore` et du JSON-LD `Article.citation[]`.
enum TrustTier {
  official
  high
  standard
  low
  excluded
}

/// 6 métriques Web Vitals (§ 9.10 + references/web-vitals-integration.md).
/// Couvre Lighthouse `performance` audit (Sprint 1 Day 3 quality gate).
enum WebVitalMetric {
  LCP
  INP
  CLS
  FCP
  TTFB
  TBT
}

/// Rating Web Vitals selon seuils Google CrUX (good / needs improvement / poor).
enum WebVitalRating {
  good
  needs_improvement
  poor
}

// ============================================================
// CONTENT GENERATOR — Modèles (§ 5.1 + § 9bis.5bis + § 12.1bis + § 25 + § 28 + § 29)
// Sprint S1 Day 1 AGT-A 2/N (2026-05-14).
//
// FK Article/FAQ : @db.Uuid (compat existant). FK content-gen internes : cuid() String.
// `generatedByJobId` sur Article/FAQ pointe vers ContentGenJob.id (cuid) — String simple.
// ============================================================

/// Config globale content-gen (toggles, daily targets, seuils éditables).
model ContentGenConfig {
  id          String   @id @default(cuid())
  key         String   @unique // "daily_target_blog" | "kill_switch" | …
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("content_gen_config")
}

/// City Domination 2026-05-18 P1-9 (audit A10) — Audit trail SOC2 immuable
/// pour toute modification de ContentGenConfig + autres settings admin
/// content-gen. Append-only : pas d'UPDATE/DELETE exposés via le helper
/// `writeContentGenConfig`. Chaque écriture de setting déclenche une ligne
/// avec diff oldValue → newValue.
///
/// Conservation : append-only sans purge automatique (legal hold SOC2).
/// Si volume devient critique (≥ 1M rows), purge cron par retention-purge-
/// worker.ts (à brancher Phase 2 si besoin).
model ContentGenAuditLog {
  id          String   @id @default(cuid())
  /// Action canonique : "writeContentGenConfig" | "updateBatchSettings" | "..."
  action      String   @db.VarChar(64)
  /// Clé du setting modifié (correspond à ContentGenConfig.key). Nullable
  /// pour les actions qui ne ciblent pas un setting unique.
  settingKey  String?  @map("setting_key") @db.VarChar(128)
  /// Valeur avant modification (NULL si création initiale).
  oldValue    Json?    @map("old_value")
  /// Valeur après modification (NULL si suppression — futur).
  newValue    Json?    @map("new_value")
  /// ID admin qui a déclenché l'action (NULL si action système / worker).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Email admin pour audit forensique (dénormalisé pour lecture rapide).
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  /// IP source pour audit forensique (hashée si IP_HASH_SALT actif).
  actorIp     String?  @map("actor_ip") @db.VarChar(64)
  /// User-Agent source pour audit forensique (tronqué 500c).
  actorUa     String?  @map("actor_ua") @db.VarChar(500)
  /// Description libre éditoriale (optional, propagé depuis writeContentGenConfig).
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([settingKey, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("content_gen_audit_log")
}

/// 1 row par provider IA (toggles, modèles, cost caps, fallback). Pilotable admin.
model ProviderConfig {
  id                   String       @id @default(cuid())
  provider             ProviderKey  @unique
  enabled              Boolean      @default(true)
  primary              Boolean      @default(false) // 1 primary par role
  role                 ProviderRole
  model                String // "gpt-4o" / "claude-sonnet-4-6" / "sonar" / …
  fallbackProviderId   String?
  monthlyCapUsd        Decimal      @db.Decimal(10, 2)
  currentMonthSpentUsd Decimal      @default(0) @db.Decimal(10, 2)
  rateLimitRpm         Int?
  rateLimitTpm         Int?
  apiKeyEnvVar         String // "OPENAI_API_KEY"
  extraConfig          Json?
  updatedAt            DateTime     @updatedAt

  @@map("provider_config")
}

/// Templates prompts versionnés + expansion modes (parité SOS-Expat).
model ContentTemplate {
  id                 String      @id @default(cuid())
  slug               String      @unique // "landing-ville-v2", "blog-from-rss-v1"
  contentType        ContentType
  variant            String? // "default" | "secteur-industrie" | …
  version            Int         @default(1)
  isActive           Boolean     @default(true)
  name               String
  description        String?
  systemPrompt       String      @db.Text
  userPromptTemplate String      @db.Text // mustache-like {{var}}
  outputSchemaZod    String      @db.Text // Zod schema sérialisé
  variables          Json // schéma variables d'entrée

  expansionMode   ExpansionMode @default(manual)
  expansionValues Json? // array selon mode (villeSlugs[], keywords[], …)
  totalItems      Int           @default(0)
  generatedItems  Int           @default(0)
  publishedItems  Int           @default(0)
  failedItems     Int           @default(0)

  defaultModel       String?
  defaultTemperature Decimal? @db.Decimal(3, 2)
  defaultMaxTokens   Int?
  estimatedCostUsd   Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  jobs    ContentGenJob[]
  history ContentTemplateHistory[]

  @@index([contentType, isActive])
  @@map("content_templates")
}

/// Versionnage des prompts ContentTemplate (snapshot historique des champs prompt/model).
/// Additif : 1 row par version éditée d'un template. Lecture seule côté audit/rollback.
model ContentTemplateHistory {
  id                 String          @id @default(cuid())
  templateId         String          @map("template_id")
  template           ContentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version            Int
  systemPrompt       String?         @map("system_prompt") @db.Text
  userPromptTemplate String?         @map("user_prompt_template") @db.Text
  outputSchemaZod    String?         @map("output_schema_zod") @db.Text
  model              String?
  defaultTemperature Decimal?        @map("default_temperature") @db.Decimal(3, 2)
  defaultMaxTokens   Int?            @map("default_max_tokens")
  changedBy          String?         @map("changed_by")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([templateId, version])
  @@index([templateId])
  @@map("content_template_history")
}

/// Auteur canonique (Manon V1). Lu par buildPersonManonJsonLd() (slug guard).
/// v2.1 : aiGenerated + photoAlt + isPersona + personaDisclaimer pour transparence IA.
model AuthorProfile {
  id                String   @id @default(cuid())
  slug              String   @unique // "manon"
  displayName       String
  jobTitle          String
  bioMd             String   @db.Text
  photoUrl80        String
  photoUrl256       String
  photoUrl1024      String
  photoAlt          String? // v2.1 — alt text canonique
  aiGenerated       Boolean  @default(false) // v2.1 — flag transparence IA
  linkedinUrl       String? // null systématique Manon (doctrine v2.1)
  twitterHandle     String? // null systématique Manon (twitter:creator omis)
  alumniOf          String? // null persona fictive
  awards            String[] @default([])
  knowsAbout        String[] @default([])
  isPersona         Boolean  @default(false) // v2.0
  personaDisclaimer String? // v2.0 + v2.1 — disclaimer IA enrichi
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("author_profiles")
}

/// Phrases interdites (doctrine § 21 + § 25). CRUD admin /settings/banned-phrases.
model BannedPhrase {
  id        String   @id @default(cuid())
  pattern   String   @unique // "le meilleur" / "révolutionnaire" / "ADN" / regex…
  reason    String?
  /// "warn" (log) | "block" (rejet doctrine-check)
  severity  String   @default("warn") @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banned_phrases")
}

/// Secteur métier Axion-IA (§ 25.3 — 3 piliers cabinet).
/// `interventions_formations` fusionne interventions opérationnelles + formations
/// (cibles audience similaires : opérateurs terrain + montée en compétence équipe).
/// `audits` = diagnostics flash/essentiel/approfondi. `implementations` = projets
/// IA custom + intégrations. `landing_ville` et `blog_from_rss` ne portent PAS
/// de secteur (pipelines indépendants).
enum ServiceSector {
  interventions_formations
  audits
  implementations
  un_a_un
  sites_web_augmentes
}

/// Profil distribution % par ContentType pour campagnes (§ 25.2 v1.7).
/// distribution Json validé Zod somme = 100 %.
/// `serviceSector` optionnel : si renseigné, profil dédié à 1 secteur (utilisé
/// par le seeder pour pré-équiper interventions/audits/implementations).
model CoverageDistributionProfile {
  id            String         @id @default(cuid())
  slug          String         @unique // "mix-premium-2026" / "mix-industrie" / "mix-tertiaire"
  name          String
  description   String?
  distribution  Json // { blog_from_title: 30, blog_from_keywords: 25, … } somme = 100
  isDefault     Boolean        @default(false)
  serviceSector ServiceSector?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([serviceSector])
  @@map("coverage_distribution_profiles")
}

/// Profil mix audience (taille INSEE × type organisation) % (§ 25.2 v1.7).
/// mix Json validé Zod somme = 100 % sur clé "<SIZE>:<ORG_TYPE>".
model AudienceMixProfile {
  id          String   @id @default(cuid())
  slug        String   @unique // "mixte-equilibre" / "tertiaire-urbain" / "industriel-regional" / "public-parapublic"
  name        String
  description String?
  mix         Json // { "PME:entreprise_privee": 40, "TPE:entreprise_privee": 20, … }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("audience_mix_profiles")
}

/// Campagne de couverture territoriale (§ 25.2 v1.7).
/// 1 campagne = N jobs ContentGenJob exécutés selon distribution + audience mix + intent mix.
model CoverageCampaign {
  id                       String             @id @default(cuid())
  name                     String
  status                   CoverageStatus     @default(draft)
  scope                    CoverageScope
  // Secteur métier (interventions_formations / audits / implementations) —
  // optionnel pour rétro-compat des campagnes pré-2026-05-16. Les nouvelles
  // campagnes éditoriales DOIVENT renseigner le secteur (validé Server Action).
  // Les campagnes landing_ville pures peuvent rester NULL.
  serviceSector            ServiceSector?
  anchorVilleSlugs         String[]           @default([])
  anchorDepartementCodes   String[]           @default([])
  anchorRegionSlugs        String[]           @default([])
  totalTargetCount         Int
  typeDistribution         Json
  audienceMix              Json
  searchIntentMix          Json?
  estimatedCostUsd         Decimal?           @db.Decimal(10, 2)
  estimatedDurationMinutes Int?
  generatedCount           Int                @default(0)
  publishedCount           Int                @default(0)
  failedCount              Int                @default(0)
  qualityImprovedCount     Int                @default(0)
  // Sprint Campaign Controls (§ 25.2 v1.8 2026-05-22) — 4 capabilities
  cityProcessingMode       CityProcessingMode @default(parallel) @map("city_processing_mode")
  currentCityIndex         Int?               @map("current_city_index")
  startDate                DateTime?          @map("start_date")
  endDate                  DateTime?          @map("end_date")
  recurringSchedule        String?            @map("recurring_schedule")
  completedReason          String?            @map("completed_reason")

  // Sprint v7 Phase 1 (2026-05-23) — refonte wizard + parallel campaigns.
  // `dailyArticles` : volume articles/jour configurable per-campaign (1..1000,
  // déprécie le setting global `batches.dailyBatchSize`). Orchestrator
  // répartit ce budget sur les villes du scope selon mixMode.
  dailyArticles      Int             @default(30) @map("daily_articles")
  // `villeScopeMode` : choisir entre file globale CityGenerationOrder ou
  // sous-ensemble customVilleSlugs[] (wizard step 2 drag-and-drop).
  villeScopeMode     VilleScopeMode  @default(global_queue) @map("ville_scope_mode")
  // `customVilleSlugs` : utilisé uniquement si villeScopeMode = custom_subset.
  // Sinon [] et la campagne consomme la file globale (ordre rank ascendant).
  customVilleSlugs   String[]        @default([]) @map("custom_ville_slugs")
  // `mixMode` : sliders % ou quotas absolus (cf. enum MixMode).
  mixMode            MixMode         @default(percentage) @map("mix_mode")
  // `contentTypeWeights` : sliders 0-100 par ContentType (mode percentage,
  // sum = 100%) OU quotas Int par ContentType (mode manual, sum libre).
  // Forme: { "blog_article": 10, "qa_individual": 15, ... } (clés = enum ContentType).
  // Validation Zod côté server action (cf. wizard Phase 3).
  contentTypeWeights Json?           @map("content_type_weights")
  // `expansionPhase` : phase démarrage progressif (Phase 9). NULL = pas
  // gated par phase (campagnes legacy ou manuelles hors roadmap progressive).
  expansionPhase     ExpansionPhase? @map("expansion_phase")

  // ── Campagnes multi-axes (2026-06-21) ──────────────────────────────────────
  // Tous additifs/optionnels → rétro-compat totale des campagnes existantes
  // (NULL = comportement historique préservé par les fallbacks orchestrateur).
  //
  // `serviceSectorWeights` (axe 2) : pondération % des 5 ACTIVITÉS Axion-IA
  // échantillonnée par job. Forme { "audits": 50, "implementations": 50 }
  // (clés = enum ServiceSector). NULL → fallback sur le singleton `serviceSector`.
  serviceSectorWeights     Json?                @map("service_sector_weights")
  // `targetSecteurWeights` (axe 3) : pondération % des SECTEURS CLIENT
  // (sante/BTP/juridique…). Forme { "juridique": 60, "sante_medecine": 40 }
  // (clés = ClientSectorSlug, cf. src/content/sectors.ts). Échantillonné par job
  // → pose inputPayload.targetSecteur (réveille la pain-matrix). NULL → pas de
  // ciblage secteur (augmentation pain-matrix no-op, comportement historique).
  targetSecteurWeights     Json?                @map("target_secteur_weights")
  // `villeSurroundingMode` (axe 6) : étend le scope ville aux alentours.
  villeSurroundingMode     VilleSurroundingMode @default(none) @map("ville_surrounding_mode")
  // `villeSurroundingRadiusKm` : rayon en km si villeSurroundingMode = radius.
  // NULL traité comme 50 km par l'orchestrateur.
  villeSurroundingRadiusKm Int?                 @map("ville_surrounding_radius_km")
  // `durationMode` (axe 8) : fixed (s'arrête à totalTargetCount) ou unlimited
  // (tourne jusqu'à arrêt manuel / endDate).
  durationMode             DurationMode         @default(fixed) @map("duration_mode")

  startedAt   DateTime?
  pausedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?
  // Archivage explicite réversible (2026-07-03) — orthogonal au statut : archiver
  // masque une campagne de la vue par défaut (réduction du bruit) SANS changer son
  // statut, et le désarchivage la restaure telle quelle. Distinct de cancelled
  // (terminal irréversible) et de la suppression définitive (hard delete).
  archivedAt  DateTime?

  jobs ContentGenJob[]

  @@index([status, createdAt(sort: Desc)])
  @@index([serviceSector, status])
  // Sprint v7 Phase 9 — index pour worker phase-transition-monitor (lookup
  // campagnes par phase courante, groupage transition).
  @@index([expansionPhase, status])
  // Vue liste : filtre archivedAt (null = actives, non-null = archivées).
  @@index([archivedAt])
  @@map("coverage_campaigns")
}

/// File globale ordre génération villes (Sprint v7 Phase 1 — D3 prompt 2026-05-23).
///
/// 1 ligne = 1 ville indexable (cible : 2150 villes FR métropole + DROM).
/// `rank` = position dans la file consommée par les campagnes en mode
/// `villeScopeMode='global_queue'`. Géré via page admin `/content-gen/cities-order`
/// (drag-and-drop virtualisé + filtres + recherche debounce 150ms).
///
/// Champs dénormalisés (regionSlug, deptCode, tier, pop) : permettent les
/// filtres + tri admin sans JOIN runtime côté Ville (TS hardcode). Re-sync
/// scriptable via `scripts/seed-city-generation-order.ts` quand `src/content/villes/`
/// est mis à jour.
///
/// `pinned` : épingle la ville en top de file (avant tous les autres ranks).
/// Use case : Will force Paris/Lyon en priorité pendant la campagne audits Q1.
/// Plusieurs villes pinned coexistent — leur ordre relatif suit `pinnedAt DESC`
/// (dernière épinglée en premier).
model CityGenerationOrder {
  villeSlug  String    @id @map("ville_slug")
  rank       Int       @unique
  pinned     Boolean   @default(false)
  pinnedAt   DateTime? @map("pinned_at")
  // Champs dénormalisés depuis src/content/villes (TS hardcode SSOT).
  // Resync via script. Permet filtres/tri admin sans JOIN.
  regionSlug String    @map("region_slug")
  deptCode   String    @map("dept_code")
  tier       String // "T1" | "T2" | "T3" | "T4" — pas d'enum pour rester flex
  pop        Int // population INSEE
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([rank])
  @@index([pinned, pinnedAt(sort: Desc)])
  @@index([regionSlug, rank])
  @@index([deptCode, rank])
  @@index([tier, rank])
  @@map("city_generation_order")
}

/// Job content-gen unique. Pivot des pipelines (§ 5.1 + § 25 + § 26 + § 27).
/// targetSearchIntent NOT NULL (pilier doctrine v1.7).
/// targetKnowledgeEntryId/kbIngestStatus/kbRejectReason : audit trail KB ingest (S0ter).
model ContentGenJob {
  id             String              @id @default(cuid())
  idempotencyKey String              @unique // hash(type + input + templateId)
  contentType    ContentType
  status         ContentGenJobStatus @default(queued)
  priority       Int                 @default(5)
  templateId     String?
  template       ContentTemplate?    @relation(fields: [templateId], references: [id])

  // Campagne parente (optionnelle — pipeline 1 landing direct + pipeline 2 RSS = null)
  campaignId String?
  campaign   CoverageCampaign? @relation(fields: [campaignId], references: [id])

  // Secteur de service propagé depuis la campagne (ou l'enqueue direct) →
  // détermine la catégorie de blog de l'article au publish (categorization).
  serviceSector ServiceSector? @map("service_sector")

  // Inputs
  inputPayload Json
  targetLocale Locale @default(fr)

  // Géo (au moins 1 rempli si pipeline 1/3 — null si pipeline 2 RSS pur)
  anchorVilleSlug       String?
  anchorDepartementCode String?
  anchorRegionSlug      String?

  // Audience cible (§ 25 v1.7)
  targetAudienceSize         CompanySize?
  targetAudienceOrganisation OrganisationType?

  // Pilier doctrine v1.7 (NOT NULL — la migration utilisera default `informational`
  // pour les éventuelles lignes legacy à la migration data).
  targetSearchIntent SearchIntent @default(informational)

  // Provider routing
  primaryProvider  ProviderKey
  fallbackProvider ProviderKey?
  modelUsed        String?

  // Execution
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  retryCount   Int       @default(0)
  errorMessage String?   @db.Text

  // Outputs (Article.id est Uuid — FK String @db.Uuid)
  outputBlogPostId    String?  @db.Uuid
  outputVilleCopyPath String?
  outputFaqIds        String[] @default([])
  outputQaIds         String[] @default([])
  outputJsonRaw       Json?

  // Quality
  qualityScore        Int?
  plagiarismScore     Decimal? @db.Decimal(5, 2)
  readabilityScore    Decimal? @db.Decimal(5, 2)
  doctrineCheckPassed Boolean?
  seoScore            Int?
  /// Sprint A-suite P6 — Item 4. Score fact-check (0-100) posé par le fact-check
  /// worker. Null = fact-check pas encore run. Gate publication dans publish-worker.
  factCheckScore      Int?     @map("fact_check_score")
  /// Score du juge LLM (0-100) posé par le quality-improver. Null = juge pas encore
  /// passé (ou indisponible). Recopié sur Article.editorialScore à la publication.
  editorialScore      Int?     @map("editorial_score")

  // Boucle qualité v1.7 (§ 27)
  qualityImprovementAttempts Int @default(0)

  // KB V4 audit trail (S0ter — § 11.1 master prompt v2.5)
  /// KnowledgeEntry.id est @db.Uuid côté KB V4
  targetKnowledgeEntryId String? @db.Uuid
  kbIngestStatus         String? @db.VarChar(40)
  kbRejectReason         String? @db.VarChar(200)

  // Cost
  tokensInput   Int?
  tokensOutput  Int?
  imageCount    Int?
  costUsd       Decimal? @db.Decimal(10, 4)
  costBreakdown Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  /// Sprint A-suite P6 — Item 3. Traçabilité end-to-end entre orchestrateur,
  /// gen-worker et publish-worker. UUID v4 généré à la création du job par
  /// l'orchestrateur et propagé dans les logs de chaque worker.
  correlationId String? @map("correlation_id") @db.VarChar(36)

  logs        GenerationLog[]
  reviewQueue ReviewQueue?
  citations   ContentCitation[]

  @@index([status, createdAt(sort: Desc)])
  @@index([contentType, status])
  @@index([campaignId, status])
  @@index([anchorVilleSlug])
  @@map("content_gen_jobs")
}

/// Logs détaillés par étape de pipeline. Persistés pour audit + replay.
/// Stream SSE realtime via Redis pub/sub (cf. § 12.4).
model GenerationLog {
  id        String        @id @default(cuid())
  jobId     String
  job       ContentGenJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     LogLevel      @default(info)
  step      String // "kb_retrieve" | "llm_call" | "image_gen" | "validation" | …
  message   String        @db.Text
  metadata  Json?
  timestamp DateTime      @default(now())

  @@index([jobId, timestamp])
  @@index([level, timestamp])
  @@map("generation_logs")
}

/// Review queue manuelle (default tier-2 → tier-1 par Will).
/// promotedToTier1At = promotion explicite Will via admin.
model ReviewQueue {
  id                String        @id @default(cuid())
  jobId             String        @unique
  job               ContentGenJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status            ReviewStatus  @default(pending)
  reviewedBy        String?
  reviewNotes       String?       @db.Text
  reviewedAt        DateTime?
  promotedToTier1At DateTime?
  createdAt         DateTime      @default(now())

  @@index([status, createdAt])
  @@map("review_queue")
}

/// Sources RSS persistées (Sprint S+5 P2-3 — migration `ContentGenConfig.key="rss_sources"` JSON inline → table dédiée).
///
/// V1 transitoire (JSON inline) avait pour limite : pas d'index DB, pas de
/// failure tracking par source, pas de scoping verticale, pas de last-success
/// tracking → impossible d'auditer la santé des feeds individuellement.
///
/// V1.5 (cette table) : 1 row par source. Le worker `content-rss-fetch-worker`
/// lit depuis `RssSource` (avec fallback ContentGenConfig 1 release pour
/// rétro-compat). Seeder `prisma/seeds/rss-sources.ts` migre depuis le JSON
/// existant au runtime.
///
/// Verticale : slug parmi `interventions`, `audit`, `implementations`, `un_a_un`
/// (= les 4 verticales canoniques Axion-IA). Nullable car certains feeds sont
/// transverses (ex : actualités IA générales applicables aux 4 verticales).
model RssSource {
  id              String    @id @default(cuid())
  url             String    @unique @db.VarChar(500)
  name            String    @db.VarChar(200)
  enabled         Boolean   @default(true)
  /// Slug verticale Axion-IA — `interventions` | `audit` | `implementations` | `un_a_un`.
  /// Nullable pour feeds transverses (actualités IA généralistes).
  verticale       String?   @db.VarChar(40)
  /// Tags éditoriaux libres (transmis aux generators content-gen).
  tags            Json      @default("[]")
  /// Intervalle polling (5-1440 min, validé côté Server Action).
  pollIntervalMin Int       @default(60) @map("poll_interval_min")
  /// Si true, articles auto-publiés au-dessus du seuil qualité (sinon review queue).
  autoPublish     Boolean   @default(false) @map("auto_publish")
  language        String    @default("fr") @db.VarChar(5)
  lastFetchedAt   DateTime? @map("last_fetched_at")
  lastSuccessAt   DateTime? @map("last_success_at")
  failureCount    Int       @default(0) @map("failure_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([enabled, lastFetchedAt])
  @@index([verticale])
  @@map("rss_sources")
}

/// Web Vitals RUM (Real User Monitoring) — collectés via /api/rum.
/// pageType : "landing-ville" | "blog" | "guide" | "faq" | …
/// knowledgeEntryId : FK optionnelle si la page provient d'une entry KB
model WebVitalSample {
  id               String         @id @default(cuid())
  url              String // pathname canonique
  metric           WebVitalMetric
  value            Float // ms ou unitless (CLS)
  rating           WebVitalRating
  navigationType   String? // navigate|reload|back-forward
  deviceType       String? // mobile|desktop|tablet
  userAgent        String?        @db.Text
  sessionId        String? // anonyme, généré client
  pageType         String?        @db.VarChar(40)
  /// KnowledgeEntry.id est @db.Uuid côté KB V4
  knowledgeEntryId String?        @db.Uuid
  createdAt        DateTime       @default(now())

  @@index([url, metric, createdAt(sort: Desc)])
  @@index([pageType, metric, createdAt(sort: Desc)])
  @@map("web_vital_samples")
}

/// Ledger de coût atomique par appel provider. Source de vérité cost cap.
model CostLedger {
  id           String      @id @default(cuid())
  jobId        String?
  provider     ProviderKey
  model        String
  tokensInput  Int         @default(0)
  tokensOutput Int         @default(0)
  costUsd      Decimal     @db.Decimal(10, 4)
  timestamp    DateTime    @default(now())

  @@index([provider, timestamp])
  @@index([jobId])
  @@map("cost_ledger")
}

/// Métriques agrégées par jour × type × provider (dashboard /content-gen).
model ContentMetric {
  id                String       @id @default(cuid())
  date              DateTime     @db.Date
  contentType       ContentType
  provider          ProviderKey?
  generated         Int          @default(0)
  published         Int          @default(0)
  failed            Int          @default(0)
  needsReview       Int          @default(0)
  duplicatesBlocked Int          @default(0)
  totalCostUsd      Decimal      @default(0) @db.Decimal(10, 4)
  totalTokensInput  BigInt       @default(0)
  totalTokensOutput BigInt       @default(0)
  avgQualityScore   Decimal?     @db.Decimal(5, 2)

  @@unique([date, contentType, provider])
  @@map("content_metrics")
}

/// Sources externes citées (Wikipedia, INSEE, LMI, …) — table dédiée v2.2.
/// Centralisée pour réutilisation + audit + pondération via TrustTier (§ 9bis.5bis).
model ExternalReference {
  id              String    @id @default(cuid())
  url             String    @unique
  title           String
  publisher       String?
  publisherDomain String
  trustTier       TrustTier @default(standard)
  language        Locale    @default(fr)
  description     String?   @db.Text
  publishedAt     DateTime?
  lastVerifiedAt  DateTime? // V2 — link-checker cron
  isAlive         Boolean   @default(true)
  citationCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  citations ContentCitation[]

  @@index([trustTier, language])
  @@index([publisherDomain])
  @@map("external_references")
}

/// Citation insérée dans un Article ou un ContentGenJob (avant publication).
/// articleId XOR jobId (l'un ou l'autre, pas les deux à la fois en pratique).
model ContentCitation {
  id                  String            @id @default(cuid())
  /// Article.id est @db.Uuid
  articleId           String?           @db.Uuid
  jobId               String?
  job                 ContentGenJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  externalReferenceId String
  externalReference   ExternalReference @relation(fields: [externalReferenceId], references: [id])
  citationContext     String            @db.Text
  anchorText          String
  createdAt           DateTime          @default(now())

  @@index([articleId])
  @@index([externalReferenceId])
  @@index([jobId])
  @@map("content_citations")
}

/// Sprint 12 V2 — KeywordTracking : suivi positions + CTR par mot-clé.
/// Alimenté par cron hebdo (GSC API + SerpAPI). Permet de détecter :
///  - mots-clés tier-1 candidates (CTR > 5 % stable)
///  - gaps (mots-clés rankant 11-20 → opportunité tier-1 promote article)
///  - cannibalization (plusieurs articles sur même mot-clé)
model KeywordTracking {
  id                   String                @id @default(cuid())
  keyword              String                @db.VarChar(255)
  /// URL ciblée (page qui rank). Match Article via slug ou KnowledgeEntry.
  targetUrl            String                @db.VarChar(512)
  /// Article.id (UUID) si la page tracked est un Article — sinon null.
  articleId            String?               @db.Uuid
  /// Position SERP Google (1 = top). Float pour moyenne pondérée.
  position             Decimal               @db.Decimal(5, 2)
  /// Variation position vs dernier sync (delta). + = recule, - = monte.
  positionDelta        Decimal?              @db.Decimal(5, 2)
  /// CTR observé (0-1). null si pas encore d'impressions.
  ctr                  Decimal?              @db.Decimal(6, 4)
  /// Impressions sur fenêtre (default 28j GSC).
  impressions          Int                   @default(0)
  /// Clicks sur fenêtre.
  clicks               Int                   @default(0)
  /// Source de mesure.
  source               KeywordTrackingSource @default(gsc)
  /// Date du dernier sync (run du worker hebdo).
  syncedAt             DateTime              @default(now())
  /// Date première détection de ce keyword pour cette URL.
  firstSeenAt          DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // Phase 8 Sprint Keywords Perfection 2026-05-22 — intelligence concurrentielle
  /// URL du concurrent actuellement en position 1 pour ce keyword.
  competitorTopUrl     String?               @map("competitor_top_url") @db.VarChar(512)
  /// Nom du concurrent en position 1 (ex: "axionai.fr", "Capgemini", "Cegos").
  competitorTopName    String?               @map("competitor_top_name") @db.VarChar(100)
  /// Tags faiblesses observées chez le concurrent (ex: ["thin_content", "no_schema"]).
  competitorWeaknesses String[]              @default([]) @map("competitor_weaknesses")
  /// Niveau d'opportunité calculé : 'high' | 'medium' | 'low'.
  axionOpportunity     String?               @map("axion_opportunity") @db.VarChar(10)
  /// Action recommandée pour dominer ce keyword (ex: "Pilier 3000 mots + FAQ schema").
  recommendedAction    String?               @map("recommended_action") @db.Text
  /// Date à laquelle Axion-IA est entré dans le top 10 pour ce keyword.
  ourFirstRankAt       DateTime?             @map("our_first_rank_at")
  /// Meilleur rank atteint (1 = position 1). null si jamais rankés.
  ourBestRank          Int?                  @map("our_best_rank")
  /// Rang actuel observé. null si non suivi.
  ourCurrentRank       Int?                  @map("our_current_rank")
  /// Tendance de position sur 7 jours : 'up' | 'down' | 'stable'.
  trendDirection       String?               @map("trend_direction") @db.VarChar(10)

  @@unique([keyword, targetUrl])
  @@index([articleId])
  @@index([syncedAt])
  @@index([position])
  @@index([axionOpportunity])
  @@map("keyword_tracking")
}

enum KeywordTrackingSource {
  gsc
  serpapi
  manual
}

/// B.5 P1.5 — Seeds keywords connectes au pipeline content-gen.
/// 747 seeds pre-charges via prisma/seeds/content-gen/keyword-seeds.ts.
/// Rotation equitable par vertical + lastUsedAt (lock atomique anti-doublon).
model Keyword {
  id             String    @id @default(cuid())
  term           String    @unique @db.VarChar(255)
  termNormalized String    @map("term_normalized") @db.VarChar(255)
  vertical       String    @db.VarChar(60)
  searchIntent   String?   @map("search_intent") @db.VarChar(40)
  isLongTail     Boolean   @default(false) @map("is_long_tail")
  isLocal        Boolean   @default(false) @map("is_local")
  cityIds        String[]  @default([]) @map("city_ids")
  searchVolume   Int?      @map("search_volume")
  difficulty     Int?
  clusterId      String?   @map("cluster_id") @db.VarChar(60)
  usageCount     Int       @default(0) @map("usage_count")
  lastUsedAt     DateTime? @map("last_used_at")
  campaignId     String?   @map("campaign_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([vertical])
  @@index([usageCount, lastUsedAt])
  @@index([clusterId])
  @@index([campaignId])
  @@map("keywords")
}

// ============================================================
// IMAGE BANK V1 (Sprint 1 — feat/image-bank-v1)
// ============================================================
// Doctrine :
//   - FR canonique, EN miroir (PAS 9 langues comme SOS-Expat)
//   - Stockage local dev (public/image-bank/) ou S3/Hetzner (prod) — PAS de hotlinks
//   - License par défaut CC BY 4.0 (enum éditable admin)
//   - Geo-targeting via ISO codes (target_countries jsonb)
//   - Copyright holder = Axion-IA (SAS française ; jamais « OÜ », cf. resolveCopyrightHolder)
//   - 10 tables : Country (prérequis) + 8 image-bank core + ImageDownloadLog + ImageImportBatch
// Refs :
//   - .claude/skills/axionia-image-bank/references/prisma-schema.md
//   - .claude/skills/axionia-image-bank/prompts/stop-and-ask-decisions.md
// ============================================================

/// Country (PRÉREQUIS image-bank) — seedé depuis REST Countries API (~249 lignes).
/// Utilisé par image-country-detector.service.ts pour résoudre nom → ISO code.
model Country {
  isoCode   String   @id @map("iso_code") @db.VarChar(2)
  iso3      String?  @unique @db.VarChar(3)
  nameFr    String   @map("name_fr") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  slugFr    String   @map("slug_fr") @db.VarChar(100)
  slugEn    String   @map("slug_en") @db.VarChar(100)
  continent String?  @db.VarChar(20)
  flagEmoji String?  @map("flag_emoji") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nameFr])
  @@index([nameEn])
  @@index([slugFr])
  @@index([slugEn])
  @@map("countries")
}

model ImageAsset {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  // File data
  filePath      String  @map("file_path") @db.VarChar(500)
  thumbnailPath String? @map("thumbnail_path") @db.VarChar(500)
  avifPath      String? @map("avif_path") @db.VarChar(500)
  lqipDataUri   String? @map("lqip_data_uri") @db.Text
  fileFormat    String  @default("webp") @map("file_format") @db.VarChar(10)
  fileSize      Int     @default(0) @map("file_size")
  width         Int
  height        Int
  orientation   String  @db.VarChar(20)
  aspectRatio   String? @map("aspect_ratio") @db.VarChar(10)
  srcset        String? @db.Text
  fileHash      String? @map("file_hash") @db.VarChar(64)

  // SEO core
  // Slug strategy (audit V1 verification 2026-05-16 P1-10) :
  //   - ImageAsset.slug    = identifiant CANONIQUE language-neutral (unique global),
  //                          dérivé du title FR à la création (slugifyAscii), sert
  //                          aux chemins fichier storage `image-bank/<id>/...`.
  //   - ImageAssetTranslation.slug = slug PER-LANG (unique via [imageId, languageCode]),
  //                                  sert au routing public `/galerie/<slug-fr>` ou
  //                                  `/gallery/<slug-en>`. Calculé par le worker
  //                                  translate (Claude Sonnet 4.6 vision) avec retour
  //                                  à slugifyAscii(title traduit) si null.
  slug              String  @unique @db.VarChar(255)
  keywordsPrimary   String? @map("keywords_primary") @db.VarChar(255)
  keywordsSecondary Json?   @map("keywords_secondary")
  seoScore          Int     @default(0) @map("seo_score") @db.SmallInt

  // Geo targeting (monde ISO, PAS regions.ts France)
  targetCountries Json?   @map("target_countries")
  targetLanguages Json?   @map("target_languages")
  geoRegion       String? @map("geo_region") @db.VarChar(10)
  geoPlacename    String? @map("geo_placename") @db.VarChar(255)
  geoPosition     String? @map("geo_position") @db.VarChar(50)

  // License (CC BY 4.0 par défaut)
  licenseType      String  @default("cc-by-4.0") @map("license_type") @db.VarChar(50)
  licenseUrl       String? @default("https://creativecommons.org/licenses/by/4.0/") @map("license_url") @db.VarChar(500)
  copyrightHolder  String  @default("Axion-IA") @map("copyright_holder") @db.VarChar(255)
  photographerName String? @map("photographer_name") @db.VarChar(255)
  photographerUrl  String? @map("photographer_url") @db.VarChar(500)

  // Source (origin tracking)
  sourceUrl  String? @map("source_url") @db.Text
  sourceType String  @default("photo") @map("source_type") @db.VarChar(20)
  aiModel    String? @map("ai_model") @db.VarChar(60)

  // Tracking
  viewCount     Int @default(0) @map("view_count")
  downloadCount Int @default(0) @map("download_count")
  embedCount    Int @default(0) @map("embed_count")

  // State
  isActive    Boolean   @default(true) @map("is_active")
  isFeatured  Boolean   @default(false) @map("is_featured")
  sortOrder   Int       @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at")

  // V1.1 — Taxonomie métier (SSOT @/server/image-bank/taxonomy.ts)
  module         String? @map("module") @db.VarChar(20)
  subModule      String? @map("sub_module") @db.VarChar(60)
  targetEntity   String? @map("target_entity") @db.VarChar(120)
  targetCity     String? @map("target_city") @db.VarChar(80)
  targetRegion   String? @map("target_region") @db.VarChar(60)
  targetSize     String? @map("target_size") @db.VarChar(20)
  targetPersona  String? @map("target_persona") @db.VarChar(40)
  targetSector   String? @map("target_sector") @db.VarChar(40)
  targetTechno   String? @map("target_techno") @db.VarChar(30)
  targetFormat   String? @map("target_format") @db.VarChar(20)
  targetDuration String? @map("target_duration") @db.VarChar(30)

  // V1.1 — Cross-référence page métier canonique
  subjectOfUrl  String? @map("subject_of_url") @db.VarChar(500)
  subjectOfType String? @map("subject_of_type") @db.VarChar(30)

  // V1.1 — Flags qualité + AI + watermark
  isAiGenerated         Boolean @default(false) @map("is_ai_generated")
  requiresHumanReview   Boolean @default(false) @map("requires_human_review")
  requiresHumanTaxonomy Boolean @default(false) @map("requires_human_taxonomy")
  watermarkEnabled      Boolean @default(false) @map("watermark_enabled")

  // V1.5 — pHash + custom XMP namespace
  pHash         String? @map("p_hash") @db.VarChar(32)
  customXmpData Json?   @map("custom_xmp_data")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     ImageCategory?          @relation(fields: [categoryId], references: [id])
  translations ImageAssetTranslation[]
  tags         ImageAssetTag[]
  usageLogs    ImageUsageLog[]
  downloadLogs ImageDownloadLog[]

  @@index([isActive, categoryId, sortOrder])
  @@index([isActive, publishedAt])
  @@index([sourceType])
  @@index([fileHash])
  @@index([module, subModule])
  @@index([module, targetCity])
  @@index([module, targetRegion])
  @@index([subjectOfType])
  @@index([requiresHumanReview])
  @@index([requiresHumanTaxonomy])
  @@index([pHash])
  @@map("image_assets")
}

model ImageAssetTranslation {
  id           Int    @id @default(autoincrement())
  imageId      String @map("image_id") @db.Uuid
  languageCode String @map("language_code") @db.VarChar(5)

  title       String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  alt         String  @db.VarChar(255)
  caption     String? @db.VarChar(500)
  description String? @db.Text

  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(255)
  ogTitle         String? @map("og_title") @db.VarChar(255)
  ogDescription   String? @map("og_description") @db.VarChar(255)

  aiSummary    String? @map("ai_summary") @db.Text
  embedTitle   String? @map("embed_title") @db.VarChar(255)
  // OCR du texte présent DANS l'image (détecté par Claude Vision à l'enrichment).
  // Audit images 2026-06-20 : l'enrichment écrivait déjà `embeddedText` mais la
  // colonne n'existait pas → crash Prisma « Unknown argument » dès qu'une image
  // contenait du texte → enrichment KO → image thin → noindex. Cette colonne
  // répare ce bug latent ET alimente la propriété schema.org `text` de
  // l'ImageObject (citabilité IA / Google Vision — AEO).
  embeddedText String? @map("embedded_text") @db.Text


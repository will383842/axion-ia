  error       String?             @db.Text
  /// AdminUser.id de l'auteur (audit, sans FK pour rester additif).
  startedById String?             @map("started_by_id") @db.Uuid
  startedAt   DateTime?           @map("started_at")
  finishedAt  DateTime?           @map("finished_at")

/// Sprint X.1 — state machine V1 deposit-validation-gated.
/// Sources : `_AUDIT/BOOKING-DEPOSIT-ADMIN-2026-05-12/agent-03-state-machine.md`
/// + `03-ARCHITECTURE-CIBLE.md §5.1.2` + ADR 0018.
/// 4 valeurs V0 (pending/confirmed/cancelled/postponed) -> ~27 valeurs V1.
/// Les valeurs V0 sont conservées (compat existant) ; migration data via script
/// V0->V1 Sprint X.4 (cf. ADR 0020).
enum BookingStatus {
  // ---------- V0 legacy (compat existant, mappées par migration) ----------
  pending
  postponed
  // ---------- V1 — parcours visiteur (avant validation Will) ------------
  /// État UI uniquement (visiteur en train de remplir). Présent dans l'enum
  /// pour cohérence types TS ; jamais persisté DB.
  draft
  /// Demande d'option posée par visiteur, en attente validation Will.
  /// Cap multi-options simultanées (cf. ADR 0017) — défaut 3.
  option_pending
  /// Une AUTRE option du même slot a été validée par Will -> celle-ci perd.
  lost_other_won
  /// Refusée par Will (raison optionnelle).
  refused
  /// Option expirée (durée écoulée sans validation Will). Rare car cap haute.
  expired_no_response
  // ---------- V1 — cadrage ---------------------------------------------
  /// Call de cadrage planifié (lien visio manuel envoyé).
  cadrage_scheduled
  /// Call tenu (validationDecision saisie).
  cadrage_held
  /// validationDecision=not_pertinent (terminal, refund éventuel).
  cadrage_declined
  // ---------- V1 — devis (Will-A semi-auto) ----------------------------
  /// Marqueur : devis semi-auto à émettre avant contrat (admin).
  quote_required
  /// Devis DocuSeal envoyé (signature en attente).
  quote_sent
  /// Devis signé.
  quote_signed
  /// Devis refusé / expiré.
  quote_declined
  // ---------- V1 — contrat + acompte (D49 + D50 + D51) -----------------
  /// Contrat généré auto, prêt en preview admin (D55).
  contract_pending
  /// Contrat DocuSeal envoyé + Stripe Checkout Session active
  /// (fusion ex-`contract_sent` + `deposit_pending`).
  contract_payment_sent
  /// Contrat signé DocuSeal — PAS bloquant pour la suite (D50).
  contract_signed
  /// D51 — acompte reçu (Stripe webhook OU virement manuel admin) ;
  /// en attente du clic Will « Valider sur le calendrier » (D49).
  awaiting_admin_validation
  // ---------- V1 — confirmé + cycle de vie -----------------------------
  /// Après clic Will « Valider sur le calendrier » (D49) — slot rouge,
  /// intervention verrouillée.
  confirmed
  /// D61 — projet reporté à date ultérieure, slots libérés pendant la pause.
  paused
  /// Cron J-7 : rappel + facture solde émise si échéancier prévoit.
  reminded_j7
  /// Jour J (cron 00:00 TZ Europe/Paris).
  in_progress
  /// Post-intervention (cron OR admin manuel).
  completed
  /// Facture solde émise (si pas déjà émise en reminded_j7).
  invoiced_balance
  /// D59 — 1+ échéance(s) > 30j retard, escalade en cours
  /// (cron `installment-overdue-escalation`).
  installment_overdue
  /// Solde réglé (terminal succès).
  paid_balance
  /// D59 — état terminal recouvrement hors-app par Will après escalade
  /// J+45 sans paiement.
  disputed
  /// Cron retention >= 12 mois.
  archived
  // ---------- V1 — terminaux annulation/refund -------------------------
  /// Annulation self-service magic-link (cancelled remplacé par
  /// cancelled_by_user pour clarté).
  cancelled
  cancelled_by_user
  cancelled_by_admin
  /// J+1 admin, acompte conservé + invoice solde.
  no_show
  /// Refund total + reschedule prioritaire.
  force_majeure
  /// CGV 7-2j (50%).
  refunded_partial
  /// CGV >7j (100%) ou force majeure ou cadrage_declined.
  refunded_full
}

enum CalendarSlotStatus {
  /// Sprint X.1 (Will-B Option B2 / ADR 0017) — pas d'extension enum V1.

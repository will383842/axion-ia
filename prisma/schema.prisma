// ============================================================
// 25. contract_documents — Sprint X.1 §5.1.10
// ============================================================

/// Sprint X.1 — contrats DocuSeal self-hosted (ADR 0014).
/// Versioning D62 : `previousVersionId` self-FK + `isAddendum` (avenant).
model ContractDocument {
  id                String             @id @default(uuid()) @db.Uuid
  bookingId         String             @map("booking_id") @db.Uuid
  booking           Booking            @relation("BookingContractDocuments", fields: [bookingId], references: [id], onDelete: Restrict)
  // Lien inverse vers Booking.contractDocumentId (relation distincte).
  activeForBookings Booking[]          @relation("BookingActiveContract")
  provider          SignatureProvider
  /// DocuSeal submission_id (NULL pour manual_upload / physical_signed).
  providerId        String?            @map("provider_id") @db.VarChar(120)
  templateId        String?            @map("template_id") @db.Uuid
  template          ContractTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Snapshot Tiptap JSON au moment de l'envoi (immuable légal).
  body              Json
  /// Valeurs des {{variables}} interpolées (snapshot).
  variables         Json?
  status            ContractStatus     @default(draft)
  sentAt            DateTime?          @map("sent_at")
  signedAt          DateTime?          @map("signed_at")
  declinedAt        DateTime?          @map("declined_at")
  /// Hetzner Storage Box signed URL.
  pdfUrl            String?            @map("pdf_url") @db.Text
  hashSha256        String?            @map("hash_sha256") @db.VarChar(64)
  signerEmail       String?            @map("signer_email") @db.Citext
  signerName        String?            @map("signer_name") @db.VarChar(200)
  /// IP eIDAS-SES (audit trail).
  ipSigner          String?            @map("ip_signer") @db.VarChar(45)
  version           Int                @default(1)
  /// D62 — versioning v1 -> v2 (cancel_admin) ou avenant.
  previousVersionId String?            @map("previous_version_id") @db.Uuid
  previousVersion   ContractDocument?  @relation("ContractDocumentVersion", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      ContractDocument[] @relation("ContractDocumentVersion")
  /// D62 — true si avenant post-signature (contrat principal reste immuable).
  isAddendum        Boolean            @default(false) @map("is_addendum")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  quotes Quote[]

  @@index([bookingId, status])
  @@index([providerId])
  @@index([previousVersionId])
  @@map("contract_documents")
}

// ============================================================
// 26. contract_templates — Sprint X.1 §5.1.11
// ============================================================

/// Sprint X.1 — templates contrat Tiptap éditables admin.
/// V1 : 1 template par défaut FR + 1 EN. `defaultLegalClauses` (D53) inclut
/// la clause résolution pour défaut de paiement (J+10).
model ContractTemplate {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @unique @db.VarChar(120)
  slug                String    @unique @db.VarChar(80)
  /// Tiptap JSON master avec {{variables}}.
  body                Json
  /// Schéma variables disponibles : [{key, label, required, type}].
  variables           Json
  /// D53 — clauses légales par défaut fusionnées dans chaque contrat généré.
  defaultLegalClauses Json      @map("default_legal_clauses")
  isDefault           Boolean   @default(false) @map("is_default")
  version             Int       @default(1)
  locale              Locale    @default(fr)
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  contractDocuments ContractDocument[]

  @@index([slug])
  @@index([isDefault, archivedAt])
  @@map("contract_templates")
}

// ============================================================
// 27. quotes — Sprint X.1 §5.1.12
// ============================================================

/// Sprint X.1 — devis semi-auto (Will-A §5.11.1).
/// Pré-rempli depuis PricingConfig + Booking, édité Tiptap, envoyé DocuSeal.
model Quote {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Format `DEVIS-2026-NNNN` séquentiel.
  number               String            @unique @db.VarChar(40)
  bookingId            String            @map("booking_id") @db.Uuid
  booking              Booking           @relation("BookingQuotes", fields: [bookingId], references: [id], onDelete: Restrict)
  // Lien inverse vers Booking.quoteId actif (relation distincte).
  activeForBookings    Booking[]         @relation("BookingActiveQuote")
  body                 Json
  amountHtCents        Int               @map("amount_ht_cents")
  vatRate              Decimal           @map("vat_rate") @db.Decimal(5, 2)
  vatReverseCharge     Boolean           @default(false) @map("vat_reverse_charge")
  vatMention           String?           @map("vat_mention") @db.Text
  amountTtcCents       Int               @map("amount_ttc_cents")
  /// = sentAt + 30j (défaut).
  validUntil           DateTime          @map("valid_until")
  pdfUrl               String?           @map("pdf_url") @db.Text
  hashSha256           String?           @map("hash_sha256") @db.VarChar(64)
  status               QuoteStatus       @default(draft)
  sentAt               DateTime?         @map("sent_at")
  acceptedAt           DateTime?         @map("accepted_at")
  declinedAt           DateTime?         @map("declined_at")
  contractDocumentId   String?           @map("contract_document_id") @db.Uuid
  contractDocument     ContractDocument? @relation(fields: [contractDocumentId], references: [id], onDelete: SetNull)
  /// DocuSeal submission pour signature devis.
  docusealSubmissionId String?           @map("docuseal_submission_id") @db.VarChar(120)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([bookingId, status])
  @@index([number])
  @@map("quotes")
}


// ============================================================
// SITE EXPLORER — Catalogue exhaustif des URLs publiques
// Sprint Site Explorer Admin 2026-05-22.
// RÈGLE STRICTE : ce catalogue ne contient QUE des URLs publiques
// visibles par les visiteurs réels du site. Toute route (admin),
// [adminPrefix], /api/, Server Actions est exclue par construction.
// ============================================================

enum SiteRouteType {
  static
  dynamic_template
  dynamic_db
  dynamic_filesystem
}

enum SiteRouteStatus {
  live
  draft
  preview
  not_found
  redirect
  error
  unknown
}

/// Visibilité — UNIQUEMENT 'public' par design.
/// Les valeurs 'admin' et 'api_only' sont intentionnellement omises :
/// le Site Explorer ne catalogue PAS les pages admin ni API.
enum SiteRouteVisibility {
  public
}

/// Feu tricolore de revue éditoriale manuelle (décision Will 2026-06-08).
/// Renseigné à la main dans l'onglet « Toutes les URLs » :
///   unset  = pas encore revue
///   green  = page parfaite, rien à faire
///   orange = nécessite une retouche
///   red    = cassée / problème bloquant
enum SiteRouteQuality {
  unset
  green
  orange
  red
}

model SiteRoute {
  id           String  @id @default(cuid())
  pathPattern  String  @map("path_pattern") @db.VarChar(1000)
  pathRendered String? @map("path_rendered") @db.VarChar(1000)
  pathSlug     String? @map("path_slug") @db.VarChar(500)

  type       SiteRouteType
  status     SiteRouteStatus     @default(unknown)
  visibility SiteRouteVisibility @default(public)

  source   String  @db.VarChar(200)
  filePath String? @map("file_path") @db.VarChar(500)

  parentRouteId String?     @map("parent_route_id")
  parentRoute   SiteRoute?  @relation("RouteHierarchy", fields: [parentRouteId], references: [id])
  childRoutes   SiteRoute[] @relation("RouteHierarchy")
  depth         Int         @default(0)

  section    String?  @db.VarChar(100)
  verticales String[] @default([])
  cityIds    String[] @default([]) @map("city_ids")

  httpStatus        Int?      @map("http_status")
  metaTitle         String?   @map("meta_title") @db.VarChar(500)
  metaDescription   String?   @map("meta_description") @db.Text
  h1                String?   @db.VarChar(500)
  wordCount         Int?      @map("word_count")
  jsonLdCount       Int?      @map("json_ld_count")
  internalLinkCount Int?      @map("internal_link_count")
  externalLinkCount Int?      @map("external_link_count")
  hasAiDisclaimer   Boolean?  @map("has_ai_disclaimer")
  lastModifiedAt    DateTime? @map("last_modified_at")
  lastInspectedAt   DateTime? @map("last_inspected_at")

  lighthousePerf  Int?      @map("lighthouse_perf")
  lighthouseSeo   Int?      @map("lighthouse_seo")
  lighthouseA11y  Int?      @map("lighthouse_a11y")
  lighthouseBP    Int?      @map("lighthouse_bp")
  lighthouseRunAt DateTime? @map("lighthouse_run_at")

  editable      Boolean @default(false)
  editorRoute   String? @map("editor_route") @db.VarChar(500)
  sourceDbTable String? @map("source_db_table") @db.VarChar(100)
  sourceDbId    String? @map("source_db_id") @db.VarChar(100)

  // ─── Indexabilité LIVE (source de vérité = src/server/site-explorer/indexability.ts) ───
  // Calculée depuis la logique réelle (drip villes `isVilleIndexable`, tier des
  // articles, `isNoindexStubRoute`), PAS par scraping HTML. Recalculée chaque
  // jour par le worker de découverte → bascule noindex→indexable automatique.
  isIndexable   Boolean? @map("is_indexable")
  noindexReason String?  @map("noindex_reason") @db.VarChar(200)

  // Catégorie canonique de regroupement UI (cf. src/server/site-explorer/categories.ts).
  category String? @db.VarChar(60)

  // ─── Revue manuelle (feu tricolore + notes) — onglet « Toutes les URLs » ───
  qualityStatus SiteRouteQuality @default(unset) @map("quality_status")
  adminNotes    String?          @map("admin_notes") @db.Text
  reviewedAt    DateTime?        @map("reviewed_at")
  reviewedBy    String?          @map("reviewed_by") @db.VarChar(100)

  // ─── Google Search Console ───
  // Demande d'indexation manuelle (la case que Will coche) + trafic réel (worker GSC).
  gscIndexationRequested   Boolean   @default(false) @map("gsc_indexation_requested")
  gscIndexationRequestedAt DateTime? @map("gsc_indexation_requested_at")
  gscClicks                Int?      @map("gsc_clicks")
  gscImpressions           Int?      @map("gsc_impressions")
  gscCtr                   Float?    @map("gsc_ctr")
  gscPosition              Float?    @map("gsc_position")
  gscDataAt                DateTime? @map("gsc_data_at")

  // ─── Cycle de vie « vivant » (découverte automatique) ───
  // lastSeenAt = dernier passage de l'énumérateur ; removedAt = soft-tombstone
  // quand une URL disparaît de la découverte (jamais de hard-delete).
  lastSeenAt DateTime? @map("last_seen_at")
  removedAt  DateTime? @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  anomalies SiteRouteAnomaly[]

  @@unique([pathPattern, pathSlug])
  @@index([type])
  @@index([status])
  @@index([section])
  @@index([visibility])
  @@index([depth])
  @@index([editable])
  @@index([qualityStatus])
  @@index([isIndexable])
  @@index([gscIndexationRequested])
  @@index([category])
  @@index([removedAt])
  @@map("site_routes")
}

model SiteRouteAnomaly {
  id          String    @id @default(cuid())
  siteRouteId String    @map("site_route_id")
  siteRoute   SiteRoute @relation(fields: [siteRouteId], references: [id], onDelete: Cascade)
  type        String    @db.VarChar(100)
  severity    String    @db.VarChar(20)
  description String    @db.Text
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([siteRouteId])
  @@index([type])
  @@index([severity])
  @@index([resolvedAt])
  @@map("site_route_anomalies")
}

/// Hub ville auto-généré (Sprint VilleCopy generator 2026-05-24).
///
/// Doctrine :
///   - Source #1 = fichier statique `src/content/villes/copy/[slug].ts` (manuel curatié, ~40 villes pilotes).
///   - Source #2 (fallback) = cette table, si `status=approved` ET ville sans fichier statique.
///   - Source #3 (rien) = stub `noindex follow` (anti-doorway HCU 2024).
///
/// Le `getVille()` async résout dans cet ordre. La page hub utilise un seul
/// chemin de rendu (le template 13 sections) — cette table évite juste
/// d'avoir 500+ fichiers .ts manuels à écrire.
///
/// Champs FR uniquement (EN locale désactivé cf AGENTS.md).
model GeneratedVilleCopy {
  id        String @id @default(cuid())
  villeSlug String @unique @map("ville_slug") @db.VarChar(100)

  /// Pitch FR 30-50 mots citable LLMs (hero).
  pitchFr        String   @map("pitch_fr") @db.VarChar(600)
  /// Direct-answer FR 40-80 mots autonome (data-speakable-hero + AI Overviews).
  directAnswerFr String   @map("direct_answer_fr") @db.VarChar(900)
  /// Écosystème économique local 30-60 mots (anti-doorway HCU).
  ecosystemFr    String   @map("ecosystem_fr") @db.VarChar(800)
  /// Distances clés 1-2 phrases (~25 mots) — gares, aéroports, métro.
  distancesFr    String   @map("distances_fr") @db.VarChar(400)
  /// Top secteurs NAF B2B locaux (array de strings, max 8).
  topSectorsNaf  String[] @default([]) @map("top_sectors_naf")

  /// `servicesContext` (4 services × 25-50 mots fr) sérialisé.
  /// Shape : { audit, interventions, implementation, unAUn } chacun { fr: string }.
  servicesContextJson Json  @map("services_context_json")
  /// `faqGeolocalisee` (4-6 Q/R) sérialisé. Shape : [{ q, a }, ...].
  faqGeolocaliseeJson Json  @map("faq_geolocalisee_json")
  /// `heroSchema` (centerSubLabel + 6 satellites) sérialisé. Shape : { centerSubLabel?, satellites: [...] }.
  heroSchemaJson      Json? @map("hero_schema_json")

  /// Quality gate — score 0-100, gate auto-approve si >= autoApproveThreshold.
  qualityScore          Int      @map("quality_score")
  /// Plagiarism check Jaccard score (0.0-1.0). >0.3 = rejet.
  plagiarismScore       Decimal? @map("plagiarism_score") @db.Decimal(5, 3)
  /// Anti-duplicate: max Jaccard vs les 5 verticales Article de la ville.
  duplicateVsVerticales Decimal? @map("duplicate_vs_verticales") @db.Decimal(5, 3)

  /// LLM cost tracking + AI Act art. 50 audit trail.
  modelUsed    String  @map("model_used") @db.VarChar(80)
  totalCostUsd Decimal @map("total_cost_usd") @db.Decimal(10, 6)
  promptHash   String  @map("prompt_hash") @db.VarChar(64)
  tokensInput  Int     @map("tokens_input")
  tokensOutput Int     @map("tokens_output")

  /// Provenance — quels champs KB ont alimenté le prompt.
  kbContextUsed Json? @map("kb_context_used")

  status      GeneratedVilleCopyStatus @default(generated)
  reviewedBy  String?                  @map("reviewed_by") @db.VarChar(120)
  reviewedAt  DateTime?                @map("reviewed_at")
  reviewNotes String?                  @map("review_notes") @db.Text

  generatedAt DateTime @default(now()) @map("generated_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([qualityScore])
  @@index([villeSlug, status])
  @@map("generated_ville_copies")
}

enum GeneratedVilleCopyStatus {
  /// LLM output frais, pas encore validé — page reste noindex.
  generated
  /// Validée manuellement OU auto-approve si qualityScore >= seuil — page indexable.
  approved
  /// Rejetée — qualité insuffisante, ne sera pas utilisée. Re-gen possible.
  rejected
  /// Mise en quarantaine (ex : claim douteux, conflict avec fichier statique).
  quarantined
}


# Dockerfile worker BullMQ — Sprint 22 (M11 deploiement).
#
# Service separe du web app pour isoler le throughput email/cron du request
# handling Next. Lance via `pnpm worker` → consume queues Redis :
#   - emails (10 templates React Email × FR/EN)
#   - option-expiration (cron 5min)
#   - option-reminder (cron 1h, fenetre [22h, 26h])
#
# Aligne avec axionia_audit_sequence.md Sprint 18 + ADR 0009 :
#   - Coolify deploie 2 services Web + Worker (meme image partagee possible
#     mais on garde 2 Dockerfiles distincts pour resource limits independants)
#   - Worker n'a pas besoin de exposer un port → pas d'EXPOSE
#   - Healthcheck via `pgrep node` + ping Redis (ENTRYPOINT script)

# -----------------------------------------------------------------------------
# Stage 1 : deps
# -----------------------------------------------------------------------------
# Node 22+ requis pour `--experimental-strip-types` (CMD finale du runner stage).
# Stripped TS execution arrivée en stable Node 22.6.
FROM node:22-alpine AS deps
# `openssl` requis runtime par le binary Prisma `linux-musl-openssl-3.0.x`
# (cf. prisma/schema.prisma binaryTargets). Sans lui : worker crash loop
# « libquery_engine-linux-musl.so.node refuse de charger » (audit 2026-05-15).
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .npmrc* ./

ENV COREPACK_INTEGRITY_KEYS=0
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
RUN pnpm install --frozen-lockfile --prefer-offline

# -----------------------------------------------------------------------------
# Stage 2 : builder — generate Prisma client + transpile TS
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV COREPACK_INTEGRITY_KEYS=0
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
RUN pnpm prisma:generate

# -----------------------------------------------------------------------------
# Stage 3 : runner — slim worker runtime
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner
# Runner stage (CRITIQUE) : sans `openssl`, Prisma client crash au premier
# import dans n'importe quel worker BullMQ (audit 2026-05-15 AGENT 9).
RUN apk add --no-cache libc6-compat openssl tini
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# User non-root
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker

# Copy node_modules + src + prisma generated client + tsx (worker run via tsx)
COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/src ./src
COPY --from=builder --chown=worker:nodejs /app/prisma ./prisma
COPY --from=builder --chown=worker:nodejs /app/package.json ./
COPY --from=builder --chown=worker:nodejs /app/tsconfig.json ./

# 🔴 POLICES DE MARQUE — le worker GÉNÈRE DES PDF, il lui faut les .ttf.
#
# Constaté en production le 04/08/2026. `registerQualiopiPdfFonts()` résout les
# polices depuis `process.cwd()/public/fonts` ; ce répertoire n'était copié
# NULLE PART dans l'image du worker. La fonction ne throw jamais — elle
# retombe en silence sur Geist. Résultat sur un livret régénéré depuis le
# worker : typographie hors charte, et surtout des caractères PERDUS au rendu
# (« Rédiger » imprimé « diger », « Appliquer » imprimé « pliquer »).
#
# Ce n'est pas théorique : le cron `qualiopi-formation-crons-worker` appelle
# `genererAttestationPourEnrollment`. Toute attestation émise automatiquement
# sortait donc dégradée — sur une pièce remise au stagiaire et opposable.
#
# ⚠️ `public/fonts` et non `public` entier : le worker ne sert aucun asset HTTP,
# et copier tout `public` alourdirait l'image de tous les visuels du site.
COPY --from=builder --chown=worker:nodejs /app/public/fonts ./public/fonts

USER worker

# Tini = init process pour graceful SIGTERM (Coolify SIGKILL @ 30s,
# cf. Sprint 15 step 4 worker.ts shutdown handler 25s timeout)
ENTRYPOINT ["/sbin/tini", "--"]

# Pas d'EXPOSE (worker ne sert pas HTTP)
#
# Méta-cert 2026-05-15 AGENT 14 P1 — HEALTHCHECK Docker.
# Le worker ne sert pas HTTP donc on check via `pgrep` que le process tsx
# principal est encore vivant. Si SIGKILLED (OOM, crash silencieux, fuite
# mémoire BullMQ → 30 s hang) → Docker marque container `unhealthy` et
# Coolify peut auto-restart.
#
#  - interval=30s : pas trop agressif (chaque check spawn pgrep)
#  - timeout=10s : pgrep est rapide mais on garde marge
#  - start-period=60s : laisser le worker boot (Prisma generate + Redis connect)
#  - retries=3 : 3 fails consécutifs = unhealthy
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD pgrep -f "tsx src/server/queue/worker" >/dev/null || exit 1
#
# Fix 2026-05-13 : `node --experimental-strip-types` exige des extensions
# .ts/.js explicites dans tous les imports relatifs (ESM strict). Le code
# utilise `import ./workers/email-worker` sans extension (style TS classique).
# Solution : utiliser tsx (déjà dans node_modules) qui résout les imports
# TypeScript naturellement comme tsc/vitest/Next.
CMD ["node_modules/.bin/tsx", "src/server/queue/worker.ts"]
